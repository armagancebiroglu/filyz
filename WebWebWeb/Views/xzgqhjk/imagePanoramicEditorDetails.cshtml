
@{
    ViewBag.Title = "imagePanoramicEditorDetails";
    Layout = "~/Views/Shared/_LayoutEditor.cshtml";
}

@model WebWebWeb.Models.ShareObject
<style>
    canvas {
        z-index: -1;
    }

    #ShareObjectPanaromaText {
        position: relative;
        display: inline-block;
        z-index: 1040;
    }

    input[type=submit] {
        display: none;
    }
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r70/three.min.js"></script>
<div class="ShareMaterialheaderContent" id="ShareMaterialheaderContent">
    @using (Html.BeginForm("imagePanoramicEditorDetails", "xzgqhjk", new { obje_id = Model.id }, FormMethod.Post, new { enctype = "multipart/form-data" }))
    {//image180
        @Html.AntiForgeryToken()
        try
        {
       
        <div class="ShareStreemObjectWrapper">
            <p>
                <strong>Kimler İçin Paylaşılacak?:</strong>
                <strong>
                    @Html.DropDownListFor(mbox => mbox.sex, new[] {
new SelectListItem {Text="Seçiniz...", Value="" },
new SelectListItem { Text = "Yalnızca Kadınlar İçin Paylaşım", Value = "Erkek" },
new SelectListItem { Text = "Yalnızca Erkekler İçin Paylaşım", Value = "Kadın" },
new SelectListItem { Text = "Herkes İçin Paylaşım", Value = "XYX" } },
                                           new { @id = "sex", @class = "form-control" })
                </strong>
            </p>
            <p>
                <strong>Paylaşımın Statüsü Nedir?:</strong>
                <strong>
                    @Html.DropDownListFor(mbox => mbox.confrim, new[] {
new SelectListItem {Text="Seçiniz...", Value="" },
new SelectListItem { Text = "Paylaşım", Value = "1" },
new SelectListItem { Text = "Reklam", Value = "2" },
new SelectListItem { Text = "Duyuru ve Etkinlik", Value = "4" },
new SelectListItem { Text = "Öğretici Bilgi", Value = "8" }
}, new { @id = "confrim", @class = "form-control" })
                </strong>
            </p>
            <p>
                <label for="shareUpdate" class="glyphicon glyphicon-check EditorListEditIcoUpdate"></label>
                <input id="shareUpdate" class="custom-file-upload" name="EditorEvent" value="Update" type="submit" />
                <label for="shareDelete" class="glyphicon glyphicon-trash EditorListEditIco"></label>
                <input id="shareDelete" class="custom-file-upload" name="EditorEvent" value="Delete" type="submit" />
            </p>
            <div class="shareLocationItemHeader">
                <div class="ShareLocationIco">
                    <label for="ShareObjectPanaromaFileUpload"><i class="glyphicon glyphicon-picture"></i></label><div>180° Fotoğraf Seç</div>
                    <input id="ShareObjectPanaromaFileUpload" class="custom-file-upload" name="file" type="file" accept="image/*" capture="camera" />
                </div>
            </div>
            <!--içerik başlangıç-->
            <div class="shareStreemContent">
                <!--içerik başlangıç-->
                <div class="ShareObjectWrapper">
                    <div class="ShareObjectFrame" id="ShareObjectFrame">
                        <img id="ShareObjectPanaromaPreview" src="@Model.image_url" style="width:auto; height:auto; display:none;" />                       
                    </div>
                </div>
                <!--içerik bitiş-->
            </div>
            <!--içerik bitiş-->
            <div class="shareStreemFooterElementWrapper">
                <div class="ShareObjectTextWrp">
                    <div class="ShareObjectText">
                        @Html.TextAreaFor(mbox => mbox.text, new { @id = "ShareObjectPanaromaText", @class = "ShareTextInput", style = "height:100px", rows = "10", Placeholder = "...yazın" })
                    </div>
                    @Html.HiddenFor(mbox => mbox.image_url)
                    @Html.HiddenFor(mbox => mbox.id)
                    @Html.HiddenFor(mbox => mbox.member_id)
                </div>
            </div>
        </div>
        }
        catch
        {
            if (!Response.IsRequestBeingRedirected)
            { Response.Redirect(Url.Action("Index", "xzgqhjk")); }
        }
    }
</div>
<script src=" ~/Scripts/180Viewer.js"></script>
<script type="text/javascript">
    $(Document).ready(function () {
        $('#ShareObjectPanaromaFileUpload').change(function (event) {

            $('#ShareObjectFrame').contents().remove();
            $('#ShareObjectFrame').html('<img id="ShareObjectPanaromaPreview" src="#" style="display:none; width:auto; height:auto;" />');
            $(File).each(function (e) {
                if (e != this) {
                    $(this).val('');
                }
            });
            var Uri = URL.createObjectURL(event.target.files[0]);
            $("#ShareObjectPanaromaPreview").attr('src', Uri);
            var W_H = 0;
            var img = document.getElementById("ShareObjectPanaromaPreview");
            img.onload = function (e) {
                W_H = img.naturalWidth / img.naturalHeight;
                if (W_H >= 4) {
                    W_H = 6.3;
                }
                var container_id = 'ShareObjectFrame';
                var modalAlb = 'content';
                screen180View(W_H, container_id, modalAlb, Uri);
            }

        });

        var URL_ = $('#ShareObjectFrame').children("img").attr("src");      
        var WH;
        var img_ = new Image();
        img_.src = URL_;
        WH = img_.naturalWidth / img_.naturalHeight;
        if (WH >= 6.3) { WH = 6.3; }

        var container = 'ShareObjectFrame';
        var modalAlb_ = 'content';

        screen180View(WH, container, modalAlb_, URL_);
    });
</script>
<div class="ShareObjectDetailsFooterEmpty">&nbsp;</div>

