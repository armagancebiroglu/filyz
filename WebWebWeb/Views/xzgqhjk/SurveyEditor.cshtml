
@{
    ViewBag.Title = "SurveyEditor";
    Layout = "~/Views/Shared/_LayoutEditor.cshtml";
}
@model List<WebWebWeb.Models.shareStreem>
@using (Html.BeginForm("SurveyEditor", "xzgqhjk", new { surveyEvent = "SurveyInsert" }))
{
    @Html.AntiForgeryToken()
    try
    {   
    <div class="surveyWrp">
        <p>
            <strong>Kimler İçin Paylaşılacak?:</strong>
            <strong>
                @Html.DropDownList("sex", new[] {
new SelectListItem {Text="Seçiniz...", Value="" },
new SelectListItem { Text = "Yalnızca Kadınlar İçin Anket", Value = "Erkek" },
new SelectListItem { Text = "Yalnızca Erkekler İçin Anket", Value = "Kadın" },
new SelectListItem { Text = "Herkes İçin Anket", Value = "XYX" } },
                                      new { @id = "sex", @class = "form-control" })
            </strong>
        </p>
        <p>
            <strong>Paylaşımın Statüsü Nedir?:</strong>
            <strong>
                @Html.DropDownList("confrim", new[] {
new SelectListItem {Text="Seçiniz...", Value="" },
new SelectListItem { Text = "Katılım Zorunlu Anket", Value = "16" },
new SelectListItem { Text = "Katılım İsteğe Bağlı Anket", Value = "32" }
}, new { @id = "confrim", @class = "form-control" })
            </strong>
        </p>
    </div>
    <div class="surveyWrp">
        <div class="surveyDate">
            <span>@DateTime.Now.Day</span>
            <span>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(DateTime.Now.Month)</span>
            <span>@DateTime.Now.Year</span>
        </div>
        <div class="surveyTextInput">
            @Html.TextArea("SurveyText", new { @id = "SurveyText", @class = "SurvayTextInput", rows = "3", Placeholder = " ..anket konusunu yazın (*1500 karakter)" })
        </div>
        <div class="surveySubmit">
            <label for="SurvayBtn"><i class="fa fa-plus"></i></label>
            <input id="SurvayBtn" type="submit" value="Kaydet" class="ButtonHiden" />
        </div>
    </div>
    }
    catch
    {
        if (!Response.IsRequestBeingRedirected)
        { Response.Redirect(Url.Action("Index", "xzgqhjk")); }
    }
    <div class="SurvyeListWrp">
        @try
        {
            if (Model != null)
            {
                <ol>

                    @foreach (var item in Model)
                    {
                        <li>
                            @if (item.active == 1)
                            {
                                <div class="SurveyItemFrame">
                                    <div class="SurveyItemFrameCaption">
                                        <span class="fa fa-quote-left"></span>
                                        <a href="@Url.Action("EditorSurveyDetails", "xzgqhjk", new { obje_id = item.id })">
                                            @item.text
                                        </a>
                                        <span class="fa fa-quote-right"></span>
                                        <div class="SurveyItemDate">
                                            @item.date.Day @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(item.date.Month) @item.date.Year<br />
                                            <span class="glyphicon glyphicon-time"></span> @item.date.Hour.ToString() :@item.date.Minute.ToString()
                                        </div>
                                    </div>
                                    <br />
                                </div>
                            }
                            else
                            {
                                <div class="SurveyItemFrame">
                                    <div class="SurveyItemFrameCaptionPassive">
                                        <span class="fa fa-quote-left"></span>
                                        <a href="@Url.Action("EditorSurveyDetails", "xzgqhjk", new { obje_id = item.id })">
                                            @item.text (yayınlanmadı!)
                                        </a>
                                        <span class="fa fa-quote-right"></span>
                                        <div class="SurveyItemDate">
                                            @item.date.Day @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(item.date.Month) @item.date.Year<br />
                                            <span class="glyphicon glyphicon-time"></span> @item.date.Hour.ToString() :@item.date.Minute.ToString()
                                        </div>
                                    </div>
                                    <br />
                                </div>
                            }
                        </li>
                    }
                </ol>
            }
            else
            {
                Response.Redirect("/xzgqhjk/Editor");
            }

        }
        catch
        {
            if (!Response.IsRequestBeingRedirected)
            { Response.Redirect(Url.Action("Index", "xzgqhjk")); }
        }
    </div>
}


