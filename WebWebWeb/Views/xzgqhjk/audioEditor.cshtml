
@{
    ViewBag.Title = "audioEditor";
    Layout = "~/Views/Shared/_LayoutEditor.cshtml";
}

@model WebWebWeb.Models.ShareObject
<style>
    input[type=submit] {
        display: none;
    }

    audio {
        width: 100%;
        position: absolute;
        top: 50%;
        left: 0px;
    }

    #ShareVideoGet {
        text-decoration: none;
        cursor: pointer;
        color: #808080;
    }
</style>

<div class="ShareMaterialheaderContent">
    @using (Html.BeginForm("audioEditor", "xzgqhjk", new { sort = 8 }, FormMethod.Post, new { enctype = "multipart/form-data" }))
    {//audio

        @Html.AntiForgeryToken()
        try
        {
            <div class="ShareStreemObjectWrapper">
                <p>
                    <strong>Kimler İçin Paylaşılacak?:</strong>
                    <strong>
                        @Html.DropDownListFor(mbox => mbox.sex, new[] {
new SelectListItem {Text="Seçiniz...", Value="" },
new SelectListItem { Text = "Yalnızca Kadınlar İçin Paylaşım", Value = "Erkek" },
new SelectListItem { Text = "Yalnızca Erkekler İçin Paylaşım", Value = "Kadın" },
new SelectListItem { Text = "Herkes İçin Paylaşım", Value = "XYX" } },
                     new { @id = "sex", @class = "form-control" })
                    </strong>
                </p>
                <p>
                    <strong>Paylaşımın Statüsü Nedir?:</strong>
                    <strong>
                        @Html.DropDownListFor(mbox => mbox.confrim, new[] {
new SelectListItem {Text="Seçiniz...", Value="" },
new SelectListItem { Text = "Paylaşım", Value = "1" },
new SelectListItem { Text = "Reklam", Value = "2" },
new SelectListItem { Text = "Duyuru ve Etkinlik", Value = "4" },
new SelectListItem { Text = "Öğretici Bilgi", Value = "8" }
       }, new { @id = "confrim", @class = "form-control" })
                    </strong>
                </p>
                <div class="shareLocationItemHeader">
                    <div class="ShareLocationIco">
                        <label for="ShareObjectAudioFileUpload"><i class="glyphicon glyphicon-volume-up"></i></label><div>Ses Kaydı Seç</div>
                        <input id="ShareObjectAudioFileUpload" class="custom-file-upload" name="file" type="file" accept="audio/*" capture="microphone" />
                    </div>
                </div>
                <div class="shareStreemContent">
                    <!--içerik başlangıç-->
                    <div class="ShareObjectWrapper">
                        <div class="ShareObjectFrame">
                            <audio id="audioPreview" controls="controls">
                                <source src="#" type="audio/mpeg" />
                                <source src="#" type="audio/mp3" />
                                <source src="#" type="audio/ogg" />
                                İnternet tarayıcınız eski sürüm olduğundan bu ses kaydını oynatamıyor.
                            </audio>
                        </div>

                    </div>
                    <!--içerik bitiş-->
                </div>
                <div class="shareStreemFooterElementWrapper">
                    <div class="ShareObjectTextWrp">
                        <div class="ShareObjectText">
                            @Html.TextArea("ShareObjectAudioText", new { @id = "ShareObjectAudioText", @class = "ShareTextInput", style = "height:100px", rows = "10", Placeholder = "...yazın" })
                        </div>
                        <div class="ShareObjectSend">
                            <label for="ShareObjectAudioBtn"><i class="glyphicon glyphicon-send"></i></label>
                            <input id="ShareObjectAudioBtn" type="submit" value="Kaydet" class="ButtonHiden" />
                        </div>
                    </div>
                </div>
            </div>
            <script type="text/javascript">
                $(document).ready(function () {
                    $(document).ready(function () {
                        $('#ShareObjectAudioFileUpload').change(function (event) {
                            $(File).each(function (e) {
                                if (e != this) {
                                    $(this).val('');
                                }
                            });
                            var Uri = URL.createObjectURL(event.target.files[0]);
                            $("#audioPreview").attr('src', Uri);
                        });
                    });
                });
            </script>
        }
        catch
        {
            if (!Response.IsRequestBeingRedirected)
            { Response.Redirect(Url.Action("Index", "xzgqhjk")); }
        }
    }
</div>

<div>
    @try
    {
        @Html.Action("EditorShareObjeList", "xzgqhjk", new { sort = 8 })   
    }
    catch
    {
    if (!Response.IsRequestBeingRedirected)
    { Response.Redirect(Url.Action("Index", "xzgqhjk")); }
    }

</div>
<div class="ShareObjectDetailsFooterEmpty">&nbsp;</div>



