
@{
    ViewBag.Title = "imagePanoramic360Editor";
    Layout = "~/Views/Shared/_LayoutEditor.cshtml";
}

@model WebWebWeb.Models.ShareObject
<style>
    input[type=submit] {
        display: none;
    }

    .ShareRouteCaptionItemsText {
        /*position:relative;
        display:inline;*/
    }
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r70/three.min.js"></script>
<div class="ShareMaterialheaderContent">
    @using (Html.BeginForm("imagePanoramic360Editor", "xzgqhjk", new { sort = 2 }, FormMethod.Post, new { enctype = "multipart/form-data" }))
    {//image
        @Html.AntiForgeryToken()

        try
        {        
        <div class="ShareStreemObjectWrapper">
            <p>
                <strong>Kimler İçin Paylaşılacak?:</strong>
                <strong>
                    @Html.DropDownListFor(mbox => mbox.sex, new[] {
new SelectListItem {Text="Seçiniz...", Value="" },
new SelectListItem { Text = "Yalnızca Kadınlar İçin Paylaşım", Value = "Erkek" },
new SelectListItem { Text = "Yalnızca Erkekler İçin Paylaşım", Value = "Kadın" },
new SelectListItem { Text = "Herkes İçin Paylaşım", Value = "XYX" } },
               new { @id = "sex", @class = "form-control" })
                </strong>
            </p>
            <p>
                <strong>Paylaşımın Statüsü Nedir?:</strong>
                <strong>
                    @Html.DropDownListFor(mbox => mbox.confrim, new[] {
new SelectListItem {Text="Seçiniz...", Value="" },
new SelectListItem { Text = "Paylaşım", Value = "1" },
new SelectListItem { Text = "Reklam", Value = "2" },
new SelectListItem { Text = "Duyuru ve Etkinlik", Value = "4" },
new SelectListItem { Text = "Öğretici Bilgi", Value = "8" }
               }, new { @id = "confrim", @class = "form-control" })
                </strong>
            </p>
            <div class="shareLocationItemHeader">
                <div class="ShareLocationIco">
                    <label for="ShareObjectPanaroma360FileUpload"><i class="glyphicon glyphicon-picture"></i></label><div>360° Fotoğraf Seç</div>
                    <input id="ShareObjectPanaroma360FileUpload" class="custom-file-upload" name="file" type="file" accept="image/*" capture="camera" />
                </div>
            </div>
            <div class="shareStreemContent">
                <!--içerik başlangıç-->
                <div class="ShareObjectWrapper360" id="ShareObjectWrapper360">
                    <div id="ShareObjectPanaroma360Frame" class="ShareObjectFrame">
                        <img id="ShareObjectPanaroma360Preview" src="#" style="width:auto; height:auto; display:none;" />
                    </div>
                    <!--içerik bitiş-->
                    <script src=" ~/Scripts/360Viewer.js"></script>
                    <script type="text/javascript">
                        $(document).ready(function () {
                            $('#ShareObjectPanaroma360FileUpload').change(function (event) {

                                $('#ShareObjectPanaroma360Frame').contents().remove();
                                $('#ShareObjectPanaroma360Frame').html('<img id="ShareObjectPanaroma360Preview" src="#" style="display:none; width:auto; height:auto;"/>');
                                $(File).each(function (e) {
                                    if (e != this) {
                                        $(this).val('');
                                    }
                                });
                                var Uri = URL.createObjectURL(event.target.files[0]);
                                $("#ShareObjectPanaroma360Preview").attr('src', Uri);

                                var container_id = 'ShareObjectPanaroma360Frame';
                                var modalAlb = 'ShareObjectWrapper360';
                                screen360View(container_id, modalAlb, Uri);
                            });
                        });
                    </script>
                </div>
                <!--içerik bitiş-->
            </div>
            <div class="shareStreemFooterElementWrapper">
                <div class="ShareObjectTextWrp">
                    <div class="ShareObjectText">
                        @Html.TextAreaFor(mbox => mbox.text, new { @id = "ShareObjectPanaroma360Text", @class = "ShareTextInput", style = "height:100px", rows = "10", Placeholder = "...yazın" })
                    </div>
                    <div class="ShareObjectSend">
                        <label for="ShareObjectPanaroma360Btn"><i class="glyphicon glyphicon-send"></i></label>
                        <input id="ShareObjectPanaroma360Btn" type="submit" value="Kaydet" class="ButtonHiden" />
                    </div>

                </div>
            </div>
        </div>
        }
        catch
        {
            if (!Response.IsRequestBeingRedirected)
            { Response.Redirect(Url.Action("Index", "xzgqhjk")); }
        }
    }
</div>
<div>
    @try
    {
        @Html.Action("EditorShareObjeList", "xzgqhjk", new { sort = 2 })
    }
    catch
    {
        if (!Response.IsRequestBeingRedirected)
        { Response.Redirect(Url.Action("Index", "xzgqhjk")); }
    }
</div>
<div class="ShareObjectDetailsFooterEmpty">&nbsp;</div>

