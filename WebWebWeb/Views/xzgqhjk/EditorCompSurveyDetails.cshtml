
@{
    ViewBag.Title = "EditorCompSurveyDetails";
    Layout = "~/Views/Shared/_LayoutEditor.cshtml";
}
<div class="container">
    <div class="ShareObjectDetailsBanner"><a href="javascript:window.history.go(-1)" class="fa fa-chevron-left"></a><span>Anket Detayı</span></div>
    @*<div class="ShareObjectDetailsBannerEmpty">&nbsp;</div>*@
    @model List<WebWebWeb.Models.SurveyQuestion>
    @try
    {
        if (string.IsNullOrEmpty(ViewBag.state))
        {
            <div class="SurveyFormList" id="SurveyFormList">
                <div class="SurveyQuestionList">
                    @Html.ActionLink("Sil", "EditorCompSurveyDetails", "xzgqhjk", new { obje_id = ViewBag.obje_id, surveyQuestionEvent = "delete" }, new { @class = "compShareDeleteLink" })
                    @Html.ActionLink("kontrol edildi", "EditorCompSurveyDetails", "xzgqhjk", new { obje_id = ViewBag.obje_id, surveyQuestionEvent = "Update"}, new { @class = "compShareDeleteLink" })
                    @{
        int count = 0;
        foreach (var item in Model)
        {
            count = count + 1;
                <div class="questionItemwrp">
                    <div class="QuestionText"><i>@count .</i> @item.questionText</div>
                    <div class="OptionText">@item.A_text</div>
                    <div class="OptionText">@item.B_text</div>
                    <div class="OptionText">@item.C_text</div>
                    <div class="OptionText">@item.D_text</div>
                </div>
}
                    }
                </div>
            </div>
        }
        else
        {
            <div class="SurveyFormList">Silindi</div>
        }
    }
    catch
    {
        if (!Response.IsRequestBeingRedirected)
        { Response.Redirect(Url.Action("Editor", "xzgqhjk")); }
    }

</div>


