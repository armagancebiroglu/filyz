
@model List<WebWebWeb.Models.SurveyQuestion>

<div class="SurveyFormList" id="SurveyFormList">
    <div class="SurveyQuestionList">

        @if (true)
        {
            int count = 0;
            foreach (var item in Model)
            {
                count = count + 1;

                <div class="questionItemwrp">
                    <div class="SurveyQuestionDeleteDiv">
                        <div>
                            Bu soruyu silmek istediğinize emin misiniz?
                        </div>
                        <div class="SurveyItemDeleteDivRight">
                            <span class="fa fa-close SurveyQuestionCancelTrigger"></span>|
                            @Ajax.ActionLink(" ", "EditorSurveyEditQeustion", "xzgqhjk", new { surveyQuestionEvent = "delete", obje_id = item.survey_id, question_id = item.id }, new AjaxOptions { UpdateTargetId = "SurveyFormList", InsertionMode = InsertionMode.Replace, OnComplete = "" }, new { @class = "fa fa-trash-o" })
                        </div>
                    </div>
                    <span class="fa fa-trash-o SurveyQuestionDeleteTrigger"></span>
                    <div class="QuestionText"><i>@count .</i> @item.questionText</div>
                    <div class="OptionText">@item.A_text</div>
                    <div class="OptionText">@item.B_text</div>
                    <div class="OptionText">@item.C_text</div>
                    <div class="OptionText">@item.D_text</div>
                </div>
            }
        }

    </div>

    @using (Ajax.BeginForm("EditorSurveyEditQeustion", "xzgqhjk", new { surveyQuestionEvent = "add", obje_id = ViewBag.obje_id }, new AjaxOptions { UpdateTargetId = "SurveyFormList", HttpMethod = "POST", InsertionMode = InsertionMode.Replace }))
    {
        @Html.AntiForgeryToken()
        try
        {
            <div class="surveyQuestionPreRender">
                <div class="surveyQuestionChekc"><input id="surveyOkBtn" type="submit" value="ok" /><label for="surveyOkBtn"><i class="fa fa-check"></i></label></div>
                <!--soru kısmı-->
                <div class="SurveyQuestionItem Question activeSurvey">
                    <div class="Text">soru:&nbsp;<label class="LabelSurvey"></label></div>
                    <div class="surveyEditDetailsInput activeSurvey surveyInput">
                        <div class="surveyEditQuestionTextInput surveyText">
                            @Html.TextArea("Question", new { @id = "SurveyEditQeustionText", @class = "QuestionTextArea", rows = "3", Placeholder = " ...Soru ekleyin (*1500 karakter)" })
                        </div>
                        <div class="surveyEditDetailsSubmit">
                            <label for="btn_question"><i class="fa fa-plus"></i></label>
                            <input id="btn_question" type="button" name="questionBtn" class="questionBtn" />
                        </div>
                    </div>
                </div>
                <!---->
                <div class="SurveyQuestionItem Option">
                    <div class="Text">&nbsp;&nbsp; a )&nbsp;<label class="LabelSurvey"></label></div>
                    <div class="surveyEditDetailsOptionInput surveyInput">
                        <div class="surveyEditOptionTextInput surveyText">
                            @Html.TextArea("A_option", new { @class = "OptionTextArea", rows = "2", Placeholder = " ...şık ekleyin (*1500 karakter)" })
                        </div>
                        <div class="surveyEditDetailsOptionSubmit">
                            <label for="btn_option1"><i class="fa fa-plus"></i></label>
                            <input id="btn_option1" type="button" name="questionBtn" class="questionBtn" />
                        </div>
                    </div>
                </div>
                <div class="SurveyQuestionItem Option">
                    <div class="Text">&nbsp;&nbsp; b )&nbsp;<label class="LabelSurvey"></label></div>
                    <div class="surveyEditDetailsOptionInput surveyInput">
                        <div class="surveyEditOptionTextInput surveyText">
                            @Html.TextArea("B_option", new { @class = "OptionTextArea", rows = "2", Placeholder = " ...şık ekleyin (*1500 karakter)" })
                        </div>
                        <div class="surveyEditDetailsOptionSubmit">
                            <label for="btn_option2"><i class="fa fa-plus"></i></label>
                            <input id="btn_option2" type="button" name="questionBtn" class="questionBtn" />
                        </div>
                    </div>
                </div>
                <div class="SurveyQuestionItem Option">
                    <div class="Text">&nbsp;&nbsp; c )&nbsp;<label class="LabelSurvey"></label></div>
                    <div class="surveyEditDetailsOptionInput surveyInput">
                        <div class="surveyEditOptionTextInput surveyText">
                            @Html.TextArea("C_option", new { @class = "OptionTextArea", rows = "2", Placeholder = " ...şık ekleyin (*1500 karakter)" })
                        </div>
                        <div class="surveyEditDetailsOptionSubmit">
                            <label for="btn_option3"><i class="fa fa-plus"></i></label>
                            <input id="btn_option3" type="button" name="questionBtn" class="questionBtn" />
                        </div>
                    </div>
                </div>
                <div class="SurveyQuestionItem Option">
                    <div class="Text">&nbsp;&nbsp; d )&nbsp;<label class="LabelSurvey"></label></div>
                    <div class="surveyEditDetailsOptionInput surveyInput">
                        <div class="surveyEditOptionTextInput surveyText">
                            @Html.TextArea("D_option", new { @class = "OptionTextArea", rows = "2", Placeholder = " ...şık ekleyin (*1500 karakter)" })
                        </div>
                        <div class="surveyEditDetailsOptionSubmit">
                            <label for="btn_option4"><i class="fa fa-plus"></i></label>
                            <input id="btn_option4" type="button" name="questionBtn" class="questionBtn" />
                        </div>
                    </div>
                </div>
            </div>
        }
        catch
        {
            if (!Response.IsRequestBeingRedirected)
            { Response.Redirect(Url.Action("Home", "Home")); }
        }
    }
</div>

<script>
    $(document).ready(function () {
        $(".Option").css({ "position": "absolute", "visibility": "hidden" }); $("textarea").each(function () { $(this).val(""); });

        $(".questionBtn").click(function () {
            $(this).parent().parent().parent().children(".Text").css({ "position": "relative", "visibility": "visible" },
                $(this).parent().parent().css({ "position": "absolute", "visibility": "hidden" }),
                $(this).parent().parent().parent().children(".Text").children("label:first").text($(this).parent().parent().children(".surveyText").children("textarea:first").val()),
                $(this).parent().parent().parent().next().css({ "position": "relative", "visibility": "visible" }));
            $(this).parent().parent().parent().next().children(".surveyInput").css({ "position": "relative", "visibility": "visible" });
        });

        $(".LabelSurvey").click(function () {
            $(".surveyInput").each(function () { $(this).css({ "position": "absolute", "visibility": "hidden"}); });
            $(this).parent().parent().children(".surveyInput").css({ "position": "relative", "visibility": "visible" });
            $(this).parent(".Text").css({ "position": "absolute", "visibility": "hidden" });
        });

        $(".SurveyQuestionDeleteTrigger").click(function () {
            $(this).parent().children(".SurveyQuestionDeleteDiv").stop().slideDown();
        });
        $(".SurveyQuestionCancelTrigger").click(function () {
            $(this).parent().parent(".SurveyQuestionDeleteDiv").stop().slideUp();
        });

        $(".questionItemwrp").each(function () {
            var num = 0;
            $(this).children(".OptionText").each(function () {
                if ($(this).text()!="") {
                    switch (num) {
                        case 0:
                            var text = " a-";
                            break;
                        case 1:
                            var text = " b-";
                            break;
                        case 2:
                            var text = " c-";
                            break;
                        case 3:
                            var text = " d-";
                            break;
                        default:
                            var text = "";
                    }
                    $(this).before("<i>" + text + "</i>");
                    num++;
                }

            });
        });
    });
</script>

