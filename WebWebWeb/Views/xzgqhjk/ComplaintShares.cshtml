@model List<WebWebWeb.Models.EditorComplaint>
@if (Model != null)
{
    foreach (var item in Model)
    {
        <div class="compItem">
            <div class="compItemCaption">
                <div class="compWho">
                    <a href="@Url.Action("Profil", "Profil", new { member_id = item.complaint_who_id })">
                        <img src="@item.who_profil_media" class="img-circle" width="70" height="70" style=" box-shadow:0px 5px 5px grey" />
                    </a>
                    <div><span>@item.who_nick_name</span></div>
                </div>
                <div class="compWho">
                    <a href="@Url.Action("Profil", "Profil", new { member_id = item.share_memberid })">
                        <img src="@item.whom_profil_media" class="img-circle" width="70" height="70" style=" box-shadow:0px 5px 5px grey; border:solid 3px red;" />
                    </a><div><span>@item.whom_nick_name</span></div>
                </div>
                <div class="compEvent">
                    <div>
                        @if (item.share_sort == 32)
                        {
                            <a href="@Url.Action("EditorCompSurveyDetails", "xzgqhjk", new { obje_id = item.share_id })">Anket Detayına git </a>
                        }
                        else
                        {
                            <a href="@Url.Action("EditorShareDetails", "xzgqhjk", new { obje_id = item.share_id, sort = item.share_sort, whom_id = item.share_memberid })">Detaya git</a>
                        }
                    </div>
                    <div>@Ajax.ActionLink("üyeyi sil", "ComplaintShares", "xzgqhjk", new { Event = "memeberDelete", member_id = item.share_memberid, page = 0 }, new AjaxOptions { UpdateTargetId = "refresh", InsertionMode = InsertionMode.Replace })</div>
                    <div>@Ajax.ActionLink("paylaşımı sil", "ComplaintShares", "xzgqhjk", new { Event = "ShareDelete", obje_id = item.share_id, page = 0 }, new AjaxOptions { UpdateTargetId = "refresh", InsertionMode = InsertionMode.Replace })</div>
                    <div>@Ajax.ActionLink("Kontrol edildi", "ComplaintShares", "xzgqhjk", new { Event = "ShareUpdate", obje_id = item.share_id, page = 0 }, new AjaxOptions { UpdateTargetId = "refresh", InsertionMode = InsertionMode.Replace })</div>
                </div>
            </div>
            <div class="compTxt">
                @item.complaint_text
            </div>
            <div class="compBody">
                @if (item.share_sort == 4)
                {
                    <div class="shareStreemVideoWrp">
                        <video id="videoid" src="@item.share_imgUrl" style="width:100%;" controls>
                            <source src="@item.share_imgUrl" type="video/mp4" />
                            <source src="@item.share_imgUrl" type="video/ogg" />
                            <source src="@item.share_imgUrl" type="video/webm" />
                            İnternet tarayıcınız eski sürüm olduğundan bu videoyu oynatamıyor.
                        </video>
                        <script type="text/javascript">
                            $(document).ready(function () {
                                var myVideo = document.getElementById("videoid");
                                function playPaus() {
                                    if (myVideo.paused) {
                                        myVideo.play();
                                    }
                                    myVideo.pause();
                                }
                            });

                        </script>
                    </div>
                }
                else if (item.share_sort == 8)
                {
                    <div class="shareStreemAudioWrp">
                        <audio id="audio" width="100%" controls="controls">
                            <source src="@item.share_imgUrl" type="audio/mpeg" />
                            <source src="@item.share_imgUrl" type="audio/mp3" />
                            <source src="@item.share_imgUrl" type="audio/ogg" />
                            İnternet tarayıcınız eski sürüm olduğundan bu ses kaydını oynatamıyor.
                        </audio>
                    </div>
                }
                else if (item.share_sort == 0)
                {
                    <img src="@item.share_imgUrl" />
                }
                else if (item.share_sort == 16)
                {
                    <img src="@item.share_imgUrl" />                   

                }
                <div class="compTxtDiv">@item.share_text</div>
            </div>
        </div>
    }
}
else
{
    <div> hiç şikayet yok</div>
}

