
@{
    ViewBag.Title = "ChangePasswordAdmin";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@model WebWebWeb.Models.ChangePassword
<div class="container">
    <div class="ShareObjectDetailsBanner"><a href="javascript:window.history.go(-1)" class="fa fa-chevron-left"></a><span>Şifre Değiştirme</span></div>
    <div class="ShareObjectDetailsBannerEmpty">&nbsp;</div>
    <br /><br /><br />
    <div class="form-group FormLogin col-sm-6 shadowDiv">
        <fieldset>
            <legend>Şifre Değiştirme</legend>
            @using (Html.BeginForm("ChangePasswordAdmin", "xzgqhjk", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                try
                {               
                <strong>Şifre:</strong>
                <div class="input-group">
                    <span class="input-group-addon"><i class="glyphicon glyphicon-user"></i></span>

                    <strong> @Html.TextBox("Old_password", "", new { @id = "Old_password", @class = "form-control", placeholder = "Şifrenizi Giriniz." })</strong>
                </div>
                <br />
                <strong>Yeni Şifre:</strong>
                <div class="input-group">
                    <span class="input-group-addon"><i class="glyphicon glyphicon-lock"></i></span>
                    @Html.TextBox("New_password", "", new { @id = "New_password", @class = "form-control", placeholder = "Yeni Şifre Giriniz." })
                </div>
                <strong>Yeni Şifre Tekrar:</strong>
                <div class="input-group">
                    <span class="input-group-addon"><i class="glyphicon glyphicon-lock"></i></span>
                    @Html.TextBox("confrim_password", "", new { @id = "confrim_password", @class = "form-control", placeholder = "Yeni Şifreyi Tekrar Giriniz." })
                </div>
                <br />
                <strong>@Html.ValidationMessageFor(mbox => mbox.password, "", new { @class = "erorMessage" })</strong>


                <strong><input type="submit" name="enter" value="Kaydet" class="form-control backgrounFontColor" /></strong>

                }
                catch
                {
                    if (!Response.IsRequestBeingRedirected)
                    { Response.Redirect(Url.Action("Index", "xzgqhjk")); }
                }
            }
        </fieldset>
    </div>
</div>
