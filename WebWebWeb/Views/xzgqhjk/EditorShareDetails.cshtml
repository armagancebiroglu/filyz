
@{
    ViewBag.Title = "EditorShareDetails";
    Layout = "~/Views/Shared/_LayoutEditor.cshtml";
}

@model WebWebWeb.Models.shareStreem

<!DOCTYPE html>
<html>
<head>
    <title>SharedObjectDetails</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r70/three.min.js"></script>
</head>
<body>
    <div class="container" id="refresh">
        <div class="ShareObjectDetailsBanner"><a href="javascript:window.history.go(-1)" class="fa fa-chevron-left"></a><span>Paylaşım Detayı</span></div>
        <div class="ShareObjectDetailsBannerEmpty">&nbsp;</div>
        <br />
        @try
        {
            if (string.IsNullOrEmpty(ViewBag.state))
            {


                if (Model != null)
                {
                    <div class="ShareStreemObjectWrapper">
                        <div class="shareStreemHeader">
                            <div class="ShareStreemMemberProfilImage">
                                <div class="ShareStreemOnline">
                                    @if (Convert.ToInt32(Model.member_isonline) == 0)
                                    {
                                        <span id="is_online" class="glyphicon glyphicon-record" style="color:#c0c0c0;"></span>
                                    }
                                    else
                                    {
                                        <span id="is_online" class="glyphicon glyphicon-record" style="color:#43ee0f;"></span>
                                    }
                                </div>
                                <figure>
                                    <a href="@Url.Action("Profil", "Profil", new { member_id = Model.member_id })">
                                        <img src="@Model.member_profil_media" class="img-circle" width="46" height="46" style=" box-shadow:0px 5px 5px grey" />
                                    </a>
                                </figure>
                            </div>
                            <div class="ShareMemberShortDescription">
                                @if (Model.member_nick_name != null)
                                {
                                    int year = DateTime.Now.Year - Model.member_age.Year;
                                    <div class="ShareStreemAge">@Model.member_nick_name </div>

                                }
                                @if (Model.member_age != null)
                                {
                                    int year = DateTime.Now.Year - Model.member_age.Year;
                                    <div class="ShareStreemAge">yaş: @year</div>

                                }
                                @if (Model.member_city != null)
                                {
                                    <div class="ShareStreemCity">şehir: @Model.member_city</div>
                                }
                            </div>
                            <div class="SharingObjectDate">@Model.date.Day @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.date.Month)</div><br />
                            <div class="SharingObjectDateHour"><span class="glyphicon glyphicon-time"></span> @Model.date.Hour.ToString() :@Model.date.Minute.ToString()</div>
                        </div>
                        <div class="shareStreemContent">

                            @try
                            {
                                if (!string.IsNullOrEmpty(Model.image_url))
                                {
                                    if (Model.sort == 0)
                                    {
                                        <div class="shareStreemImgWrp">
                                            <a>
                                                <div class="shareStreemContentImage">
                                                    <img src="@Model.image_url" />
                                                </div>
                                            </a>
                                            <div class="shareStreemImageText"><i class="fa fa-quote-left"></i> @Model.text <i class="fa fa-quote-right"></i></div>
                                        </div>
                                    }
                                    else
                                    {
                                        if (Model.sort == 1)
                                        {
                                            string shareStreemImgPanoramicWrp180_id = "shareStreemImgPanoramicWrp180_id" + Model.number.ToString();
                                            string ShareObjectPanaromaPreview180 = "ShareObjectPanaromaPreview180" + Model.number.ToString();
                                            <div class="shareStreemImgPanoramicWrp" id="@shareStreemImgPanoramicWrp180_id" style="background-image:url('@Model.image_url'); background-size:cover; background-repeat:no-repeat;">
                                                <div class="AlbumAddIco">
                                                    <div class="share180icon">
                                                        <div class="AlbumItemTypesIconWrapper">
                                                            <div class="AlbumItemTypesDiv">
                                                                <i class="fa fa-photo iconZ"></i>
                                                                <span class="fa fa-male AlbumTrigger iconX"></span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <img id="@ShareObjectPanaromaPreview180" class="ShareObjectPanaromaPreview" src="@Model.image_url" style="display:none; width:auto; height:auto;" />
                                            </div>
                                            <div class="shareStreemImageText"><i class="fa fa-quote-left"></i> @Model.text <i class="fa fa-quote-right"></i></div>
                                        }
                                        else
                                        {
                                            if (Model.sort == 2)
                                            {
                                                string shareStreemImgPanoramicWrp360_id = "shareStreemImgPanoramicWrp360_id" + Model.number.ToString();
                                                string ShareObjectPanaromaPreview360 = "ShareObjectPanaromaPreview360" + Model.number.ToString();
                                                <div class="shareStreemImgPanoramicWrp" id="@shareStreemImgPanoramicWrp360_id" style="background-image:url('@Model.image_url'); background-size:cover; background-repeat:no-repeat;">
                                                    <div class="AlbumAddIco">
                                                        <div class="share360icon">
                                                            <div class="AlbumItemTypesIconWrapper">
                                                                <div class="AlbumItemTypesDiv">
                                                                    <i class="fa fa-photo iconZ"></i>
                                                                    <div class="AlbumdivIconY">
                                                                        <i class="fa fa-refresh fa-spin iconY"></i>
                                                                    </div>
                                                                    <span class="fa fa-male AlbumTrigger iconX"></span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <img id="@ShareObjectPanaromaPreview360" class="ShareObjectPanaromaPreview" src="@Model.image_url" style="display:none; width:auto; height:auto;" />
                                                </div>
                                                <div class="shareStreemImageText"><i class="fa fa-quote-left"></i> @Model.text <i class="fa fa-quote-right"></i></div>
                                            }
                                            else
                                            {
                                                if (Model.sort == 4)
                                                {
                                                    string videoid = "video" + Model.number.ToString();
                                                    <div class="shareStreemVideoWrp">
                                                        <video id="@videoid" src="@Model.image_url" style="width:100%;" controls>
                                                            <source src="@Model.image_url" type="video/mp4" />
                                                            <source src="@Model.image_url" type="video/ogg" />
                                                            <source src="@Model.image_url" type="video/webm" />
                                                            İnternet tarayıcınız eski sürüm olduğundan bu videoyu oynatamıyor.
                                                        </video>
                                                        <script type="text/javascript">
                                                    $(document).ready(function () {
                                                        var myVideo = document.getElementById("video"+@Model.number.ToString());
                                                        function playPaus() {
                                                            if (myVideo.paused) {
                                                                myVideo.play();
                                                            }
                                                            myVideo.pause();
                                                        }
                                                    });

                                                        </script>
                                                    </div>
                                                    <div class="shareStreemImageText"><i class="fa fa-quote-left"></i> @Model.text <i class="fa fa-quote-right"></i></div>

                                                }
                                                else
                                                {
                                                    if (Model.sort == 8)
                                                    {
                                                        <div class="shareStreemAudioWrp">
                                                            <audio id="audio" width="100%" controls="controls">
                                                                <source src="@Model.image_url" type="audio/mpeg" />
                                                                <source src="@Model.image_url" type="audio/mp3" />
                                                                <source src="@Model.image_url" type="audio/ogg" />
                                                                İnternet tarayıcınız eski sürüm olduğundan bu ses kaydını oynatamıyor.
                                                            </audio>
                                                        </div>
                                                        <div class="shareStreemImageText"><i class="fa fa-quote-left"></i> @Model.text <i class="fa fa-quote-right"></i></div>
                                                    }
                                                    else
                                                    {
                                                        if (Model.sort == 16)
                                                        {
                                                            <div class="shareStreemLocationWrp">
                                                                <div class="shareStreemLocationImg">
                                                                    <img src="@Model.image_url" />
                                                                </div>
                                                                <div class="shareStreemImageText"><i class="fa fa-quote-left"></i> @Model.text <i class="fa fa-quote-right"></i></div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            Response.Redirect(Url.Action("Info", "Default"));
                                                        }

                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                else
                                {
                                    if (Model.sort == 32)
                                    {
                                        <div class="shareStreemSurveyWrp">
                                            <div class="shareStreemSurveyIcon">
                                                <span class="fa fa-edit"></span>
                                            </div>
                                            <div class="shareStreemSurveyText"><i class="fa fa-quote-left"></i> @Model.text <i class="fa fa-quote-right"></i></div>
                                            <div class="shareStreemSurveyFooter">
                                                <div><a href="@Url.Action("ProfilSurveyDetails", "Profil", new { survey_id = Model.id, whom_id = Model.member_id })">@Html.Action("SurveyCheck", "Profil", new { whom_id = Model.member_id, obje_id = Model.id })</a></div><div></div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        Response.Redirect(Url.Action("Info", "Default"));
                                    }
                                }
                            }
                            catch
                            {
                                Response.Redirect(Url.Action("Info", "Default"));
                            }
                        </div>
                        <div class="shareStreemFooter">
                                    @Html.ActionLink("Sil", "EditorShareDetails", "xzgqhjk", new { obje_id = ViewBag.obje_id, sort = Model.sort, whom_id = Model.member_id, shareEvent = "delete" }, new { @class = "compShareDeleteLink" })
                                    @Html.ActionLink("kontrol edildi", "EditorShareDetails", "xzgqhjk", new { obje_id = ViewBag.obje_id, sort = Model.sort, whom_id = Model.member_id, shareEvent = "Update" }, new { @class = "compShareDeleteLink" })
                                    @using (Html.BeginForm("EditorShareDetails", "xzgqhjk", new { obje_id = ViewBag.obje_id, sort = Model.sort, whom_id = Model.member_id, shareEvent ="ShareShare"}))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.TextArea("Text", Model.text, new { @id = "txtArea", @class = "ShareTextArea", rows = "10" })                                       
                                        <input id="btn" type="submit" value="Paylaş" />
                                    }                              
                        </div>
                    </div>
                }
            }
            else
            { <div>Silindi</div>}

        }
        catch
        {
            if (!Response.IsRequestBeingRedirected)
            { Response.Redirect(Url.Action("Home", "Home")); }
        }
        <div class="ShareObjectDetailsFooterEmpty">&nbsp;</div>
    </div>
    <script src=" ~/Scripts/360Viewer.js"></script>
    <script src=" ~/Scripts/180Viewer.js"></script>
    <script type="text/javascript">
        $(Document).ready(function () {
            var removable_items = null;
            var W_H;
            $('.share180icon').click(function () {
                removable_items = $(this).parent().parent().attr("id");
                $(".shareStreemImgPanoramicWrp").each(function () {
                    $(this).children("canvas").remove();
                });
                $(this).parent().parent().children().add("canvas");
                $(this).parent().css("visibility", "hidden");

                var Uri = $(this).parent().parent().children("img").attr("src");

                var img = document.getElementById($(this).parent().parent().children("img").attr("id"));
                W_H = img.naturalWidth / img.naturalHeight;
                if (W_H >= 4) {
                    W_H = 6.3;
                }
                var container_id = $(this).parent().parent().attr("id");
                var modalAlb = container_id;
                img = null;
                screen180View(W_H, container_id, modalAlb, Uri);
            });

            $(".share360icon").click(function () {
                removable_items = $(this).parent().parent().attr("id");

                $(this).parent().css("visibility", "hidden");

                var URL = $(this).parent().parent().children("img").attr("src");
                var container_id2 = $(this).parent().parent().attr("id");
                var modalAlb2 = container_id2;
                screen360View(container_id2, modalAlb2, URL);
            });
        });
    </script>
</body>
</html>


