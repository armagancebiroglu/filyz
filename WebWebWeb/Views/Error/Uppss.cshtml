
@{
    ViewBag.Title = "Uppss";
    Layout = "~/Views/Shared/_LayoutError.cshtml";
    //Layout = null;
}
<script>
    $(document).ready(function () {
        var result = true;
        if (result) {
            $("#Upssmodal").modal({
                show: 'true',
                backdrop: 'static'
            });
            result = false;
        }
    });
</script>
<style type="text/css">
    .modal1 {
        padding:0;
        display:block;
        min-height:400px;
        background:rgba(200,180,190,0.25);
        backdrop-filter:blur(6px); 
        /*display:flex;*/
        /*align-items:center;*/
        /*justify-content:center;*/
        border-radius:var(--border-radius-lg);
        padding:24px; 
        font-family:'DM Sans',sans-serif;
    }
    .content1 {
        width: 100%;
        max-width: 420px;
        padding: 0;
        background: rgba(255,255,255,0.68);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(255,255,255,0.70);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(0,0,0,0.10);
    }
    .header1 {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        height:60px;
        border-bottom: 1px solid rgba(233,63,105,0.18);
        background: rgba(255,255,255,0.50);
    }
    .header2 {
        display: flex;
        align-items: center;
        gap: 9px;
        position: absolute;
        left: 25px;
    }
    .header3 {
        width: 30px;
        height: 30px;
        flex-shrink: 0;
        border-radius: 50%;
        background: rgba(233,63,105,0.12);
        border: 1px solid rgba(233,63,105,0.28);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .button1 {
        position: absolute;
        right: 25px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: 1px solid rgba(200,200,210,0.55);
        background: rgba(255,255,255,0.55);
        color: #888;
        font-size: 16px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align:center;
        transition: all 0.18s;
    }
</style>
<div class="row">
    <div class="col-sm-6">
        <div class="modal fade modal1" id="Upssmodal" role="dialog">
            <div class="modal-dialog">
                <!-- modal content-->
                <div class="modal-content content1">
                    <div class="modal-header header1">
                        <div class="header2">
                            <div class="header3">
                                <i style="font-style:normal; font-size:25px; color:#e93f69;"> &#9888;</i>
                            </div>
                            <span style="font-size:12px; font-weight:700; color:#e93f69; letter-spacing:0.6px; text-transform:uppercase; font-family:'DM Mono',monospace;">Uyarı</span>
                        </div>
                        <button class="button1" onclick="history.go(-1)">
                         <i style="font-size:28px;">&times;</i>
                        </button>
                    </div>

                    <div class="modal-body" style="padding:22px,20px,24px;">

                        <p style="margin:0; font-size:14px; line-height:1.7; color:#444;">

                            @try
                            {
                                @ViewBag.message
                            }
                            catch
                            {
                                if (!Response.IsRequestBeingRedirected)
                                { Response.Redirect(Url.Action("Info", "Default")); }
                            }

                        </p>
                    </div>
                    <div class="modal-footer">
                        @if (ViewBag.P == 38)
                        {
                            <button type="button" class="btn btn-default" data-dismiss="modal" onclick="location.href='@Url.Action("Payment", "Home")'">Üyelik Yükseltme Sayfasına Git</button>
                        }
                        else if (ViewBag.P == 39)
                        {
                            <button type="button" class="btn btn-default" data-dismiss="modal" onclick="location.href='@Url.Action("Payment", "Home")'">Üyelik Yükseltme Sayfasına Git</button>
                        }
                        else if (ViewBag.P == 40)
                        {
                            <button type="button" class="btn btn-default" data-dismiss="modal" onclick="location.href='@Url.Action("Payment", "Home")'">Üyelik Yükseltme Sayfasına Git</button>
                        }
                        else if (ViewBag.P == 41)
                        {
                            <button type="button" class="btn btn-default" data-dismiss="modal" onclick="window.close()">Kapat</button>
                        }
                        else if (ViewBag.P == 42)
                        {
                            <button type="button" class="btn btn-default" data-dismiss="modal" onclick="location.href='@Url.Action("Home", "Home")'">Anasayfaya Git</button>
                            <button type="button" class="btn btn-default" data-dismiss="modal" onclick="location.href='@Url.Action("Survey", "Home")'">Anket Sayfasına Git</button>
                        }
                        else
                        {

                        }
                    </div>
                </div>

            </div>
        </div>
        <input type="hidden" class="LocationMemberId" value="item.member_id" />
    </div>
</div>




