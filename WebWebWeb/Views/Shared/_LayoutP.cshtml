<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, minimum-scale=1">
    <meta name="keywords" content="islami evlilik sitesi, islami evlilik, muhafazakar eş bulma sitesi, müslüman eş bulma, müslüman hanımlar, tesettürlü hanımlar, tesettürlü eş bulma" />

    <!-- CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/StyleSheetGlassmorphism.css" rel="stylesheet" />
    <link rel="icon" type="image/x-icon" href="/filyz-favicon.ico" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- Validation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <!-- Ajax -->
    <script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
    <!-- Bootstrap JS (en sona yakın) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- SignalR -->
    @*<script src="~/Scripts/jquery.signalR-2.2.3.min.js"></script>*@
    @*<script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
    <script src="~/signalr/hubs"></script>*@


    <script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
    <script src="~/signalr/hubs"></script>
    <script src="~/Scripts/chat.js"></script>
    <title>Filyz.com</title>
</head>
<body>
    <div class="main-header">
        <div class="containerLayout">
            <div class="row h-100 align-items-center">
                <div class="col">
                    <div class="d-flex align-items-center h-100">
                        <!-- Logo -->
                        <a href="@Url.Action("Home", "Home")" class="logo" id="logoLink">
                            <img src="~/Media/img/logo1.jpg" />
                        </a>
                        <!-- User Section -->
                        <div class="wrpMainPrf">
                            @*d-flex align-items-center gap-3 wrpMainPrf*@
                            @Html.Action("NoticeShortList", "Home", new { who_id = Convert.ToInt32(Session["id"]) })
                            <div class="dropdown">
                                <div class="menu-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="fa fa-ellipsis-v"></span>
                                </div>
                                <div class="dropdown-menu dropdown-menu-end menu-dropdown">
                                    <a href="@Url.Action("MessageMyAll","MyProfil")" class="menu-item"><span class="fa fa-envelope"></span>Mesajlar</a>
                                    <a href="@Url.Action("FavoriteList", "MyProfil")" class="menu-item"><span class="fa fa-star"></span>Favoriler</a>
                                    <a href="@Url.Action("SmileList", "MyProfil")" class="menu-item"><span class="fa fa-heart"></span>Gülümseler</a>
                                    <a href="@Url.Action("ProfilView", "MyProfil")" class="menu-item"><span class="fa fa-eye"></span>Profil İnceleme</a>
                                    <a href="@Url.Action("Survey", "MyProfil")" class="menu-item"><span class="fa fa-pencil"></span>Anketler</a>
                                    <a href="@Url.Action("TagMyShared", "MyProfil")" class="menu-item"><span class="fa fa-tags"></span>Etiketlediklerim</a>
                                    @*<a href="@Url.Action("How", "Home")" class="menu-item"><span class="fa fa-question"></span>Nasıl Yapılır?</a>*@
                                    <a href="@Url.Action("Mail", "Home")" class="menu-item"><span class="fa fa-paper-plane red"></span>Bize Yazın</a>
                                    @*<li><a href="@Url.Action("Payment", "Home")"><span class="fa fa-money DropDownMenuLayoutSpan red"></span>Ödeme Sayfası</a>*@
                                    @*<a href="@Url.Action("Settings", "Home")" class="menu-item"><span class="fa fa-cog red"></span>Hesap Ayarları</a>*@
                                    <a href="@Url.Action("Info", "Default", new { w = 1})" class="menu-item" id="logoutLink"><span class="fa fa-power-off red"></span>Çıkış</a>
                                </div>
                            </div>
                            <div class="user-info-card">
                                <div class="d-flex align-items-center gap-2 position-relative">
                                    @{
                                        string url = "";
                                        string query = "";
                                        int id = 0;
                                        try
                                        {
                                            if (!string.IsNullOrEmpty(Session["profil_media"].ToString()))
                                            {
                                                url = Session["profil_media"].ToString();
                                                query = Session["nick_name"].ToString();
                                                id = Convert.ToInt32(Session["id"]);
                                                <input type="hidden" value="@id" id="nickId" />
                                                <input type="hidden" value="@query" id="nick" /><!--Session["nick_name"].ToString();-->
                                                <input type="hidden" value="@url" id="MyImg" /><!--Session["profil_media"].ToString();-->
                                                <input type="hidden" value="@ViewBag.result" id="ChatResult" /><!--querystring ViewBag.result = Request.QueryString["chat"].ToString();-->
                                                <a href="@Url.Action("MyProfil", "MyProfil")">
                                                    <img src="@url" class="avatar" />
                                                </a>
                                                string nick = Session["nick_name"].ToString().ToUpper();
                                                <span class="username">@nick</span>
                                            }
                                            else
                                            {
                                                Response.Redirect(Url.Action("Info", "Default"));
                                            }
                                        }
                                        catch
                                        {
                                            if (!Response.IsRequestBeingRedirected)
                                            {
                                                Response.Redirect(Url.Action("Info", "Default"));
                                            }
                                        }

                                    }
                                    @try
                                    {
                                        if (Session["is_online"] != null)
                                        {
                                            @Html.Action("IsOnline", "Home")}
                                        else
                                        {
                                            Response.Redirect(Url.Action("Info", "Default"));
                                        }
                                    }
                                    catch
                                    {
                                        if (!Response.IsRequestBeingRedirected)
                                        {
                                            Response.Redirect(Url.Action("Info", "Default"));
                                        }
                                    }
                                </div>
                            </div>
                            <div>
                                @try
                                {
                                    int countDay = 30 - (DateTime.Now.Subtract(Convert.ToDateTime(Session["payment_date"])).Days);
                                    if (countDay < 0) { countDay = 0; }

                                    @*<div class="badgeSpan"><span class="fa fa-sun-o"></span> @countDay</div>*@
                                }
                                catch
                                {
                                    if (!Response.IsRequestBeingRedirected)
                                    {
                                        Response.Redirect(Url.Action("Info", "Default"));
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @RenderBody()
    @*@Html.Partial("_ChatPartial")*@
  
    <div class="footerWrapper">
        <div class="footer">
            <div class="footer-item-wrapper"><a href="@Url.Action("svrx", "Home")" class="footer-item"><i class="fa fa-heart"></i><span>Filyz</span> </a></div>
            <div class="footer-item-wrapper"><a href="@Url.Action("Search", "Home")" class="footer-item"> <i class="fa fa-search"></i><span>Arama</span></a></div>
            <div class="footer-item-wrapper"><a href="@Url.Action("Survey", "Home")" class="footer-item"> <i class="fa fa-pencil"></i><span>Anket</span></a></div>
            <div class="footer-item-wrapper">@Html.Action("ChatNot", "Home")</div>
            @*<a href="@Url.Action("SearchLocation", "Home")" class="footer-item"> <i class="fa fa-map-marker"></i><span>Konum</span></a>*@
            @*<a href="@Url.Action("Chat", "Home")" class="footer-item"> <i class="fa fa-comments"></i><span>Chat</span></a>*@

        </div>
    </div>

    <script>
   
    </script>
</body>
</html>
