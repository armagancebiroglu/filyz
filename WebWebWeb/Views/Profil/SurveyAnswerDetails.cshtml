
@{
    ViewBag.Title = "SurveyAnswerDetails";
    Layout = "~/Views/Shared/_LayoutP.cshtml";
}

@model WebWebWeb.Models.shareStreem
<div class="container">
    <div class="empty80">&nbsp;</div>
    <div class="sc-page">
        @try
        {
            int yas = (int)(DateTime.Now.Year) - (int)((ViewBag.member.age).Year);
            <div class="sc-card glass">
                <div class="sc-section-hd">
                    <i class="fa fa-file-text" style="color:var(--rose);font-size:17px"></i>
                    <div class="sc-section-title">
                        <i class="fa fa-quote-left"></i> Cevaplayanlar
                    </div>
                </div>
                @Html.Action("SurveyRespondentsList", "MyProfil", new { shareObje_id = ViewBag.survey_id })
            </div>
            <div class="sc-card glass">
                <div class="sc-section-hd">
                    <i class="fa fa-heart" style="color:var(--rose);font-size:17px"></i>
                    <div class="sc-section-title">
                        <i class="fa fa-quote-left"></i> Beğenenler
                    </div>
                </div>
                <div class="panel-body" id="likesBody" style="display:block;">
                    <div class="likes-grid" id="likesGrid">
                        @Html.Action("EnjoyShared", "MyProfil", new { shareObje_id = ViewBag.survey_id, noticeTableSort = 0 })
                    </div>
                </div>
            </div>
            <div class="sc-card glass sv-member-card" style="width:100%;">               
                <div class="sv-member-avatar-wrap">
                    <a href="@Url.Action("Profil", "Profil", new { member_id = ViewBag.member.id })">
                        <img src="@ViewBag.member.profil_media" class="sv-member-avatar" alt="@ViewBag.member.nick_name">
                    </a>
                    @if (Convert.ToBoolean(ViewBag.isonline))
                    {
                        <div class="sv-online-dot"></div>
                    }
                    else
                    {
                        <div class="sv-offline-dot"></div>
                    }
                </div>
                <div class="sv-member-info">
                    <div class="sv-member-nick">@ViewBag.member.nick_name</div>
                    <div class="sv-member-detail">
                        <span><i class="fa fa-calendar"></i> @yas yaşında</span>
                        <span><i class="fa fa-map-marker"></i>@ViewBag.member.city</span>
                        <span><i class="fa fa-home"></i> @ViewBag.member.country</span>
                        <span><i class="fa fa-graduation-cap"></i>  @ViewBag.member.educational_status</span>
                        <span><i class="fa fa-heart"></i> @ViewBag.member.matiral_status</span>
                    </div>
                </div>
            </div>
            <div class="sc-card glass">
                <div class="sc-section-hd">
                    <i class="fa fa-edit" style="color:var(--rose);font-size:17px"></i>
                    <div class="sc-section-title">
                        <i class="fa fa-quote-left"></i>  @ViewBag.surveytext
                    </div>
                </div>
                <div id="answerRefresh">
                    @Html.Action("SurveyAnswerProfilList", "Profil", new { obje_id = ViewBag.survey_id, whom_id = ViewBag.member.id })
                </div>
                <div class="actionWr d-flex align-items-center gap-2 mb-3">
                    <div class="actionW">
                        @Html.Action("NoticeEventHeartMyProfil", "MyProfil", new { obje_id = ViewBag.survey_id, sort = 32, noticeTableSort = 0 })
                    </div>
                    <div class="actionW" id="refresh">
                        @Html.Action("TagCount", "MyProfil", new { obje_id = ViewBag.survey_id })                      
                    </div>
                    <div class="flex-grow-1"></div>
                    <div class="actionW">
                        @Html.Action("SurveyRespondentsCount", "MyProfil", new { obje_id = ViewBag.survey_id })
                    </div>
                </div>
                <div class="actionW">
                    @Html.Action("Comment", "Home", new { obje_id = ViewBag.survey_id, sort = 32, whom_id = ViewBag.member.id, noticeTableSort = 0 })
                </div>                              
            </div>
        }
        catch
        {
            if (!Response.IsRequestBeingRedirected)
            { Response.Redirect(Url.Action("Home", "Home")); }
        }
    </div>
    <div class="empty80">&nbsp;</div>
</div>

