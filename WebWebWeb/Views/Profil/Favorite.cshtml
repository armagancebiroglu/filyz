
@model WebWebWeb.Models.Favorite

@try
{
    string id = "actionFavorite" + ViewBag.whom_id;
<div id="@id">
    @if (ViewBag.result != 0)
    {
        if (ViewBag.result == 1)
        {
            <div style="display:block;">
                @Ajax.ActionLink(" ", "Favorite", "Profil", new { whom_id = ViewBag.whom_id, eventAction = "delete" }, new AjaxOptions { UpdateTargetId = id, HttpMethod = "GET", InsertionMode = InsertionMode.ReplaceWith, OnComplete = "dislike" }, new { id = "delete", @class = "fa fa-star stat-icon selected" })
            </div>           
        }
        else
        {
            <div style="display:block;">
                @Ajax.ActionLink(" ", "Favorite", "Profil", new { whom_id = ViewBag.whom_id, eventAction = "delete" }, new AjaxOptions { UpdateTargetId = id, HttpMethod = "GET", InsertionMode = InsertionMode.ReplaceWith, OnComplete = "dislikeBlocked" }, new { id = "deleteBlocked", @class = "fa fa-user-times stat-icon selected" })
            </div>           
        }
    }
    else
    {
        <div style="display:block;">
            @Ajax.ActionLink(" ", "Favorite", "Profil", new { whom_id = ViewBag.whom_id, eventAction = "insert" }, new AjaxOptions { UpdateTargetId = id, HttpMethod = "GET", InsertionMode = InsertionMode.ReplaceWith, OnComplete = "like" }, new { id = "insert", @class = "fa fa-star stat-icon un-selected" })
        </div>
        <div style="display:block;">
            @Ajax.ActionLink(" ", "Favorite", "Profil", new { whom_id = ViewBag.whom_id, eventAction = "insertBlocked" }, new AjaxOptions { UpdateTargetId = id, HttpMethod = "GET", InsertionMode = InsertionMode.ReplaceWith, OnComplete = "likeBlocked" }, new { id = "insertBlocked", @class = "fa fa-user-times stat-icon un-selected" })
        </div>       
    }
</div>
}
catch
{
    if (!Response.IsRequestBeingRedirected)
    { Response.Redirect(Url.Action("Home", "Home")); }
}
