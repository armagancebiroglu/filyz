
@{
    ViewBag.Title = "ProfilSurveyDetails";
    Layout = "~/Views/Shared/_LayoutP.cshtml";
}

<div class="Container">
    <div class="empty80">&nbsp;</div>
    <div class="page-wrap">
        @try
        {
            int yas = (int)(DateTime.Now.Year) - (int)((ViewBag.member.age).Year);
            <div class="glass-card glass sv-member-card">
                <div class="sv-member-avatar-wrap">
                    <a href="@Url.Action("Profil", "Profil", new { member_id = ViewBag.member.id })">
                        <img src="@ViewBag.member.profil_media" class="sv-member-avatar" alt="@ViewBag.member.nick_name">
                    </a>
                    @if (Convert.ToBoolean(ViewBag.isonline))
                    {
                        <div class="sv-online-dot"></div>
                    }
                    else
                    {
                        <div class="sv-offline-dot"></div>
                    }
                </div>
                <div class="sv-member-info">
                    <div class="sv-member-nick">@ViewBag.member.nick_name</div>
                    <div class="sv-member-detail">
                        <span><i class="fa fa-calendar"></i> @yas yaşında</span>
                        <span><i class="fa fa-map-marker"></i>@ViewBag.member.city</span>
                        <span><i class="fa fa-home"></i> @ViewBag.member.country</span>
                        <span><i class="fa fa-graduation-cap"></i>  @ViewBag.member.educational_status</span>
                        <span><i class="fa fa-heart"></i> @ViewBag.member.matiral_status</span>
                    </div>
                </div>
            </div>
            <div class="glass-card glass">
                <div class="SurveyDetailsCaption">                   
                    <br />
                    <span class="fa fa-quote-left"></span>&nbsp;&nbsp; @ViewBag.survey.text &nbsp;&nbsp;<span class="fa fa-quote-right"></span>                  
                </div>       
                @Html.Action("SurveyAnswerProfilDetails", "Profil", new { survey_id = ViewBag.survey_id })
            </div>              
        }
        catch
        {
            if (!Response.IsRequestBeingRedirected)
            { Response.Redirect(Url.Action("Home", "Home")); }
        }
    </div>
    <div class="empty80"> &nbsp;</div>

</div>
<script>
    $(document).ready(function () {
        $("#PdDeleteicon").click(function () {
            $("#MsdDelete").stop(true, true).slideDown("slow");
        });
        $("#PdDeleteClose").click(function () {
            $("#MsdDelete").stop(true, true).slideUp("slow");
        });
        $(".SurveyTagCheck").click(function () {
            $("#MsdDelete").stop(true, true).slideDown("slow");
        });
    });
</script>
