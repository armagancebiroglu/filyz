
@model WebWebWeb.Models.Messages

@try
{
    if (ViewBag.messageCount > 0)
    {
    <a href="@Url.Action("ProfilMessage", "Profil", new { whom_id = ViewBag.whom_id })"><span class="fa fa-envelope stat-icon selected"></span></a><i>@ViewBag.messageCount</i>
    }
    else
    {
    <a href="@Url.Action("ProfilMessage", "Profil", new { whom_id = ViewBag.whom_id })"><span class="fa fa-envelope stat-icon un-selected"></span></a><i>0</i>
    }
}
catch
{
    if (!Response.IsRequestBeingRedirected)
    { Response.Redirect(Url.Action("Home", "Home")); }
}