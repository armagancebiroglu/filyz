
@{
    ViewBag.Title = "SurveyList";
    Layout = "~/Views/Shared/_LayoutP.cshtml";
}
@model List<WebWebWeb.Models.shareStreem>
<div class="Container">
    <div class="empty80">&nbsp;</div>
    <div class="page-wrap">
        @try
        {
            int yas = (int)(DateTime.Now.Year) - (int)((ViewBag.member.age).Year);
            <!-- ── Üye profil kartı ── -->
            <div class="glass-card glass sv-member-card">
                <div class="sv-member-avatar-wrap">
                    <a href="@Url.Action("Profil", "Profil", new {member_id=ViewBag.member.id})">
                        <img src="@ViewBag.member.profil_media" class="sv-member-avatar" alt="@ViewBag.member.nick_name">
                    </a>
                    @if (Convert.ToBoolean(ViewBag.isonline))
                    {
                        <div class="sv-online-dot"></div>
                    }
                    else
                    {
                        <div class="sv-offline-dot"></div>
                    }
                </div>
                <div class="sv-member-info">
                    <div class="sv-member-nick">@ViewBag.member.nick_name</div>
                    <div class="sv-member-detail">
                        <span><i class="fa fa-calendar"></i> @yas yaşında</span>
                        <span><i class="fa fa-map-marker"></i>@ViewBag.member.city</span>
                        <span><i class="fa fa-home"></i> @ViewBag.member.country</span>
                        <span><i class="fa fa-graduation-cap"></i> @ViewBag.member.educational_status</span>
                        <span><i class="fa fa-heart"></i> @ViewBag.member.matiral_status</span>
                    </div>
                </div>
            </div>

            <div class="glass-card">
                <div class="section-header">
                    <i class="fa fa-pencil-square" style="color: var(--main-color); font-size: 18px;"></i>
                    <div class="Ssection-title">Sordukları</div>
                    <div class="section-badge" id="Surveycount"></div>
                </div>
                <div class="SurvyeListWrp">
                    @if (Model != null)
                    {
                        if (Model.Count > 0)
                        {
                            foreach (var item in Model)
                            {
                                <div class="survey-item" style="animation-delay:0.3s">
                                    <div class="survey-header">
                                        <div class="survey-quote">
                                            <i class="fa fa-quote-left"></i>
                                            <a href="@Url.Action("ProfilSurveyDetails", "Profil", new { survey_id = item.id, whom_id=item.member_id})"> @item.text</a>
                                            <i class="fa fa-quote-right"></i>
                                        </div>
                                        <div class="survey-date">
                                            <i class="fa fa-calendar-o"></i>  @item.date.Day @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(item.date.Month) @item.date.Year <i class="fa fa-clock-o" aria-hidden="true"></i> @item.date.Hour.ToString() :@item.date.Minute.ToString()
                                        </div>
                                    </div>
                                    <div class="survey-stats">
                                        <span class="stat-badge">@Html.Action("NoticeEventHeart", "Home", new { obje_id = item.id, sort = item.sort, whom_id = item.member_id, noticeTableSort = 0 })</span>
                                        <span class="stat-badge">@Html.Action("TagMyCheck", "MyProfil", new { whom_id = item.member_id, obje_id = item.id })</span>
                                        <span class="stat-badge">@Html.Action("SurveyCheck", "Profil", new { whom_id = item.member_id, obje_id = item.id })</span>
                                        <span class="stat-badge">@Html.Action("Complaint", "Home", new { obje_id = item.id, sort = item.sort, whom_id = item.member_id, noticeTableSort = 0 })</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="survey-item draft" style="animation-delay:0.7s">
                                Düzenlediği anket yok
                            </div>
                        }
                    }
                    else
                    {
                        Response.Redirect("/Home/Home");
                    }
                </div>
            </div>
            <div class="glass-card">
                <div class="section-header">
                    <i class="fa fa-check-square" style="color: var(--main-color); font-size: 18px;"></i>
                    <div class="Ssection-title">Cevapladıkları</div>
                    <div class="section-badge" id="answeredCount"></div>
                </div>
                <div class="SurveyAnswerForm">                  
                    @Html.Action("SurveyQuestionAnswer", "Profil", new { whom_id = ViewBag.member.id })
                </div>
            </div>
        }
        catch
        {
            if (!Response.IsRequestBeingRedirected)
            { Response.Redirect(Url.Action("Home", "Home")); }
        }
        <div class="empty80">&nbsp;</div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $("#Surveycount").text($(".SurvyeListWrp .survey-item").length);
        $("#answeredCount").text($(".SurveyQuestionList .SapLcard").length);
    });
</script>