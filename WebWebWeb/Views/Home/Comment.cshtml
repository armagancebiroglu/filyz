@model WebWebWeb.Models.shareStreem

@{ string id = "shareStreemComment" + ViewBag.obje_id; }
<div class="actionW" id="@id">
    <div class="commentList ">
        @*collapse*@
        @{
            try
            {
                string txtComment = "txtComment" + ViewBag.obje_id;

                using (Ajax.BeginForm("Comment", "Home", new { eventAction = "comment", obje_id = ViewBag.obje_id, who_id = ViewBag.who_id, whom_id = ViewBag.whom_id, sort = ViewBag.sort, noticeTableSort = ViewBag.noticeTableSort }, new AjaxOptions { UpdateTargetId = id, HttpMethod = "GET", InsertionMode = InsertionMode.Replace, OnComplete = "Comment" }))
                {
                    @Html.AntiForgeryToken()
                    string btnComment = "btnComment" + ViewBag.obje_id;
                    <div class="mb-3">
                        <div class="input-group">
                            @Html.TextBox("text", "", new { @class = "comment-input", Placeholder = "yorum yazın" })
                            <input id="@btnComment" type="submit" class="btn btn-send px-3" value="Gönder" />
                        </div>
                    </div>
                }
                if (ViewBag.commentList != null)
                {
                    foreach (var comment in ViewBag.commentList)
                    {
                        <div class="commentListItem d-flex gap-2 mb-2">
                            <a href="@Url.Action("Profil", "Profil", new {member_id=comment.who_id})">
                                <img src="@comment.profil_media" class="comment-avatar" width="46" height="46" style=" box-shadow:0px 5px 5px grey" />
                            </a>
                            <div class="comment-body">
                                <div class="comment-author">@comment.nick_name</div>
                                <div>&nbsp;@comment.comment_text</div>
                                <div class="comment-time">@comment.date.Day @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(comment.date.Month) <span class="fa fa-clock-o"></span> @comment.date.Hour.ToString() :@comment.date.Minute.ToString()</div>


                                <div class="commentListItemFooter">
                                    <!-- kişi sadece kendi yorumunu silebilecek -->
                                    @if (ViewBag.who_id == comment.who_id)
                                    {
                                        <div class="deleteCommentblock"><span class="fa fa-trash commentDeleteTrigger"></span></div>
                                        <div class="deleteCommenthide">
                                            <div class="deleteCommentWrp">
                                                <div>Yorumunuzu silmek istediğinizden emin misiniz?</div>
                                                <div class="commentDelete">
                                                    <i class="fa fa-times commentDeleteClose"></i>|
                                                    @Ajax.ActionLink(" ", "Comment", "Home", new { eventAction = "delete", obje_id = comment.obje_id, whom_id = ViewBag.whom_id, sort = comment.sort, comment_id = comment.id, noticeTableSort = ViewBag.noticeTableSort }, new AjaxOptions { UpdateTargetId = id, InsertionMode = InsertionMode.Replace, OnComplete = "deleteComment" }, new { @class = "fa fa-trash" })
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    <!--  -->
                                </div>
                            </div>

                        </div>
                    }
                }
            }
            catch
            {
                if (!Response.IsRequestBeingRedirected)
                { Response.Redirect(Url.Action("Info", "Default")); }
            }
        }
    </div>
    <script>
        $(document).ready(function () {
            $('input[type="text"]').each(function () {
                $(this).val('');
            });
        });
    </script>
</div>

<script>
    $(document).ready(function () {
        $(".comment-input").each(function () { $(this).val(""); });
        $(".commentDeleteTrigger").click(function () {
            $(this).parent().parent().children(".deleteCommenthide").stop(true).slideDown("slow");
        });
        $(".commentDeleteClose").click(function () {
            $(this).parent().parent().parent(".deleteCommenthide").stop(true).slideUp("slow");
        });
    });
</script>

