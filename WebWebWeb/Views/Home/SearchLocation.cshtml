
@{
    ViewBag.Title = "SearchLocation";
    Layout = "~/Views/Shared/_LayoutP.cshtml";
}
@*<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDdU_xUeOU4WeMAPt5OJ4-elY9jEX3UxPM&callback=ShareLocationShowBtnclick"></script>*@
@*key buradan alınacak https://developers.google.com/maps/documentation/javascript/?refresh=1*@
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<!-- Google Maps script'ini kaldır, bunları ekle -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<div class="page-area" id="SearchLocation"> 
        <div class="SearchLocationFrame" id="SearchLocationFrame"></div>  
    <div class="left-side">      
    </div>
    <div class="right-side">       
    </div>
    <div class="tabWrpTop">
        <div class="tabs-container">
            <div class="radar-btn">
                <!-- Dış pulse halkalar -->
                <div class="pulse-ring"></div>
                <div class="pulse-ring"></div>
                <div class="pulse-ring"></div>
                <!-- Dönen tarama -->
                <div class="sweep"></div>
                <!-- Yazı -->
                <div class="km-label">
                    @Html.ActionLink("5km ", "SearchLocation", "Home", new { searchLocation = "distance", latitude = "", longitude = "", page = 0 }, new { id = "distance", @class = "km-num" })
                </div>
            </div>
            <div class="tab-btn">
                @Html.ActionLink(" ", "SearchLocation", "Home", new { @class = "fa fa-users" })
                <span>Son</span>
            </div>
            <div class="tab-btn">
                @Html.ActionLink(" ", "SearchLocation", "Home", new { searchLocation = "space", latitude = "", longitude = "", page = 0 }, new { id = "space", @class = "fa fa-map-marker" })
                <span>Şehir</span>
            </div>
            <div class="tab-btn">
                @Html.ActionLink(" ", "SearchLocation", "Home", new { searchLocation = "cursor", latitude = "", longitude = "", page = 0 }, new { id = "cursor", @class = "fa fa-map-marker marker-map" })
                <span>Pin</span>
            </div>
        </div>
    </div>
    <input type="hidden" id="LocLat" value="@ViewBag.LAT" />
    <input type="hidden" id="LocLong" value="@ViewBag.LNG" />
    @Html.Hidden("latitude")
    @Html.Hidden("longitude")
    @Html.Action("SearchLocationPartial", "Home", new { searchLocation = ViewBag.searchLocation, page = 0 })  
    @*<div class="empty80"> &nbsp;</div>*@
    <script type="text/javascript">
        $(document).ready(function () {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function (position) {
                    var lat = position.coords.latitude;
                    var lang = position.coords.longitude;

                    // Başlangıç konumu: kayıtlı konum varsa onu kullan, yoksa GPS konumu
                    var startLat = $("#LocLat").val() != "" ? parseFloat($("#LocLat").val()) : lat;
                    var startLng = $("#LocLong").val() != "" ? parseFloat($("#LocLong").val()) : lang;

                    // Leaflet haritayı oluştur
                    var map = L.map('SearchLocationFrame').setView([startLat, startLng], 12);

                    // OpenStreetMap tile layer ekle (Google Maps yerine, ücretsiz)
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        attribution: '© OpenStreetMap contributors',
                        maxZoom: 19
                    }).addTo(map);

                    // Sürüklenebilir marker oluştur
                    var marker = L.marker([startLat, startLng], {
                        draggable: true,
                        title: 'Sen Buradasın!',
                        zIndexOffset: 1000
                    }).addTo(map);

                    // Input alanlarını güncelle
                    $("#latitude").val(lat);
                    $("#longitude").val(lang);

                    // Arama linklerini güncelle
                    function updateLinks(lat, lng) {
                        $("#cursor").attr('href', "/Home/SearchLocation?searchLocation=cursor&latitude=" + lat + "&longitude=" + lng + "&page=0");
                        $("#distance").attr('href', "/Home/SearchLocation?searchLocation=distance&latitude=" + lat + "&longitude=" + lng + "&page=0");
                        $("#space").attr('href', "/Home/SearchLocation?searchLocation=space&latitude=" + lat + "&longitude=" + lng + "&page=0");
                    }

                    updateLinks($("#latitude").val(), $("#longitude").val());

                    // Marker sürüklenince linkleri güncelle
                    marker.on('dragend', function (evt) {
                        var newLat = evt.target.getLatLng().lat;
                        var newLng = evt.target.getLatLng().lng;

                        $("#latitude").val(newLat);
                        $("#longitude").val(newLng);

                        updateLinks(newLat, newLng);

                        //var map_img_url = "https://maps.googleapis.com/maps/api/staticmap?center=" + newLat + "," + newLng + "&zoom=17&size=400x300&sensor=false&key=AIzaSyCMXHBMVNzhN_gmq828ISUjzmyfLIq97qU";
                        //$("#mapsImgSrc").val(map_img_url);
                    });

                    // Kullanıcı profil fotoğraflı custom marker'lar
                    $(".SearchLocationItem").each(function (index) {
                        if (index > 25) return false; // 25'ten fazlasını ekleme

                        var img = $(this).children(".LocationProfilImg").val();
                        if (img.match(/man/) != null) return; // Varsayılan erkek görseli olanları atla

                        var itemLat = parseFloat($(this).children(".LocationLat").val());
                        var itemLng = parseFloat($(this).children(".LocationLong").val());
                        var memberId = $(this).children(".LocationMemberId").val();
                        var link = window.location.origin + "/Profil/Profil?member_id=" + memberId;

                        // Profil fotoğraflı custom icon
                        var customIcon = L.divIcon({
                            className: 'customMarker',
                            html: '<a href="' + link + '"><img src="' + img + '" /></a>',
                            iconSize: [40, 40],      // İkonun boyutunu ayarla
                            iconAnchor: [20, 40]     // İkonun konuma göre hizalanması
                        });

                        L.marker([itemLat, itemLng], { icon: customIcon }).addTo(map);
                    });
                });
            } else {
                alert('Tarayıcınız bu özelliği desteklemiyor.');
            }
        });
    </script>
</div>



