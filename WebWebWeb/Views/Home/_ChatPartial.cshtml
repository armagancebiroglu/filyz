
<div class="Chat-wrapper">
    <input type="hidden" value="@ViewBag.result" id="ChatResult" /><!--querystring ViewBag.result = Request.QueryString["chat"].ToString();-->   
    <div class="chat-container">
        <!-- Top bar -->
        <div class="top-bar">
            <div class="brand">Canlı Sohbet</div>
        </div>
        @Html.Action("ChatList", "Home")
        <!-- Chat header -->
        <div class="chat-header">
            <div id="ChatHeader"></div>@Html.Action("ChatNickName", "Home")
        </div>
        <!-- Messages -->
        <div class="messages-area" id="messagesArea">
        </div>

        <!-- Input -->
        <div class="message-input-area" id="messagesArea">
            <div class="message-input-wrapper">
                <div class="input-group">
                    <input type="text" class="comment-input message-textarea" id="messageInput" placeholder="Mesajınızı yazın..." />
                    <button class="send-btn btn btn-send px-3" id="sendmessage">Gönder</button>
                </div>

            </div>
        </div>
    </div>

    <div class="empty80"></div>
</div>