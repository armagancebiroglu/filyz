
@model WebWebWeb.Models.ShareObject
<style>
 
   canvas{
       z-index:-1;
   }
   #ShareObjectPanaromaText{
       position:relative;
        display: inline-block;
       z-index:1040;
   }
</style>


<div class="ShareMaterialheaderContent" id="ShareMaterialheaderContent">
    @using (Html.BeginForm("ShareSpace", "Home", new { sort = 1 }, FormMethod.Post, new { enctype = "multipart/form-data"}))
    {//image180
        @Html.AntiForgeryToken()
        try
        {            
        <div class="ShareStreemObjectWrapper">
            <div class="shareLocationItemHeader">
                <div class="ShareLocationIco">
                    <label for="ShareObjectPanaromaFileUpload"><i class="glyphicon glyphicon-picture"></i></label><div>180° Fotoğraf Seç</div>
                    <input id="ShareObjectPanaromaFileUpload" class="custom-file-upload" name="file" type="file" accept="image/*" capture="camera" />
                </div>
            </div>
            <div class="shareStreemContent">
                <!--içerik başlangıç-->
                <div class="ShareObjectWrapper">
                    <div class="ShareObjectFrame" id="ShareObjectFrame">
                        <img id="ShareObjectPanaromaPreview" style="width:auto; height:auto; display:none;" />
                        <br />
                    </div>                  
                </div>
                <!--içerik bitiş-->
            </div>
            <div class="shareStreemFooterElementWrapper">
                <div class="ShareObjectTextWrp">
                    <div class="ShareObjectText">
                        @Html.TextAreaFor(mbox => mbox.text, new { @id = "ShareObjectPanaromaText", @class = "ShareTextInput", rows = "10", Placeholder = "...yazın (*1500 karakter)" })
                    </div>
                    <div class="ShareObjectSend">
                        <label for="ShareObjectPanaromaBtn"><i class="glyphicon glyphicon-send"></i></label>
                        <input id="ShareObjectPanaromaBtn" type="submit" value="Kaydet" class="ButtonHiden" />
                    </div>                   
                </div>
            </div>
        </div>        
                <!--içerik bitiş-->


        <script src=" ~/Scripts/180Viewer.js"></script>
                <script type="text/javascript">
                    $(Document).ready(function () {
                        $('#ShareObjectPanaromaFileUpload').change(function (event) {

                            $('#ShareObjectFrame').contents().remove();
                            $('#ShareObjectFrame').html('<img id="ShareObjectPanaromaPreview" src="#" style="display:none; width:auto; height:auto;" />');
                            $(File).each(function (e) {
                                if (e != this) {
                                    $(this).val('');
                                }
                            });
                            var Uri = URL.createObjectURL(event.target.files[0]);
                            $("#ShareObjectPanaromaPreview").attr('src', Uri);
                            var W_H = 0;
                            var img = document.getElementById("ShareObjectPanaromaPreview");
                            img.onload = function (e) {
                                W_H = img.naturalWidth / img.naturalHeight;
                                if (W_H >= 4) {
                                    W_H = 6.3;
                                }
                                var container_id = 'ShareObjectFrame';
                                var modalAlb = 'content';
                                screen180View(W_H, container_id, modalAlb, Uri); 
                            }
                           
                        });
                    });
                </script>
        }
        catch
        {
            if (!Response.IsRequestBeingRedirected)
            { Response.Redirect(Url.Action("Home", "Home")); }
        }
    }
</div>
<div class="ShareObjectDetailsFooterEmpty">&nbsp;</div>