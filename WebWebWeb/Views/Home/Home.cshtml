
@{
                /**/

                ViewBag.Title = "Home";
                Layout = "~/Views/Shared/_LayoutP.cshtml";
}

@try
{
<div class="SSContainer">
    <div class="topMargin">&nbsp;</div><br/><br/><br />
    <div class="col-12 favoriListWrepper">
        <div class="HomeFavori">
            <a href="@Url.Action("ShareRouter", "Home")"><span class="fa fa-paper-plane"></span></a>
            @Html.Action("FavoriteMyList", "MyProfil")
        </div>
    </div>

    @*<div class="LayoutRenderBody" id="LayoutRenderBody">*@
    <div class="" id="refresh">
        @Html.Action("ShareStreemHome", "Home", new { page = 0 })
    </div>
    @*</div>*@

    <div class="empty80">&nbsp;</div>
</div>
  
}
catch (Exception)
{
    Response.Redirect(Url.Action("Info", "Default"));
}
<script type="text/javascript">
    $(document).ready(function () {       
        var page = 0;
        var _inCallback = false;
        var hasMoreData = true;

        function loadNotice() {
            if (!hasMoreData || _inCallback) return;

            _inCallback = true;

            $.get("/Home/ShareStreemHome", { page: page + 1 })
                .done(function (data) {
                    if (data && data.trim().length > 0) {
                        $("#refresh").append(data);
                        page++;
                    } else {
                        hasMoreData = false;
                    }
                })
                .fail(function () {
                    console.log("Sayfalama hatası");
                })
                .always(function () {
                    _inCallback = false;
                });
        }

        $(window).scroll(function () {
            if ($(window).scrollTop() >= $(document).height() - $(window).height() - 100) {
                loadNotice();
            }
        });
    });
</script>





