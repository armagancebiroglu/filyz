
@{
    ViewBag.Title = "Settings";
    Layout = "~/Views/Shared/_LayoutP.cshtml";
}
<div class="container">
    <br />
    <br />
    <br />
    <div class="modalAlb fade" id="mymodalAlb" role="dialog">
        <div class="modalAlb-dialog">

            <!-- modalAlb content-->
            <div class="modalAlb-content">
                <div class="modalAlb-header">
                    <button type="button" class="close" data-dismiss="modalAlb">&times;</button>
                </div>
                <div class="modalAlb-body">
                    <p id="Note"> </p>
                </div>
                <div class="modalAlb-footer">
                    <div class="SettingmodalAlbFooterCenter"> *Tüm silme işlemleri geri döndürülemez üzere silinir. Kesinlikle yedek veri saklanmaz.</div>
                    <div class="SettingmodalAlbFooterCenter">Emin Misiniz?</div>
                    <input type="button" id="btn" class="hidden" />
                    <label for="btn" class="SettingOk"> Sil</label><!--  -->
                    <label class="SettingCancel" data-dismiss="modalAlb"> İptal</label>
                </div>
            </div>

        </div>
    </div>
    <div class="SettingContent">
        <div class="SettingCaption">Hesap Ayarları</div>
        @if (ViewBag.query == "ok")
        {
            <div class="SettingDeleted">*Silme İşlemi Gerçekleşti</div>
        }
            <ul>
                <li id="1">Tüm Paylaşımlarımı Sil</li>
                <li id="2">Tüm Yorumlarımı Sil</li>
                <li id="3">Tüm Paylaşımlarıma Yapılan Yorumların Hepsini Sil</li>
                <li id="4">Tüm Anketlere Verdiğim Bütün Cevaplarımı Sil</li>
                <li id="5">Düzenlediğim Tüm Anketleri Sil</li>
                <li id="6">Tüm Anketlerime Verilen Cevapların Hepsini Sil</li>
                <li id="7">Tüm Paylaşımlarımın Beğenilerini Sil</li>
                <li id="8">Albümümdeki Tüm Görsellerin Beğenilerini Sil</li>
                <li id="9">Tüm Paylaşım Beğenmelerimi Sil</li>
                <li id="10">Tüm Albüm Beğenmelerimi Sil</li>
                <li id="11">Tüm Gülümsemelerimi Sil</li>
                <li id="12">Bana Gülümsemelerin Tümünü Sil</li>
                <li id="13">Favorilerim Listesini Sil</li>
                <li id="14">Beni Tüm Favori Listelerinden Kaldır</li>
                <li id="15">Gönderdiğim Tüm Mesajları Sil</li>
                <li id="16">Bana Yazılan Tüm Mesajları Sil</li>
                <li id="17">Profil Sayfası Görüntüleme Listemi Sil</li>
                <li id="18">Adayların Profil Sayfası Görüntüleme Listelerinden Beni Kaldır</li>
                <li>HESABIMI TAMAMEN SİL</li> @*id="19"*@
            </ul>
    </div>
</div>
<script>
    $(document).ready(function () {
        $("li").click(function () {
            $("#mymodalAlb").modalAlb({
                show: 'true',
                backdrop: 'static'
            });
            $("#Note").text($(this).text());           
            var query = $(this).attr("id");
            $("#btn").click(function () {
                window.location.href = "/Home/Settings?query=" + query;
            });            
        }); 

        $(".SettingDeleted").fadeOut(4000);
    });
</script>


