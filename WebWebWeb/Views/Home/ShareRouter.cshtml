
@{
    //Layout = null;
    Layout = "~/Views/Shared/_LayoutP.cshtml";
}
@model WebWebWeb.Models.ShareObject
  
    <div class="SSContainer">
        <div class="empty80">&nbsp;</div>
        <!-- Başlık -->
        <div class="page-title">
            <h1>Ne paylaşmak istersiniz?</h1>
            <p>Fotoğraf, video, ses veya konumunu paylaş</p>
        </div>
        <!--tabs baslangic-->   
        <div class="tabs-container">
            <button class="tab-btn active" data-tab="image">
                <i class="fas fa-image"></i>
                <span>Fotoğraf</span>
            </button>        
            <button class="tab-btn" data-tab="video">
                <i class="fas fa-video"></i>
                <span>Video</span>
            </button>
            <button class="tab-btn" data-tab="audio">
                <i class="fas fa-microphone-alt"></i>
                <span>Ses</span>
            </button>
            <button class="tab-btn" data-tab="location">
                <i class="fas fa-map-marker-alt"></i>
                <span>Konum</span>
            </button>
        </div>
        <!--tabs bitis-->       
            <div id="image" class="tab-content visible">@Html.Action("ShareObject", "Home")</div> 
            <div id="video" class="tab-content">@Html.Action("ShareVideo", "Home")</div>
            <div id="audio" class="tab-content">@Html.Action("ShareAudio", "Home")</div>
            <div id="location" class="tab-content">@Html.Action("ShareLocation", "Home")</div>    
    <div class="emptyBottom">&nbsp;</div>
    </div>  
    <script type="text/javascript">
        $(document).ready(function () {
            $(".tab-btn").click(function () {
                // 1. Tıklanan butonun data-tab değerini al
                var targetId = $(this).attr("data-tab");

                // 2. Tüm butonlardan "active" sınıfını kaldır ve tıklanana ekle
                $(".tab-btn").removeClass("active");
                $(this).addClass("active");

                // 3. Tüm tab içeriklerini gizle ve sadece ilgili olanı göster
                // (Varsayım: İçerik panellerinin class'ı .tab-content ve id'leri data-tab ile eşleşiyor)
                $(".tab-content").hide();
                $("#" + targetId).fadeIn(); // veya .show()
            });
        });
    </script>

