
@{
    ViewBag.Title = "NoticePage";
    Layout = "~/Views/Shared/_LayoutP.cshtml";
}

<script type="text/javascript">
    $(document).ready(function () {
        var page = 0;
        var _inCallback = false;

        function loadNotice() {
            if (page > -1 && !_inCallback) {
                _inCallback = true;
                page++; 

                $('div#loading').html('<p><img src="/Images/loading.gif"></p>');

                $.get("/Home/NoticePageList?page=" + page , function (data) {
                    if (data != '') {
                        $("#NoticeList").append(data);
                    }
                    else {
                        page = -1;
                    }

                    _inCallback = false;
                    $('div#loading').empty();
                });
            }
        }
        var dcList = true;
        $(window).scroll(function () {
            if ($(window).scrollTop() == $(document).height() - $(window).height()) {
                loadNotice();
            }
        });
    });
</script>
<div class="SSContainer">
    <div class="topMargin">&nbsp;</div>
     <div class="page-wrap">
         <div class="glass-card">
             <ul class="NoticeList" id="NoticeList">
                 @Html.Action("NoticePageList", "Home", new { page = 0 })
             </ul>
         </div>
     </div> 
    <div class="empty80">&nbsp;</div>
</div>

