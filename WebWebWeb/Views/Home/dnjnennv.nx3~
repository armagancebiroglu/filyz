
@model WebWebWeb.Models.Location
<style>
    .modal-backdrop {
        z-index: -1;
    }
    #ShareLocationFrame{
        position:relative;
        width:100vw;
        max-width:1200px;
        height:65vh;
    }
</style>
@*<a class="glyphicon glyphicon-map-marker" data-toggle="modal" data-target="#SharedLocationModal"></a>*@

<div class="ShareMaterialheaderContent">
    @using (Html.BeginForm("ShareLocation", "Home", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <h4 class="modal-title">Bulunduğunuz Konumu Paylaşın</h4>
        <div class="ShareObjectText">
            @Html.TextAreaFor(mbox => mbox.text, new { @id = "ShareLocationText", @class = "ShareTextInput", rows = "10", Placeholder = "...yazın" })
        </div>

        <div class="ShareMaterialfooter">
           
            <label for="ShareLocationShowBtn" class="custom-button floatLeft">
                <i class="glyphicon glyphicon-map-marker"></i> Konumu Göster
            </label>
            <input id="ShareLocationShowBtn" onclick="ShareLocationShowBtnclick()" type="button" value="Göster" class="ButtonHiden" />

            <div class="ShareButton">
                <label for="ShareLocationBtn" class="custom-button">
                    <i class="glyphicon glyphicon-send"></i> Paylaş
                </label>
                <input id="ShareLocationBtn" type="submit" value="Paylaş" class="ButtonHiden" />
            </div>
            @Html.Hidden("latitude")
            @Html.Hidden("longitude")
            @Html.Hidden("mapsImgSrc")
           
        </div>
                <!--içerik başlangıç-->
        <div class="ShareObjectWrapper">
            <div class="ShareObjectFrame" id="ShareLocationFrame"></div>
            <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDRvyo2G67AXoYSxpYa8JDW6aMMkLhuU1g&callback=ShareLocationShowBtnclick"></script>
           @*key buradan alınacak https://developers.google.com/maps/documentation/javascript/?refresh=1*@

            <!--içerik bitiş-->


            <script type="text/javascript">
                $(document).ready(function () {
                 
                    $("#ShareLocationShowBtn").click(function ShareLocationShowBtnclick() {

                         if (navigator.geolocation) {
                            navigator.geolocation.getCurrentPosition(function (position) {
                                var lat = position.coords.latitude;
                                var lang = position.coords.longitude;
                                $("#latitude").val(lat);
                                $("#longitude").val(lang);
                                var map_img_url = "https://maps.googleapis.com/maps/api/staticmap?center=" + position.coords.latitude + "," + position.coords.longitude + "&zoom=14&size=400x300&sensor=false&key=AIzaSyDRvyo2G67AXoYSxpYa8JDW6aMMkLhuU1g";
                                $("#mapsImgSrc").val(map_img_url);

                                var mapOptions = {
                                    center: new google.maps.LatLng(position.coords.latitude, position.coords.longitude),
                                    zoom: 18,
                                    mapTypeId: google.maps.MapTypeId.ROADMAP
                                }

                                var map = new google.maps.Map(document.getElementById("ShareLocationFrame"), mapOptions);

                                var marker = new google.maps.Marker({
                                    position: map.getCenter(),
                                    map: map,
                                    draggable: true,
                                    title: 'Sen Buradasın!'
                                });

                            });
                        } else {
                            alert('Tarayıcınız bu özelliği desteklemiyor.');
                        }

                    });
                });
            </script>
        </div>
    }
</div>

