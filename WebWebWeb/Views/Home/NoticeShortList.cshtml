@model List<WebWebWeb.Models.NoticeListItem>



@try
{
    <div class="dropdown">
        <div class="notification-wrapper" data-bs-toggle="dropdown" aria-expanded="false">
            @*id="menu1"*@
            <span class="fa fa-bell notification-icon"></span>
            <span class="notification-badge">@ViewBag.count_</span>
        </div>
        <div class="dropdown-menu dropdown-menu-end notification-dropdown">
            <div class="notification-header">Bildirimler</div>

            @foreach (var NoticeListItem in Model)
            {
                if (NoticeListItem.active)
                {

                    <div class="notification-item">
                        <a href="@Url.Action("NoticePassiveAndDistribution", "Home", new { id_ = NoticeListItem.id, obje_id_ = NoticeListItem.obje_id, who_id_ = NoticeListItem.who_id, sort_ = NoticeListItem.sort, noticeTableSort_ = NoticeListItem.noticeTableSort, active_ = NoticeListItem.active })">
                            <img src="@NoticeListItem.profil_media" class="img-circle" width="36" height="36" style=" box-shadow:0px 5px 5px grey" />
                            <div>@NoticeListItem.nick_name</div>
                            <div class="title">
                                @NoticeListItem.text
                            </div>
                            <div class="time">
                                @NoticeListItem.date.Day @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(NoticeListItem.date.Month)&nbsp;&nbsp;<span class="glyphicon glyphicon-time"></span> @NoticeListItem.date.Hour.ToString() :@NoticeListItem.date.Minute.ToString()
                            </div>
                        </a>
                    </div>
                }
                else
                {
                    <div class="notification-item">
                        <a href="@Url.Action("NoticePassiveAndDistribution", "Home", new { id_ = NoticeListItem.id, obje_id_ = NoticeListItem.obje_id, who_id_ = NoticeListItem.who_id, sort_ = NoticeListItem.sort, noticeTableSort_ = NoticeListItem.noticeTableSort, active_ = NoticeListItem.active })">
                            <img src="@NoticeListItem.profil_media" class="img-circle" width="36" height="36" style=" box-shadow:0px 5px 5px grey" />
                            <div>@NoticeListItem.nick_name</div>
                            <div class="title" style="color:#C0C0C0;">
                                @NoticeListItem.text
                            </div>
                            <div class="time">
                                @NoticeListItem.date.Day @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(NoticeListItem.date.Month)&nbsp;&nbsp;<span class="glyphicon glyphicon-time"></span> @NoticeListItem.date.Hour.ToString() :@NoticeListItem.date.Minute.ToString()
                            </div>
                        </a>
                    </div>
                }
            }
            <a href="@Url.Action("NoticePage", "Home")">
                <div class="notification-header">
                    <span class="fa fa-list"></span> tümünü gör
                </div>
            </a>
        </div>
    </div>
}
catch
{
    if (!Response.IsRequestBeingRedirected)
    { Response.Redirect(Url.Action("Info", "Default")); }
}

