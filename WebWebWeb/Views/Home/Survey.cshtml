
@{
    ViewBag.Title = "Survey";
    Layout = "~/Views/Shared/_LayoutP.cshtml";
}
<div class="Container">
    <div class="topMargin">&nbsp;</div>
    <div class="page-wrap">
        <div class="glass-card">

            @try
            {
                <div class="section-header">
                    <i class="fa fa-pencil-square" style="color: var(--main-color); font-size: 18px;"></i>
                    <div class="Ssection-title">Önemli anketler</div>                   
                </div>
                @Html.Action("SurveyForced", "Home")
             
                <div class="section-header">
                    <i class="fa fa-pencil-square" style="color: var(--main-color); font-size: 18px;"></i>
                    <div class="Ssection-title">Seçmeli anketler</div>                 
                </div>
                @Html.Action("SurveySelective", "Home")

            }
            catch
            {
                if (!Response.IsRequestBeingRedirected)
                { Response.Redirect(Url.Action("Home", "Home")); }
            }
        </div>
    </div>
    <div class="empty80">&nbsp;</div>
</div>
