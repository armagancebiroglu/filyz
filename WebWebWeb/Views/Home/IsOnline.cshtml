
<div id="OnlineDrop" class="status-ico">   
   
        @if (!string.IsNullOrEmpty(Session["is_online"].ToString()))
        {
            if (Convert.ToBoolean(Session["is_online"]))
            {
                @Ajax.ActionLink(" ", "IsOnline", new { bool_ = 0 }, new AjaxOptions { UpdateTargetId = "OnlineDrop", InsertionMode = InsertionMode.Replace, OnComplete = "offline()" }, new { id = "offline_link", @class = "fa fa-circle", style="color:var(--online);" })
            }
            else
            {
                @Ajax.ActionLink(" ", "IsOnline", new { bool_ = 1 }, new AjaxOptions { UpdateTargetId = "OnlineDrop", InsertionMode = InsertionMode.Replace, OnComplete = "online()" }, new { id = "online_link", @class = "fa fa-circle", style ="color:var(--offline);" })

           }
        }
        else
        {
                    Response.Redirect(Url.Action("Info", "Default"));
                }
</div>

  

