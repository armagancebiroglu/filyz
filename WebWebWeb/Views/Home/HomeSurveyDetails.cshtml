
@{
    ViewBag.Title = "HomeSurveyDetails";
    Layout = "~/Views/Shared/_LayoutP.cshtml";
}
@model WebWebWeb.Models.ShareObject

<div class="SSContainer">
    <div class="empty80">&nbsp;</div>
    <div class="page-wrap">
        @try
        {
            <div class="glass-card glass">
                <div class="SurveyDetailsCaption">
                    <br />
                    <span class="fa fa-quote-left"></span>&nbsp;&nbsp; @Model.text &nbsp;&nbsp;<span class="fa fa-quote-right"></span>
                </div>
                @Html.Action("HomeSurveyAnswer", "Home", new { survey_id = Model.id })
            </div>
        }
        catch
        {
            if (!Response.IsRequestBeingRedirected)
            { Response.Redirect(Url.Action("Home", "Home")); }
        }
    </div>
    <div class="surveybtn"><span class="fa fa-id-card"></span>@Ajax.ActionLink("Kiminle uyumsun gör.", "HomeSurveyMember", "Home", new { survey_id = ViewBag.survey_id, page = 0, SurveyGetEvent = "Get" }, new AjaxOptions { UpdateTargetId = "refresh", InsertionMode = InsertionMode.Replace }, new { id = "btnGET" })</div>
    <br />
    <div class="SurveyHomeMemberListWrp" id="refresh">
        @Html.Action("HomeSurveyMember", "Home", new { survey_id = Model.id, page = 0 })
    </div>
    <div class="empty80"> &nbsp;</div>

</div>

<script type="text/javascript">

    $(document).ready(function () {
        var page = 0;
        var _inCallback = false;

        function loadNotice() {
            if (page > -1 && !_inCallback) {
                _inCallback = true;
                page++;
                $('div#loading').html('<p><img src="/Images/loading.gif"></p>');                
                $.get("/Home/HomeSurveyMember?survey_id=" + $("#survey_id").val() + "&page=" + page, function (data) {
                    if (data != '') {
                        $("#refresh").append(data);
                    }
                    else {
                        page = -1;
                    }

                    _inCallback = false;
                    $('div#loading').empty();
                });
            }
        }
        var dcList = true;

        $(window).scroll(function () {
           
            if ($(window).scrollTop() == $(document).height() - $(window).height()) {               
                loadNotice();
            }
        });
        $("#btnGET").click(function () {
            page = 0;
        });
    });
</script>
