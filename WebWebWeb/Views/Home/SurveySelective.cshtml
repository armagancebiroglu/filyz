

@try
{
    if (ViewBag.count != 0)
    {
        foreach (var survey in ViewBag.SurveyList)
        {
            <div class="survey-item draft" style="animation-delay:0.7s">
                <!-- Başlık -->
                <div class="survey-header">
                    <div class="survey-quote" style="text-transform:lowercase;">
                        <i class="fa fa-quote-left"></i>
                        <div style="text-transform: capitalize !important;"> <a href="@Url.Action("HomeSurveyDetails", "Home", new { survey_id = survey.id })" style=" text-decoration:none;"> @survey.text</a> </div>
                        <i class="fa fa-quote-right"></i>
                    </div>
                </div>
                @if (survey.answerCount < survey.questionCount)
                {
                    <div style="font-size:11px;color:var(--draft-text);margin:8px 0 4px;font-style:italic;opacity:.75;">
                        <i class="fa fa-info-circle" aria-hidden="true"></i> * Tüm soruları cevaplamadınız
                        <div class="section-badge" style="width:30px; padding:0; text-align:center;"> @survey.answerCount/@survey.questionCount</div>
                    </div>
                }
                else
                {
                    <div style="font-size:11px;color:var(--draft-text);margin:8px 0 4px;font-style:italic;opacity:.75;">
                        <i class="fa fa-info-circle" aria-hidden="true"></i>  Soruları cevapladınız
                        <div class="section-badge" style="width:30px; padding:0; text-align:center;"> @survey.answerCount/@survey.questionCount</div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-message"><i class="fa fa-folder-open" aria-hidden="true"></i> henüz katlmadığınız anket yok</div>
    }
}
catch
{
    if (!Response.IsRequestBeingRedirected)
    { Response.Redirect(Url.Action("Home", "Home")); }
}
