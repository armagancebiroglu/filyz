
@{
    ViewBag.Title = "Datails";
    Layout = "~/Views/Shared/_LayoutP.cshtml";
}

@model WebWebWeb.Models.shareStreem

<!DOCTYPE html>
<html>
<head>
    <title>paylaşım detayı</title>
</head>
<body>
    <div class="SSContainer">
        <div class="empty80">&nbsp;</div>

        @try
        {
            if (Model != null)
            {
                <div class="card post-card">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="HomeFavoriItem">
                                @if (Convert.ToInt32(Model.member_isonline) == 0)
                                {<span id="is_online" class="fa fa-circle un-selected"></span> }
                                else
                                { <span id="is_online" class="fa fa-circle active-color"></span>}
                                <figure>
                                    <a href="@Url.Action("Profil", "Profil", new { member_id = Model.member_id })">
                                        <img src="@Model.member_profil_media" class="img-circle" />
                                    </a>
                                </figure>
                            </div>
                            <div class="SharePostCardInside">
                                @if (Model.member_nick_name != null)
                                {
                                    //int year = DateTime.Now.Year - shareStreemObje.member_age.Year;
                                    <div class="post-author">@Model.member_nick_name </div>
                                }
                                @if (Model.member_age != null)
                                {
                                    int year = DateTime.Now.Year - Model.member_age.Year;
                                    <div class="postInfo">yaş: @year </div>
                                }
                                @if (Model.member_city != null)
                                {
                                    <div class="postInfo">şehir: @Model.member_city</div>
                                }

                                <div class="post-time">@Model.date.Day @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.date.Month)</div><br />
                                <div class="post-time"><span class="fa fa-clock-o"></span> @Model.date.Hour.ToString() :@Model.date.Minute.ToString()</div>
                            </div>
                        </div>
                        <div class="shareStreemContent">
                            @if (!string.IsNullOrEmpty(Model.image_url))
                            {
                                if (Model.sort == 0)
                                {
                                    <img src="@Model.image_url" class="post-img mb-3" />
                                    <div class="post-text"> @Model.text</div>
                                }
                                else if (Model.sort == 4)
                                {
                                    string videoid = "video" + Model.number.ToString();

                                    <div class="post-img mb-3">
                                        <video id="@videoid" src="@Model.image_url" style="width:100%;" controls="controls">
                                            <source src="@Model.image_url" type="video/mp4" />
                                            <source src="@Model.image_url" type="video/ogg" />
                                            <source src="@Model.image_url" type="video/webm" />
                                            İnternet tarayıcınız eski sürüm olduğundan bu videoyu oynatamıyor.
                                        </video>
                                        <script type="text/javascript">
                                                    $(document).ready(function () {
                                                        var myVideo = document.getElementById(@videoid);
                                                        function playPaus() {
                                                            if (myVideo.paused) {myVideo.play();}
                                                            else { myVideo.pause();}
                                                        }
                                                    });

                                        </script>
                                    </div>
                                    <div class="post-text">@Model.text</div>
                                }
                                else if (Model.sort == 8)
                                {

                                    <div class="post-img mb-3">
                                        <audio id="audio" style="width:100%;" controls="controls">
                                            <source src="@Model.image_url" type="audio/mpeg" />
                                            <source src="@Model.image_url" type="audio/mp3" />
                                            <source src="@Model.image_url" type="audio/ogg" />
                                            İnternet tarayıcınız eski sürüm olduğundan bu ses kaydını oynatamıyor.
                                        </audio>
                                    </div>
                                    <div class="post-text"> @Model.text</div>
                                }
                                else if (Model.sort == 16)
                                {
                                    <div class="post-img mb-3">
                                        <img src="@Model.image_url" class="post-img mb-3" />
                                    </div>
                                    <div class="post-text"> @Model.text</div>
                                }
                                else if (Model.sort == 32)
                                {
                                    <div class="Surveycard">
                                        <div class="post-img mb-3">
                                            <div class="shareStreemSurveyIcon">
                                                <div class="survey-icon-circle">
                                                    <a href="@Url.Action("ProfilSurveyDetails", "Profil", new { survey_id = Model.id, whom_id = Model.member_id })"> <i class="fa fa-file-text" aria-hidden="true"></i></a>
                                                </div>
                                            </div>
                                            <div class="shareStreemSurveyFooter">
                                                <div>
                                                    <i class="fa fa-pencil" aria-hidden="true"></i>
                                                    <div class="shareStreemSurvey-post-text"> @Model.text </div>
                                                </div>
                                                <div></div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    Response.Redirect(Url.Action("Info", "Default"));
                                }

                            }
                        </div>
                        <div class="actionWr d-flex align-items-center gap-2 mb-3">

                            <div class="actionW">
                                @Html.Action("NoticeEventHeart", "Home", new { obje_id = Model.id, sort = Model.sort, whom_id = Model.member_id, noticeTableSort = 0 })
                            </div>
                            <div class="actionW">
                                @Html.Action("TagCheck", "Profil", new { whom_id = Model.member_id, obje_id = Model.id, @class = "fa fa-tags" })
                            </div>
                            <div class="flex-grow-1"></div>
                            <div class="actionW">
                                @Html.Action("Complaint", "Home", new { obje_id = Model.id, sort = Model.sort, whom_id = Model.member_id, noticeTableSort = 0 })
                            </div>
                        </div>
                        @Html.Action("Comment", "Home", new { obje_id = Model.id, sort = Model.sort, whom_id = Model.member_id, noticeTableSort = 0 })
                    </div>
                </div>
            }
            else
            {
                Response.Redirect(Url.Action("Info", "Default"));
            }
        }
        catch
        {
            if (!Response.IsRequestBeingRedirected)
            { Response.Redirect(Url.Action("Home", "Home")); }
        }
    </div>
    <div class="empty80">&nbsp;</div>
    <script type="text/javascript">
        $(Document).ready(function () {

            $(".TagDeleteTrigger").click(function () {
                $(this).parent().parent().parent().children(".DeleteShareSliderMyProfil").stop(true).slideDown("slow");
            });
            $(".TagDeleteClose").click(function () {
                //$(this).parent().parent().stop(true).slideUp("slow");
                closeSlide();
            });
            function closeSlide() {
                //$(this).parent().parent().stop(true).slideUp("slow");
                $(".DeleteShareSliderMyProfil").stop(true).slideUp("slow");
            }
        });
    </script>
</body>
</html>
