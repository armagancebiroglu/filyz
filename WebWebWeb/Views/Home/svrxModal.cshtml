@model WebWebWeb.Models.ShareObject

@try
{
    if (Model != null)
    {
        string txtArea = "txtArea" + Model.id;
        string Btn = "Btn" + Model.id;
        string TargetDiv = "TargetDiv" + Model.id;
       
            using (Ajax.BeginForm("svrxmodal", "Home", new { modal_id = Model.id, svrxmodal = "modal" }, new AjaxOptions { UpdateTargetId = TargetDiv, HttpMethod = "POST", InsertionMode = InsertionMode.Replace }))
            {
                <div id="@TargetDiv">
                    @if (ViewBag.result == 0)
                    {
                        @Html.AntiForgeryToken()      
                        <!-- Metin Alanı baslangic-->
                    <div class="text-section">                      
                        @Html.TextArea("Text", Model.text, new { @id = txtArea, @class = "share-textarea", rows = "5" })       
                        * bu yayını tekrar paylaşabilirsin.
                    </div>
                        <!-- Metin Alanı bitis-->
                        <!-- Gönder Butonu baslangic-->
                        <div class="send-section">
                            <button class="send-btn"  id="@Btn">
                                <i class="fas fa fa-paper-plane"></i>
                                Paylaş
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="">Paylaşıldı.</div>
                    }
                </div>
            }
       
    }
}
catch
{
    if (!Response.IsRequestBeingRedirected)
    { Response.Redirect(Url.Action("svrx", "Home")); }
}
