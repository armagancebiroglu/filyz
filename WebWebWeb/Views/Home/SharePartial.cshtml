
@model List<WebWebWeb.Models.ShareObject>
<div id="refresh">
    @try
    {
        if (Model != null)
        {
            foreach (var shareObje in Model)
            {
                string Sharemodal = "modal" + shareObje.id;
                string TargetDiv = "TargetDiv" + shareObje.id;
                <div class="card post-card">
                    <div class="card-body">
                        <div class="shareStreemContent">


                            @try
                            {
                                if (!string.IsNullOrEmpty(shareObje.image_url))
                                {
                                    if (shareObje.sort == 0)
                                    {
                                        <img src="@shareObje.image_url" class="post-img" />
                                        <div class="post-text"> @shareObje.text</div>
                                    }
                                    else
                                    {

                                        if (shareObje.sort == 4)
                                        {
                                            string videoid = "video" + shareObje.id.ToString();
                                            <div class="post-img">
                                                <video id="@videoid" src="@shareObje.image_url" style="width:100%;" controls="controls">
                                                    <source src="@shareObje.image_url" type="video/mp4" />
                                                    <source src="@shareObje.image_url" type="video/ogg" />
                                                    <source src="@shareObje.image_url" type="video/webm" />
                                                    İnternet tarayıcınız eski sürüm olduğundan bu videoyu oynatamıyor.
                                                </video>
                                                <script type="text/javascript">
                                                    $(document).ready(function () {
                                                        var myVideo = document.getElementById(@videoid);
                                                        function playPaus() {
                                                            if (myVideo.paused) {myVideo.play();}
                                                            else { myVideo.pause();}
                                                        }
                                                    });
                                                </script>
                                            </div>
                                            <div class="post-text">@shareObje.text</div>

                                        }
                                        else
                                        {
                                            if (shareObje.sort == 8)
                                            {
                                                <div class="post-img">
                                                    <audio id="audio" style="width:100%;" controls="controls">
                                                        <source src="@shareObje.image_url" type="audio/mpeg" />
                                                        <source src="@shareObje.image_url" type="audio/mp3" />
                                                        <source src="@shareObje.image_url" type="audio/ogg" />
                                                        İnternet tarayıcınız eski sürüm olduğundan bu ses kaydını oynatamıyor.
                                                    </audio>
                                                </div>
                                                <div class="post-text"> @shareObje.text</div>
                                            }
                                            else
                                            {
                                                if (shareObje.sort == 16)
                                                {
                                                    <div class="post-img">
                                                        <a href="https://www.google.com/maps/dir/?api=1&destination=@shareObje.LATITUDE,@shareObje.LONGITUDE" target="_blank">
                                                            <img src="@shareObje.image_url" class="post-img"/>
                                                        </a>
                                                    </div>
                                                    <div class="post-text"> @shareObje.text</div>
                                                }
                                                else
                                                {
                                                    Response.Redirect(Url.Action("Info", "Default"));
                                                }
                                            }
                                        }
                                    }
                                }
                                else
                                {
                                    Response.Redirect(Url.Action("Info", "Default"));
                                }

                            }
                            catch
                            {
                                Response.Redirect(Url.Action("Info", "Default"));
                            }
                        </div>

                        @if (shareObje.confrim == 0 || shareObje.confrim == 1)
                        {
                            <div class="actionWr d-flex align-items-center gap-2 mb-3">
                                <div class="actionW">
                                    <i class="fa fa-share glyphicon-outlined un-selected" data-bs-toggle="modal" data-bs-target="#@Sharemodal" style="cursor:pointer;"></i>
                                </div>
                                <div class="actionW">

                                </div>
                                <div class="flex-grow-1"></div>
                                <div class="actionW">

                                </div>
                            </div>

                        }
                    </div>
                </div>
                <div class="modal" id="@Sharemodal" role="dialog" style="top:75px; background: rgba(0,0,0,0.18);">
                    <div class="modal-dialog">
                        <div class="modal-content" style="background: rgba(255,255,255,0.58);">
                            <span class="modal-close" data-bs-dismiss="modal">&times;</span>
                            @Html.Action("svrxmodal", "Home", new { modal_id = shareObje.id })
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div> Sonuç Bulunamadı....</div>
        }
    }
    catch
    {
        if (!Response.IsRequestBeingRedirected)
        { Response.Redirect(Url.Action("Home", "Home")); }
    }
    <input type="hidden" id="svrx" value="@ViewBag.svrx" />
    <input type="hidden" id="sort" value="@ViewBag.sort" />
</div>
