
@{
    ViewBag.Title = "svrx";
    Layout = "~/Views/Shared/_LayoutP.cshtml";
}
<div class="SSContainer">
    <div class="topMargin"> &nbsp;</div>
    <!--tabs baslangic-->
    <div class="tabs-container">
        @{
        var sort = Request["sort"] ?? "0";
        }
        <button class="tab-btn @(sort == "0" ? "active" : "")">
            @Html.ActionLink(" ", "svrx", "Home", new { svrx = "sort", sort = 0 }, new { @class = "fas fa-image" })
            <span>Fotoğraf</span>
        </button>
        <button class="tab-btn @(sort == "4" ? "active" : "")">
            @Html.ActionLink(" ", "svrx", "Home", new { svrx = "sort", sort = 4 }, new { @class = "fas fa-video" })
            <span>Video</span>
        </button>
        <button class="tab-btn @(sort == "8" ? "active" : "")">
            @Html.ActionLink(" ", "svrx", "Home", new { svrx = "sort", sort = 8 }, new { @class = "fas fa-microphone-alt" })
            <span>Ses</span>
        </button>
        <button class="tab-btn @(sort == "16" ? "active" : "")">
            @Html.ActionLink(" ", "svrx", "Home", new { svrx = "sort", sort = 16 }, new { @class = "fas fa-map-marker-alt" })
            <span>Konum</span>
        </button>
    </div>
    <!--tabs bitis-->
    <div id="refresh" class="tab-content visible">                  
                @Html.Action("SharePartial", "Home", new { page = 0 })  
    </div>
</div>
<div class="empty80"> &nbsp;</div>
<script type="text/javascript">

    $(document).ready(function () {
        var page = 0;
        var _inCallback = false;

        function loadNotice() {
            if (page > -1 && !_inCallback) {
                _inCallback = true;
                page++;

                var url = "";
                var svrx = $("#svrx").val();

                if (svrx === "") {
                    url = "/Home/SharePartial?page=" + page;
                } else if (svrx === "sort") {
                    url = "/Home/SharePartial?svrx=sort&sort=" + encodeURIComponent($("#sort").val()) + "&page=" + page;
                } else {
                    // Tanımsız svrx değeri — callback kilidini aç, çık
                    _inCallback = false;
                    return;
                }

                $.get(url, function (data) {
                    if ($.trim(data) !== '') {
                        $("#refresh").append(data);
                    } else {
                        page = -1;
                    }
                    _inCallback = false;
                    $('div#loading').empty();
                }).fail(function () {
                    // AJAX hatasında kilidi serbest bırak, sayacı geri al
                    page--;
                    _inCallback = false;
                    $('div#loading').empty();
                    console.error("loadNotice: istek başarısız, page=" + page);
                });
            }
        }

        $(window).on("scroll", function () {
            var scrollTop = $(window).scrollTop();
            var windowHeight = $(window).height();
            var docHeight = $(document).height();

            // Tam dibe ulaşmak yerine 100px kala tetikle (erken yükleme)
            if (scrollTop + windowHeight >= docHeight - 100) {
                loadNotice();
            }
        });
    });
</script>