                <script>
                    function setupRange(minId, maxId, fillId, aId, bId, unit) {
                        const mn = document.getElementById(minId);
                        const mx = document.getElementById(maxId);
                        const fill = document.getElementById(fillId);
                        const a = document.getElementById(aId);
                        const b = document.getElementById(bId);
                        const wrap = fill.parentElement;

                        function update() {
                            let lo = Math.min(parseInt(mn.value), parseInt(mx.value) - 1);
                            let hi = Math.max(parseInt(mx.value), parseInt(mn.value) + 1);
                            mn.value = lo; mx.value = hi;
                            const min = parseInt(mn.min), max = parseInt(mn.max);
                            const pLo = ((lo - min) / (max - min)) * 100;
                            const pHi = ((hi - min) / (max - min)) * 100;
                            fill.style.left = 'calc(6px + ' + pLo + '% * (100% - 12px) / 100)';
                            fill.style.width = 'calc(' + (pHi - pLo) + '% * (100% - 12px) / 100)';
                            a.innerHTML = unit ? lo + ' <small style="font-size:10px;font-weight:400;">' + unit + '</small>' : lo;
                            b.innerHTML = unit ? hi + ' <small style="font-size:10px;font-weight:400;">' + unit + '</small>' : hi;
                            // yaş
                            if (minId === "age-min") {
                                $("#age_from").val(lo);
                                $("#age_to").val(hi);
                            }

                            // boy
                            if (minId === "boy-min") {
                                $("#height_from").val(lo);
                                $("#height_to").val(hi);
                            }

                            // kilo
                            if (minId === "kilo-min") {
                                $("#kilo_from").val(lo);
                                $("#kilo_to").val(hi);
                            }
                        }
                        mn.addEventListener('input', update);
                        mx.addEventListener('input', update);
                        update();
                    }
                    setupRange('age-min', 'age-max', 'age-fill', 'age-a', 'age-b', null);
                    setupRange('boy-min', 'boy-max', 'boy-fill', 'boy-a', 'boy-b', 'cm');
                    setupRange('kilo-min', 'kilo-max', 'kilo-fill', 'kilo-a', 'kilo-b', 'kg');
                </script>
            </div>
