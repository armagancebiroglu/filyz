                    <div class="ql-icon ic-blue"><i class="fa fa-share-alt-square" aria-hidden="true"></i></div>
                    <div class="ql-body">
                        <div class="ql-name">
                            @Ajax.ActionLink("Paylaşım Yapanlar", "CustomSearch", "Home", new { page = 0, searchEvent = "Share" }, new AjaxOptions { UpdateTargetId = "CustomRefresh", HttpMethod = "GET", InsertionMode = InsertionMode.Replace }, new { @class = "" })
                        </div>
                        <div class="ql-desc"> Gönderi paylaşan üyeler</div>
                    </div>
                </div>

                <div class="ql-item">
                    <div class="ql-icon  ic-pink"><i class="fa fa-square-poll-horizontal" aria-hidden="true"></i></div>
                    <div class="ql-body">
                        <div class="ql-name">
                            @Ajax.ActionLink("Anket Yapanlar", "CustomSearch", "Home", new { page = 0, searchEvent = "Survey" }, new AjaxOptions { UpdateTargetId = "CustomRefresh", HttpMethod = "GET", InsertionMode = InsertionMode.Replace }, new { @class = "" })
                        </div>
                        <div class="ql-desc">Aktif anket oluşturanlar</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="customSearchControl">
        <div class="customSearch">
            <div class="Srchmember-grid" id="CustomRefresh">
                    @Html.Action("CustomSearch", "Home", new { page = 0 })                          
            </div>
        </div>
    </div>
    <div class="empty80"> &nbsp;</div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        var page = 0;
        var _inCallback = false;
        var hasMoreData = true;
        var searchEventOld = "";

        function getSearchParams(searchEvent) {
            var params = { searchEvent: searchEvent, page: page };
            if (searchEvent === "Search") {
                $.extend(params, {
                    matiral_status: $("#matiral_status").val(),
                    age_from: $("#age_from").val(),
                    age_to: $("#age_to").val(),
                    educational_status: $("#educational_status").val(),
                    city: $("#city").val(),
                    country: $("#country").val(),
                    hicap: $("#hicap").val(),
                    height_from: $("#height_from").val(),
                    height_to: $("#height_to").val(),
                    kilo_from: $("#kilo_from").val(),
                    kilo_to: $("#kilo_to").val(),
                    hair_color: $("#hair_color").val(),
                    eye_color: $("#eye_color").val(),
                    disable: $("#disable").val()
                });
            }
            return params;
        }

        function loadNotice() {
            if (_inCallback) return;

            var searchEvent = $("#hiddenValue").val();

            if (searchEvent !== searchEventOld) {
                searchEventOld = searchEvent;
                page = 1;
                hasMoreData = true;
            }

            if (!hasMoreData) return;

            _inCallback = true;

            $.get("/Home/CustomSearch", getSearchParams(searchEvent))
                .done(function (data) {
                    if (data && data.trim().length > 0) {
                        $("#CustomRefresh").append(data);
                        page++;
                    } else {
                        hasMoreData = false;
                    }
                })
                .fail(function () {
                    console.log("Sayfalama hatası");
                })
                .always(function () {
                    _inCallback = false;
                });
        }

        $(window).scroll(function () {
            if ($(window).scrollTop() >= $(document).height() - $(window).height() - 100) {
                loadNotice();
            }
        });
     
        ///////////////////////

        $(".tab-btn").click(function () {
            var targetId = $(this).attr("data-tab");
            $(".tab-btn").removeClass("active");
            $(this).addClass("active");
            $(".tab-content").hide();
            $("#" + targetId).fadeIn(); // veya .show()
        });
    });
</script>
