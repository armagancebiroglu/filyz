
@model WebWebWeb.Models.ShareObject

@try
{
<div class="row share-card">
    @using (Html.BeginForm("ShareAudio", "Home", new { sort = 8 }, FormMethod.Post, new { enctype = "multipart/form-data" }))
    {//image
        @Html.AntiForgeryToken()
       
        <!-- Yükleme Alanı baslangic-->
        <div class="upload-section" id="uploadSectionAudio" for="ShareObjectVideoFileUpload">
            <div class="upload-area" id="uploadAreaAudio">
                <div class="upload-icon">
                    <i class="fa fa-volume-up" id="uploadIcon"></i>
                </div>
                <div class="upload-text" id="uploadText">Ses Kaydı Seç</div>
                <div class="upload-hint" id="uploadHint">MP3, WAV, OGG · Max 5MB / 1dk</div>               
                <input id="ShareObjectAudioFileUpload" class="custom-file-upload" name="file" type="file" accept="audio/*" capture="microphone" style="display:none" />
            </div>
        </div>
        <!-- Yükleme Alanı bitis-->
        <!-- Önizleme Alanı baslangic-->
        <div class="preview-section" id="previewSectionAudio">
            <div class="preview-container" id="previewContainerAudio">
                <audio id="audioPreview" controls="controls">
                    <source src="#" type="audio/mpeg" />
                    <source src="#" type="audio/mp3" />
                    <source src="#" type="audio/ogg" />
                    İnternet tarayıcınız eski sürüm olduğundan bu ses kaydını oynatamıyor.
                </audio>
            </div>
        </div>
        <!-- Önizleme Alanı bitis-->
        <!-- Metin Alanı baslangic-->
        <div class="text-section">         
            @Html.TextArea("ShareObjectAudioText", new { @id = "ShareObjectAudioText", @class = "share-textarea", rows = "5", Placeholder = "Paylaşımınıza açıklama ekleyin..." })
            <div class="char-counter">
                <span id="charCountAudio">0</span> / 1500
            </div>
        </div>
        <!-- Metin Alanı bitis-->
        <!-- Gönder Butonu baslangic-->
        <div class="send-section">
            <button class="send-btn" id="ShareObjectAudioBtn" type="submit" value="Kaydet">
                <i class="fas fa fa-paper-plane"></i>
                Paylaş
            </button>           
        </div>
        <!-- Gönder Butonu bitis-->
        <script type="text/javascript">
            $(document).ready(function () {
                const input = document.getElementById("ShareObjectAudioFileUpload");
                const previewContainerAudio = document.getElementById("previewContainerAudio");
                const uploadAreaAudio = document.getElementById('uploadAreaAudio');
                const audioPreview = document.getElementById('audioPreview');
                uploadAreaAudio.addEventListener('click', () => {
                    input.click();
                });
                $('#ShareObjectAudioFileUpload').change(function (event) {
                        $(File).each(function (e) {
                            if (e != this) {
                                $(this).val('');
                            }
                        });
                        var Uri = URL.createObjectURL(event.target.files[0]);
                        $("#audioPreview").attr('src', Uri);
                });
                ////////////////dosya seçilince videoya kaynak değişimi ve görüntüsü kaldırılacak alanlar//////////////////////
                $('#ShareObjectAudioFileUpload').change(function (event) {
                    const file = event.target.files[0];
                    if (!file) return;
                    const url = URL.createObjectURL(file);

                    $("#uploadAreaAudio").parent(0).css("display", "none");
                    $("#previewSectionAudio").css("display", "block");
                    $("#audioPreview").css("display", "block");

                    $("#audioPreview").attr('src', url).show();
                    ///////////karakter sayıcı///////////
                    const shareText = document.getElementById('ShareObjectAudioText');
                    const charCount = document.getElementById('charCountAudio');
                    shareText.addEventListener('input', function () {
                        const length = this.value.length;
                        charCount.textContent = length;
                        if (length > 1500) {
                            this.value = this.value.substring(0, 1500);
                            charCount.textContent = 1500;
                        }
                    });
                });
            });
           
        </script>

    }
</div>
}
catch
{
    if (!Response.IsRequestBeingRedirected)
    { Response.Redirect(Url.Action("Home", "Home")); }
}
<div class="ShareObjectDetailsFooterEmpty">&nbsp;</div>

