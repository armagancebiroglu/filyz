
@model WebWebWeb.Models.Location


<div class="row share-card">
    @using (Html.BeginForm("ShareLocation", "Home", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        try
        {
            <!-- Yükleme Alanı baslangic-->
            <div class="upload-section" id="uploadSectionLocation" for="ShareLocationShowBtn">
                <div class="upload-area" id="uploadAreaLocation">
                    <div class="upload-icon">
                        <i class="fa fa-map-marker-alt" id="uploadIcon"></i>
                    </div>
                    <div class="upload-text" id="uploadText">Konum Paylaş</div>
                    <div class="upload-hint" id="uploadHint">Bulunduğun yeri paylaş</div>
                    <input id="ShareLocationShowBtn" onclick="ShareLocationShowBtnclick()" type="button" value="Göster" style="display:none" />
                </div>
            </div>
            <!-- Yükleme Alanı bitis-->

            <!-- Önizleme Alanı baslangic-->
            <div class="preview-section" id="previewSectionLocation">
                <div class="preview-container" id="previewContainerLocation">
                    <img id="ImgSrc" style="width:100%; max-width:400px;" />
                </div>
            </div>
            <!-- Önizleme Alanı bitis-->
            <!-- Metin Alanı baslangic-->
            <div class="text-section">
                @Html.TextAreaFor(mbox => mbox.text, new { @id = "ShareLocationText", @class = "share-textarea", rows = "5", Placeholder = "Paylaşımınıza açıklama ekleyin..." })
                <div class="char-counter">
                    <span id="charCountLocation">0</span> / 1500
                </div>
            </div>
            <div>@Html.ValidationMessageFor(mbox => mbox.image_url, "", new { @class = "erorMessage" })</div>
            <!-- Metin Alanı bitis-->
            <!-- Gönder Butonu baslangic-->
            <div class="send-section">
                <button class="send-btn" id="ShareLocationBtn" type="submit" value="Paylaş">
                    @*<input id="ShareLocationBtn" type="submit" value="Paylaş" class="ButtonHiden" />*@
                    <i class="fas fa fa-paper-plane"></i>
                    Paylaş
                </button>
            </div>
            <!-- Gönder Butonu bitis-->
            <div class="">
                @Html.Hidden("latitude")
                @Html.Hidden("longitude")
                @Html.Hidden("mapsImgSrc")
                <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
                <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
                <script src="https://html2canvas.hertzen.com/dist/html2canvas.min.js"></script>
                <script src="https://unpkg.com/leaflet-image@0.4.0/leaflet-image.js"></script>

                <script type="text/javascript">
                    $(document).ready(function () {
                        var map;

                        const uploadAreaLocation = document.getElementById('uploadAreaLocation');
                        uploadAreaLocation.addEventListener('click', () => {
                            document.getElementById('ShareLocationShowBtn').click();
                        });

                        $("#ShareLocationShowBtn").click(function () {
                            if (!navigator.geolocation) {
                                alert('Tarayıcınız bu özelliği desteklemiyor.');
                                return;
                            }

                            navigator.geolocation.getCurrentPosition(
                                function (position) {
                                    var lat = position.coords.latitude;
                                    var lng = position.coords.longitude;

                                    $("#uploadAreaLocation").parent(0).css("display", "none");
                                    $("#previewSectionLocation").css("display", "block");
                                    $("#latitude").val(lat);
                                    $("#longitude").val(lng);

                                    $("#previewContainerLocation").html("");
                                    $("#previewContainerLocation").css({ "width": "400px", "height": "300px" });

                                    map = L.map('previewContainerLocation').setView([lat, lng], 15);

                                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                                        attribution: '&copy; OpenStreetMap',
                                        crossOrigin: true
                                    }).addTo(map);

                                    var marker = L.marker([lat, lng], { draggable: true }).addTo(map);
                                    marker.bindPopup("Sen Buradasın!").openPopup();

                                    // Tile'lar yüklendikten sonra yakala
                                    map.whenReady(function () {
                                        setTimeout(captureMap, 1500);
                                    });

                                    marker.on('dragend', function () {
                                        var pos = marker.getLatLng();
                                        $("#latitude").val(pos.lat);
                                        $("#longitude").val(pos.lng);
                                        setTimeout(captureMap, 500);
                                    });
                                },
                                function (error) {
                                    var mesajlar = {
                                        1: "Konum izni verilmedi.",
                                        2: "Konum bilgisi alınamadı.",
                                        3: "Konum isteği zaman aşımına uğradı."
                                    };
                                    alert(mesajlar[error.code] || "Bilinmeyen bir hata oluştu.");
                                }
                            );
                        });

                        function captureMap() {
                            leafletImage(map, function (err, canvas) {
                                if (err) {
                                    console.error("Harita yakalanamadı:", err);
                                    return;
                                }
                                var imgData = canvas.toDataURL("image/png");
                                $("#mapsImgSrc").val(imgData);
                                $("#ImgSrc").attr("src", imgData); // img src güncelle
                            });
                        }

                        // Karakter sayıcı
                        const shareText = document.getElementById('ShareLocationText');
                        const charCount = document.getElementById('charCountLocation');
                        shareText.addEventListener('input', function () {
                            var length = this.value.length;
                            if (length > 1500) {
                                this.value = this.value.substring(0, 1500);
                                length = 1500;
                            }
                            charCount.textContent = length;
                        });
                    });                                 
                                                                 
                </script>
            </div>
         

        }
        catch
        {
            if (!Response.IsRequestBeingRedirected)
            { Response.Redirect(Url.Action("Home", "Home")); }
        }
    }
</div>
<div class="empty80">&nbsp;</div>
