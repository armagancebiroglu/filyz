
@try
{

    <!-- Modal content-->
    <div class="modal-content" id="Forgot">
        <div class="modal-header">
            <span type="button" class="modal-close" data-bs-dismiss="modal">&times;</span>
            <h4 class="modal-title">Şifrenizi mi Unuttunuz?</h4>
        </div>
        <div class="form-group">
            @*@using (Html.BeginForm("ForgotPassword", "Default", FormMethod.Post, new { @class = "mail-form" }))*@
            @using (Ajax.BeginForm("ForgotPassword", "Default", new AjaxOptions { UpdateTargetId = "Forgot", HttpMethod = "POST", InsertionMode = InsertionMode.ReplaceWith }))
            {

                @Html.AntiForgeryToken()
                if (ViewBag.send == "send")
                {
                    <div class="success-toast" id="successToast" style="display:block;">
                        <i class="fa fa-circle-check"></i>
                        <span>Eposta başarıyla gönderildi.</span>
                    </div>
                }
                else if (ViewBag.send == "not_send")
                {
                    <div class="success-toast" id="successToast" style="display:block;">
                        <i class="fa fa-circle-check"></i>
                        <span>Eposta gönderilemedi.</span>
                    </div>
                }
                else if (ViewBag.send == null)
                {
                    <div class="form-label">
                        <p>Üye kodunuzu girin, şifreniz e-posta adresinize gönderilsin.</p>
                        @Html.TextBox("nick", "", new { @class = "form-controlTxT", Placeholder = " Üye Kodunuzu Giriniz" })
                    </div>
                    <div class="modal-footer">
                        <input type="submit" id="btn" style="display:none" />
                        <label for="btn" class="login-btn">Gönder</label>
                        <div id="loading">
                            <img src="~/Media/img/loading.gif" />                           
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}
catch
{
    if (!Response.IsRequestBeingRedirected)
    { Response.Redirect(Url.Action("Info", "Default")); }
}
