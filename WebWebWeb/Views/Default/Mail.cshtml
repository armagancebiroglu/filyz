
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, minimum-scale=1">
    <meta name="keywords" content="islami evlilik sitesi, islami evlilik, muhafazakar eş bulma sitesi, müslüman eş bulma, müslüman hanımlar, tesettürlü hanımlar, tesettürlü eş bulma" />

    <!-- CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/StyleSheetGlassmorphism.css" rel="stylesheet" />
    <link rel="icon" type="image/x-icon" href="/filyz-favicon.ico" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- Validation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <!-- Ajax -->
    <script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
    <!-- Bootstrap JS (en sona yakın) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- SignalR -->
    <script src="~/Scripts/jquery.signalR-2.2.3.min.js"></script>
    <script src="~/signalr/hubs"></script>

    <title>Filyz.com</title>
</head>
<body>
    <div class="SSContainer">
        <div class="topMargin">&nbsp;</div>
        <div class="page-wrapMail">
            <div class="mail-card">
                <!-- Üst dekorasyon -->
                <div class="mail-card-top">
                    <div class="mail-icon-wrap">
                        <i class="fa fa-paper-plane"></i>
                    </div>
                    <div class="mail-card-title">
                        <h2>Site Yönetimine Yaz</h2>
                        <p>Mesajınız en kısa sürede yanıtlanacaktır</p>
                    </div>
                </div>

                @using (Html.BeginForm("Mail", "Default", FormMethod.Post, new { @class = "mail-form" }))
                {
                    string e_mail = ViewBag.Mail;
                    @Html.AntiForgeryToken()
                    if (ViewBag.send == "send")
                    {
                        <div class="success-toast" id="successToast" style="display:block;">
                            <i class="fa fa-circle-check"></i>
                            <span>Mailiniz başarıyla gönderildi.</span>
                        </div>
                    }
                    else
                    {
                        <form class="mail-form" onsubmit="handleSend(event)">
                            <!-- E-posta -->
                            <div class="field-label">
                                <i class="fa fa-at"></i> E-posta Adresiniz
                            </div>
                            @Html.TextBox("e_mail", "", new { @class = "mail-input", Placeholder = e_mail })
                            <div class="field-hint">
                                <i class="fa fa-circle-info"></i>
                                Cevap için mail adresinizi değiştirebilirsiniz
                            </div>
                            <!-- Mesaj -->
                            <div class="field-label">
                                <i class="fa fa-comment-dots"></i> Mesajınız
                            </div>
                            @Html.TextArea("text", new { @class = "mail-textarea", rows = "15", Placeholder = " ..mesaj yazın" })
                          
                            <div class="char-countMail" id="charCount">0 / 2000</div>
                            <div class="form-divider"></div>
                            <!-- Gönder satırı -->
                            <div class="send-row">
                                <button type="button" class="clear-btn" onclick="clearForm()" title="Temizle">
                                    <i class="fa fa-trash-can"></i>
                                </button>

                                <button type="submit" class="SndMsg">
                                    <i class="fa fa-paper-plane"></i>
                                    Gönder
                                </button>
                            </div>
                        </form>
                    }
                }

                <!-- Alt bilgi -->
                <div class="mail-footer">
                    <i class="fa fa-shield-halved"></i>
                    Mesajınız güvenli şekilde iletilir. Ortalama yanıt süresi 24 saattir.
                </div>
            </div>
        </div>
    </div>

    <script>
        /* Karakter sayacı */
        function countChars(el) {
            const max = 2000;
            const count = el.value.length;
            const el2 = document.getElementById('charCount');
            el2.textContent = count + ' / ' + max;
            el2.classList.toggle('warn', count > max * 0.85);
        }

        /* Formu temizle */
        function clearForm() {
            document.querySelector('.mail-textarea').value = '';
            document.getElementById('charCount').textContent = '0 / 2000';
        }

        /* Başarı toast (demo) */
        function handleSend(e) {
            e.preventDefault();
            const toast = document.getElementById('successToast');
            toast.style.display = 'flex';
            setTimeout(() => {
                toast.style.transition = 'opacity 1s';
                toast.style.opacity = '0';
                setTimeout(() => { toast.style.display = 'none'; toast.style.opacity = '1'; }, 1000);
            }, 3500);
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Slayt resimleri
            const images = [
                '../../Media/img/1.jpg',
                '../../Media/img/2.jpg',
                '../../Media/img/3.jpg',
                '../../Media/img/4.jpg',
                '../../Media/img/5.jpg'
            ];
            let currentImage = 0;
            // Sonraki resme geç
            function nextBackground() {
                currentImage = (currentImage + 1) % images.length;
                // Yeni resmi önceden yükle
                const img = new Image();
                img.src = images[currentImage];
                img.onload = function () {
                    // Resim yüklendikten sonra arka planı değiştir
                    document.body.style.backgroundImage = `url('${images[currentImage]}')`;
                };
            }
            // Otomatik arka plan değişimini başlat (5 saniyede bir)
            setInterval(nextBackground, 5000);
        });
    </script>
</body>
</html>
