<script src="https://ajax.aspnetcdn.com/ajax/jQuery/jquery-3.1.1.min.js"></script>
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, minimum-scale=1">
<!-- CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="~/StyleSheetGlassmorphism.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<!-- Validation -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
<!-- Ajax -->
<script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
<!-- Bootstrap JS (en sona yakın) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<div class="row">
    <div class="col-sm-6">

        <div class="modal fade show" id="mymodal" role="dialog" style="display:block;">
            <div class="modal-dialog" style="min-height:500px; backdrop-filter:blur(6px); display:flex; align-items:center; justify-content:center; border-radius:var(--border-radius-lg); padding:24px; font-family:'DM Sans',sans-serif;">
                <!-- modal content-->
                <div class="modal-content" style="padding:0; width:100%; max-width:440px; background:rgba(255,255,255,0.22); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px); border:1px solid rgba(255,255,255,0.30); border-radius:20px; overflow:hidden; box-shadow:0 8px 32px rgba(0,0,0,0.12);">
                    <div class="modal-header" style="background:rgba(233,63,105,0.18); border-bottom:1px solid rgba(233,63,105,0.28); padding:16px 20px; display:flex; align-items:center; gap:12px;">
                        <div style="width:38px; height:38px; flex-shrink:0; border-radius:50%; background:rgba(233,63,105,0.22); border:1px solid rgba(233,63,105,0.35); display:flex; align-items:center; justify-content:center;">
                            <i style="font-size:28px; color:#e93f69; font-style:normal;" aria-hidden="true"> &#9888;</i>
                        </div>
                        <div>
                            <p style="margin:0 0 2px; font-size:10px; font-weight:700; color:#e93f69; letter-spacing:0.8px; text-transform:uppercase; font-family:'DM Mono',monospace;">Üyelik Durumunuz</p>
                            <p style="margin:0; font-size:14px; font-weight:700; color:#2a2a3a;">@ViewBag.txt1</p>
                        </div>
                    </div>
                    <div class="modal-body" style="padding:20px; display:flex; flex-direction:column; gap:14px;">
                        @try
                        {
                            <!-- Açıklama -->
                            <p style="margin:0; font-size:13.5px; line-height:1.65; color:#444;">
                                @ViewBag.txt2
                            </p>
                            <!-- Not al uyarısı -->
                            <div style="display:flex; align-items:flex-start; gap:9px; background:rgba(255,255,255,0.28); border:1px solid rgba(255,255,255,0.38); border-radius:12px; padding:11px 13px;">
                                <i class="ti ti-bookmark" style="font-size:15px; color:#e93f69; flex-shrink:0; margin-top:1px;" aria-hidden="true"></i>
                                <p style="margin:0; font-size:12.5px; color:#555; line-height:1.55;">Aşağıdaki bilgileri güvenli bir yere <strong style="color:#2a2a3a; font-weight:700;">not alınız.</strong></p>
                            </div>
                            <!-- Üye Kodu + Şifre -->
                            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
                                <div style="background:rgba(255,255,255,0.32); border:1px solid rgba(255,255,255,0.42); border-radius:14px; padding:14px 16px;">
                                    <p style="margin:0 0 6px; font-size:9.5px; font-weight:700; color:#e93f69; letter-spacing:0.7px; text-transform:uppercase; font-family:'DM Mono',monospace;">Üye Kodu</p>
                                    <p style="margin:0; font-size:24px; font-weight:500; color:#1e1e2e; font-family:'DM Mono',monospace; letter-spacing:3px;">@ViewBag.Nick_Name</p>
                                </div>
                                <div style="background:rgba(255,255,255,0.32); border:1px solid rgba(255,255,255,0.42); border-radius:14px; padding:14px 16px;">
                                    <p style="margin:0 0 6px; font-size:9.5px; font-weight:700; color:#e93f69; letter-spacing:0.7px; text-transform:uppercase; font-family:'DM Mono',monospace;">Şifre</p>
                                    <p style="margin:0; font-size:24px; font-weight:500; color:#1e1e2e; font-family:'DM Mono',monospace; letter-spacing:3px;">@ViewBag.Password</p>
                                </div>
                            </div>
                            <!-- Buton -->
                            <button style="width:100%; margin-top:4px; padding:11px; border-radius:12px; border:none; background:#e93f69; color:#fff; font-size:13.5px; font-weight:700; font-family:'DM Sans',sans-serif; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:8px; box-shadow:0 4px 14px rgba(233,63,105,0.35); transition:opacity 0.18s;"
                                    onmouseover="this.style.opacity='0.88'" onmouseout="this.style.opacity='1'"
                                    onclick="location.href='@Url.Action("Home","Home")'">
                                <i class="ti ti-check" style="font-size:16px;" aria-hidden="true"></i>
                                Anladım, bilgileri not aldım
                            </button>
                            <!-- Alt link -->
                            <p style="margin:0; text-align:center; font-size:12px; color:#888;">
                            </p>
                        }
                        catch
                        {
                            if (!Response.IsRequestBeingRedirected)
                            { Response.Redirect(Url.Action("Info", "Default")); }
                        }

                    </div>                  
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    $(document).ready(function () {
        $("#mymodal").modal({
            show: 'true',
            backdrop: 'static'
        });
    });
    document.addEventListener('DOMContentLoaded', function () {
        // Slayt resimleri
        const images = [

            '../../Content/img/1.jfif',
            '../../Content/img/2.jfif',
            '../../Content/img/3.jfif',
            '../../Content/img/4.jfif',
            '../../Content/img/5.jpeg'

        ];

        let currentImage = 0;

        // Sonraki resme geç
        function nextBackground() {
            currentImage = (currentImage + 1) % images.length;

            // Yeni resmi önceden yükle
            const img = new Image();
            img.src = images[currentImage];
            img.onload = function () {
                // Resim yüklendikten sonra arka planı değiştir
                document.body.style.backgroundImage = `url('${images[currentImage]}')`;
            };
        }
        // Otomatik arka plan değişimini başlat (5 saniyede bir)
        setInterval(nextBackground, 5000);
    });
</script>

