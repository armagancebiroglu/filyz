@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, minimum-scale=1">
    <meta name="keywords" content="islami evlilik sitesi, islami evlilik, muhafazakar eş bulma sitesi, müslüman eş bulma, müslüman hanımlar, tesettürlü hanımlar, tesettürlü eş bulma" />
    <!-- jQuery -->
    <script src="https://ajax.aspnetcdn.com/ajax/jQuery/jquery-3.6.0.min.js"></script>
    <!-- Bootstrap -->
    @*<link rel="stylesheet" href="https://ajax.aspnetcdn.com/ajax/bootstrap/3.3.7/css/bootstrap.css">*@
    @*<script src="https://ajax.aspnetcdn.com/ajax/bootstrap/3.3.7/bootstrap.min.js"></script>*@

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Validation -->
    <script src="https://ajax.aspnetcdn.com/ajax/jquery.validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://ajax.aspnetcdn.com/ajax/mvc/5.2.9/jquery.validate.unobtrusive.min.js"></script>
    <!-- (Opsiyonel) -->
    <script src="/Scripts/jquery.unobtrusive-ajax.min.js"></script>
    <link href="~/StyleSheetGlassmorphism.css" rel="stylesheet" />
    <link rel="icon" type="image/x-icon" href="/filyz-favicon.ico" />
    <title>Filyz.com</title>
    <style>
    </style>
</head>
<body>
    <div class="login-container">
        <div class="InfoLogo">
            <img src="~/Media/img/logo2.jpg" />
        </div>
        <div id="loginForm">
            @Html.Partial("Login")
        </div>
        <div class="links">
            <a href="#" data-bs-toggle="modal" data-bs-target="#mymodalCreate">Lütfen Kaydol</a>
            <a href="#" data-bs-toggle="modal" data-bs-target="#mymodalForgot">Şifremi Unuttum</a>
        </div>
        <p class="intro">
            <strong>Filyz.com</strong>, İslami değerlere önem veren insanların evlilik niyetiyle tanışmasına vesile olmak için kurulmuştur. Üyelerimizin bu amaca uygun davranmasını bekliyoruz.
        </p>
        <ul class="features-list">
            <li class="feature-item"><i class="fa fa-image"></i> Fotoğraf, video veya sesli paylaşımlar yapabilirsiniz.</li>
            <li class="feature-item"><i class="fa fa-pencil"></i> Anket oluşturabilir veya yanıtlayabilirsiniz.</li>
            <li class="feature-item"><i class="fa fa-search"></i> Kriterlere göre aday arayabilirsiniz.</li>
            <li class="feature-item"><i class="fa fa-map-marker"></i> Konum paylaşarak çevrenizdeki adayları görebilirsiniz.</li>
            <li class="feature-item"><i class="fa fa-comments"></i> Mesajlaşabilir ve canlı yazışabilirsiniz.</li>
            <li class="feature-item"><i class="fa fa-heart"></i> Paylaşımları beğenebilir, yorum yapabilirsiniz.</li>
            <li class="feature-item"><i class="fa fa-star"></i> Favori listenizi oluşturabilirsiniz.</li>
            <li class="feature-item"><i class="fa fa-tag"></i> Paylaşımınızda kişi etiketleyebilirsiniz.</li>
        </ul>
        <br />
        <div class="infoFooter">
            <a> Copyright © 2026 Tüm Hakları Saklıdır</a>&nbsp;&nbsp;
            | &nbsp;&nbsp;<a> filyz.com</a>&nbsp;&nbsp;
            | &nbsp;&nbsp;<a href="@Url.Action("contract", "Default")">Gizlilik</a>&nbsp;&nbsp;
            | &nbsp;&nbsp;<a href="@Url.Action("conditions", "Default")">Kullanım Koşulları</a>&nbsp;&nbsp;
            | &nbsp;&nbsp;<a href="@Url.Action("Mail", "Default")">İletişim</a>
            | &nbsp;&nbsp;<a href="@Url.Action("Index", "xzgqhjk")"><span class="fa fa-fire"></span></a>
        </div>
    </div>
    <div class="modal fade glass" id="mymodalForgot" role="dialog" tabindex="10000">
        <div class="modal-dialog">
            @Html.Action("ForgotPassword", "Default")
        </div>
    </div>
    <div class="modal fade glass" id="mymodalCreate" role="dialog" tabindex="10000">
        <div class="modal-dialog">
            @Html.Action("CreateMember", "Default")
        </div>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Slayt resimleri
            const images = [
                '../../Media/img/1.jpg',
                '../../Media/img/2.jpg',
                '../../Media/img/3.jpg',
                '../../Media/img/4.jpg',
                '../../Media/img/5.jpg'
            ];
            let currentImage = 0;
            // Sonraki resme geç
            function nextBackground() {
                currentImage = (currentImage + 1) % images.length;
                // Yeni resmi önceden yükle
                const img = new Image();
                img.src = images[currentImage];
                img.onload = function () {
                    // Resim yüklendikten sonra arka planı değiştir
                    document.body.style.backgroundImage = `url('${images[currentImage]}')`;
                };
            }
            // Otomatik arka plan değişimini başlat (5 saniyede bir)
            setInterval(nextBackground, 5000);
        });
    </script>
</body>
</html>
