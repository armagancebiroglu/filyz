<script type='text/javascript'>
    $(document).ready(function () {

        $("#hicap_div").slideUp();
        $('input:radio[name=sex]').change(function () {
            if ($('input:radio[name=sex]:checked').val() == "Kadın") {
                $("#hicap_div").css("visibility", "visible");
                $("#hicap_div").slideDown();
            }
            if ($('input:radio[name=sex]:checked').val() == "Erkek") {
                $("#hicap_div").css("visibility", "hidden");
                $("#hicap_div").slideUp();
                //$('input:radio[name="hicap"]').prop('checked', false);
                $('#hicap').prop('checked', false);
            }
        });

        $("#matiral_status_div").slideUp();
        $("#matiral_status").change(function () {
            $("#matiral_status option:selected").each(function () {
                if ($(this).text() == "Eşinden Ayrılmış" || $(this).text() == "Eşi Vefat Etmiş") {
                    $("#matiral_status_div").css("visibility", "visible");
                    $("#matiral_status_div").slideDown();
                } if ($(this).text() == "Bekar") {
                    $("#matiral_status_div").css("visibility", "hidden");
                    $('#children').prop('checked', false);
                    $("#matiral_status_div").slideUp();
                }
            });
        });

        $("#disable_div").slideUp();
        $('input:radio[name=disableSelect]').change(function () {
            if ($('input:radio[name=disableSelect]:checked').val() == "Evet") {
                $("#disable_div").css("visibility", "visible");
                $("#disable_div").slideDown();
            }
            if ($('input:radio[name=disableSelect]:checked').val() == "Hayır") {
                $("#disable_div").css("visibility", "hidden");
                $("#disable_div").slideUp();
                $('#disable').val("");
                //$('select[name="disable"]').val('');
            }
        });

        document.getElementById("nick_name").readOnly = true;

        jQuery.fn.NumericOnly = function () {
            return this.each(function () {
                $(this).keydown(function (e) {
                    var key = e.charCode || e.keyCode || 0;
                    return (
                        key == 8 ||
                        key == 9 ||
                        key == 46 ||
                        (key >= 37 && key <= 40) ||
                        (key >= 48 && key <= 57) ||
                        (key >= 96 && key <= 105));
                });
            });
        };
        $('#age').NumericOnly();
        $('#kilo').NumericOnly();
        $('#height').NumericOnly();

        $("#height, #kilo ").keydown(function (event) {
            var value = $(this).val();
            value = value.replace(/[^0-9]/g, '');
            value = value.substr(0, 2);
            $(this).val(value);
        });

        $(document).ready(function () {
            $("#my_story").keypress(function (evt) {
                var charCode = (evt.which) ? evt.which : event.keyCode
                if (((charCode <= 93 && charCode >= 65) || (charCode <= 122 && charCode >= 97) || charCode == 8) || charCode == 32 || charCode == 33 || charCode == 39 || charCode == 63 || charCode == 96 || charCode == 46 || charCode == 350 || charCode == 351 || charCode == 304 || charCode == 286 || charCode == 287 || charCode == 231 || charCode == 199 || charCode == 305 || charCode == 214 || charCode == 246 || charCode == 220 || charCode == 252) {
                    return true;
                }
                return false;
            });
        });

        $('.tabb').click(function () {
            var attr_ = $(this).attr("href");
            $(".tb").each(function () {
                if ($(this).attr("href") == attr_) {
                    $(this).parent().addClass("active");
                } else {
                    $(this).parent().removeClass("active");
                }
            });
        });
        // Adım geçişleri
        let currentStep = 1;

        function showStep(step) {
            $(".step-tab").removeClass("active");
            $(`.step-tab[data-step=${step}]`).addClass("active");

            $(".step-content").removeClass("active");
            $(`.step-content[data-step=${step}]`).addClass("active");

            if (step === 1) $(".btn-prev").hide(); else $(".btn-prev").show();
            if (step === 5) {
                $(".btn-next").hide();
                $(".btn-save").show();
            } else {
                $(".btn-next").show();
                $(".btn-save").hide();
            }
            currentStep = step;
        }

        $(".step-tab").click(function () {
            const step = $(this).data("step");
            showStep(step);
        });

        $(".btn-next").click(function () {
            if (currentStep < 5) showStep(currentStep + 1);
        });

        $(".btn-prev").click(function () {
            if (currentStep > 1) showStep(currentStep - 1);
        });
    });
</script>
