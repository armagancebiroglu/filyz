@try
{
    if (ViewBag.result > 0)
    {
        <div class="glyphicon-outlined selected">
            <span class="fa fa-file-text"></span><i>@ViewBag.result</i>
        </div>
    }
    else
    {
        <div class="glyphicon-outlined un-selected">
            <span class="fa fa-file-text"></span><i>0</i>
        </div>
    }
}
catch
{
    if (!Response.IsRequestBeingRedirected)
    { Response.Redirect(Url.Action("Home", "Home")); }
}