
@{
    ViewBag.Title = "Survey";
    Layout = "~/Views/Shared/_LayoutP.cshtml";
}
<div class="Container">   
    <div class="empty80">&nbsp;</div>
    <div class="page-wrap">      
        <div class="glass-card">
            <div class="section-header">
                <i class="fa fa-pencil-square" style="color: var(--main-color); font-size: 18px;"></i>
                <div class="Ssection-title">Sorduklarım</div>
                <div class="section-badge" id="Surveycount"></div>
            </div>
            <a href="@Url.Action("MySurveyDetails", "MyProfil")" class="surveybtn"><i class="fa fa-pencil"></i>Yeni Bir Anket Oluşturun</a>
            @Html.Action("SurveyMyList", "MyProfil")
        </div>
        <div class="glass-card">
            <div class="section-header">
                <i class="fa fa-check-square" style="color: var(--main-color); font-size: 18px;"></i>
                <div class="Ssection-title">Cevapladıklarım</div>
                <div class="section-badge" id="answeredCount"></div>
            </div>
            @Html.Action("SurveyList", "MyProfil")
        </div>
    </div>    
    <div class="empty80">&nbsp;</div>
</div>
<script>
    $(document).ready(function () {
        $(".Deleteicon").click(function () {
            $(this).parent().parent().children().stop(true, true).slideDown("slow");
        });
        $(".DeleteClose").click(function () {
            $(this).parent().parent().stop(true, true).slideUp("slow");
        });
        $("#Surveycount").text($(".SurveyCount .survey-item").length);
        $("#answeredCount").text($(".AnsweredCount .survey-item").length);
    });
</script>