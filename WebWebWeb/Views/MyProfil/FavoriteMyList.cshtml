
@model List<WebWebWeb.Models.MemberShortCard>


    @try
    {
        if (Model.Count > 0)
        {
            foreach (var member in Model)
            {
                int yas = (int)(DateTime.Now.Year) - (int)((member.age).Year);
                <div class="HomeFavoriItem">                  
                        @if (Convert.ToInt32(member.is_online) == 0)
                        {
                            <span id="is_online" class="fa fa-circle un-selected"></span>
                        }
                        else
                        {
                            <span id="is_online" class="fa fa-circle active-color"></span>
                        }                   
                    <figure>
                        <a href="@Url.Action("Profil", "Profil", new { member_id = member.id })">
                            <img src="@member.profil_media" class="img-circle"/>
                        </a>
                    </figure>
                    <div class="FavoriLnick">@member.nick_name</div> 
                </div>
            }
        }
        else
        {
            @*<div class="siteNot">Favori Listesinde Kimse Yok</div>*@
        }

    }
    catch (Exception)
    {
        if (!Response.IsRequestBeingRedirected)
        { Response.Redirect(Url.Action("Info", "Default")); }
    }




