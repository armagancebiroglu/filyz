
@model List<WebWebWeb.Models.SurveyQuestion>

<div class="sc-card glass" id="SurveyFormList">
    @try
    {
        int count = 0;
        <div class="sc-steps">
            <div class="sc-step-dot" id="scDot1">1</div>
            <div class="sc-step-line" id="scLine1"></div>
            <div class="sc-step-dot  sc-active" id="scDot2">2</div>
            <div class="sc-step-line" id="scLine2"></div>
            <div class="sc-step-dot" id="scDot3">3</div>
        </div>
        <div class="sc-section-hd">
            <i class="ri-question-line" style="color:var(--rose);font-size:17px"></i>
            <div class="sc-section-title">Sorular</div>
            <div class="sc-badge" id="scQBadge"></div>
        </div>
        <div class="sc-warning">
            <i class="fa fa-info-circle"></i>
            <span>Her soruya en az 2, en fazla 4 şık ekleyebilirsiniz. Soruyu kaydetmek için en az 2 şık girmeniz gerekir.</span>
        </div>
        <div id="scQList">
            @foreach (var item in Model)
            {
                count = count + 1;
                <div class="sc-q-card">
                    <div class="sc-q-label">SORU @count </div>
                    <div class="sc-q-text"> @item.questionText</div>
                    <div class="sc-opts-list">
                        <div class="sc-opt-item"><div class="sc-opt-letter">A</div><div class="Stext"> @item.A_text</div></div>
                        <div class="sc-opt-item"><div class="sc-opt-letter">B</div><div class="Stext"> @item.B_text</div></div>
                        <div class="sc-opt-item"><div class="sc-opt-letter">C</div><div class="Stext"> @item.C_text</div></div>
                        <div class="sc-opt-item"><div class="sc-opt-letter">D</div><div class="Stext"> @item.D_text</div></div>
                    </div>
                    <div class="sc-q-actions">
                        <button class="sc-btn-danger">
                            <i class="fa fa-trash"></i> Sil
                        </button>
                    </div>
                    <div class="sc-del-confirm" id="">
                        <span>Bu soruyu silmek istediğinize emin misiniz?</span>
                        <div class="sc-del-actions">
                            <button class="sc-confirm-no">Hayır</button>
                            @Ajax.ActionLink("Evet, Sil", "SurveyEditQeustion", "MyProfil", new { surveyQuestionEvent = "delete", obje_id = item.survey_id, question_id = item.id }, new AjaxOptions { UpdateTargetId = "SurveyFormList", InsertionMode = InsertionMode.Replace, OnComplete = "" }, new { @class = "sc-confirm-yes", onclick = "scToast('Soru Silindi');" })
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    catch
    {
        if (!Response.IsRequestBeingRedirected)
        { Response.Redirect(Url.Action("Home", "Home")); }
    }

    @using (Ajax.BeginForm("SurveyEditQeustion", "MyProfil", new { surveyQuestionEvent = "add", obje_id = ViewBag.obje_id }, new AjaxOptions { UpdateTargetId = "SurveyFormList", HttpMethod = "POST", InsertionMode = InsertionMode.Replace }))
    {
        @Html.AntiForgeryToken()
        <div class="sc-add-form">
            <div class="sc-input-group">
                <div class="sc-input-label">Soru Metni</div>
                @Html.TextArea("Question", new { @id = "SurveyEditQeustionText", @class = "sc-input", rows = "1", Placeholder = " Sorunuzu buraya yazın..." })
            </div>
            <div class="sc-input-label" style="margin-bottom:8px;">Şıklar</div>
            <div class="sc-opts-editor" id="scOptsEditor">
                <div class="sc-opt-row">
                    <div class="sc-opt-badge">A</div>
                    @Html.TextArea("A_option", new { @class = "sc-input", rows = "1", Placeholder = " Şık A..." })
                    <div style="width:22px;flex-shrink:0"></div>
                </div>
                <div class="sc-opt-row">
                    <div class="sc-opt-badge">B</div>
                    @Html.TextArea("B_option", new { @class = "sc-input", rows = "1", Placeholder = " Şık B..." })
                    <div style="width:22px;flex-shrink:0"></div>
                </div>
                <div class="sc-opt-row">
                    <div class="sc-opt-badge">C</div>
                    @Html.TextArea("C_option", new { @class = "sc-input", rows = "1", Placeholder = " Şık C..." })
                    <button class="sc-remove-opt" type="button" title="Şıkkı kaldır"><i class="fa fa-times-circle"></i></button>
                    <div style="width:22px;flex-shrink:0"></div>
                </div>
                <div class="sc-opt-row">
                    <div class="sc-opt-badge">D</div>
                    @Html.TextArea("D_option", new { @class = "sc-input", rows = "1", Placeholder = " Şık D..." })
                    <button class="sc-remove-opt" type="button" title="Şıkkı kaldır"><i class="fa fa-times-circle"></i></button>
                    <div style="width:22px;flex-shrink:0"></div>
                </div>
            </div>
            <button class="sc-add-opt-btn" type="button" id="scAddOptBtn">
                <i class="fa fa-plus-circle"></i> Şık Ekle
            </button>

            <div class="sc-btn-row" style="margin-top:14px;">
                <button class="sc-btn-primary" type="submit">
                    <i class="ri-check-line"></i> Soruyu Kaydet
                </button>
                <button class="sc-btn-ghost" type="button">
                    <i class="fa fa-refresh"></i> Temizle
                </button>
            </div>
        </div>
    }
    <script>
        $(document).ready(function () {
            $(".sc-opts-editor .sc-opt-row").slice(-2).hide();
            $("#scAddOptBtn").click(function () {
                $(".sc-opts-editor .sc-opt-row:hidden:first").show();
            });
            $(".sc-remove-opt").click(function () {
                let visibleRows = $(".sc-opts-editor .sc-opt-row:visible");
                let lastVisible = visibleRows.last();
                // İlk 2 eleman hep açık kalsın
                if (visibleRows.length > 2) {
                    lastVisible.find(".sc-input").val("");
                    lastVisible.hide();
                }
            });

            $(".Stext").each(function () {
                if ($(this).text().trim() === "") {
                    $(this).parent().hide();
                }
            });
            //$("#scQBadge").val($(".sc-q-label").length + " soru");
            $("#scQBadge").text($(".sc-q-label").length + " soru"); 
            $("#scPubQ").text($(".sc-q-label").length);
            $(".sc-btn-danger").click(function () {
                $(this).parent().parent().children(".sc-del-confirm").addClass("sc-show");
            });
            $(".sc-confirm-no").click(function () {
                $(this).parent().parent(".sc-del-confirm").removeClass("sc-show");
            });

            if ($("#scQList").find(".sc-q-label").length > 0) {
                $("#scPublishSection").removeClass("sc-locked");
            }
            
            $(".sc-input").val("");
            $(".sc-btn-ghost").click(function () {
               $(".sc-input").val("");
            });
        });
    </script>
</div>
