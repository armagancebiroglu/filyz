@{
    ViewBag.Title = "Change Password";
    Layout = "~/Views/Shared/_LayoutP.cshtml";
}

@model WebWebWeb.Models.ChangePassword

<div class="container">
    <div class="topMargin"></div>
    <div class="Pcard">
        <a type="button" class="modal-close"  href="javascript:window.history.go(-1)">&times;</a>
        <!-- Card Header -->
        @using (Html.BeginForm("ChangePassword", "MyProfil", FormMethod.Post))    ////@using (Ajax.BeginForm("ChangePassword", "MyProfil", new AjaxOptions { UpdateTargetId = "ChangePassworDiv", HttpMethod = "POST", InsertionMode = InsertionMode.Replace }))
    {
        try
        {
            @Html.AntiForgeryToken()

            <div class="Pcard-header">
                <div class="Pcard-icon">
                    <i class="fa fa-lock"></i>
                </div>
                <div>
                    <div class="Pcard-title">Şifre Değiştir</div>
                    <div class="Pcard-subtitle">Hesabını güvende tutmak için düzenli güncelle</div>
                </div>
            </div>
            <div class="Pdivider"></div>
            <!-- FORM -->
            <div id="formArea">
                <!-- Mevcut Şifre -->
                <div class="Pform-group">
                    <label class="Pform-label">Mevcut Şifre</label>
                    <div class="Pinput-wrap">
                        <i class="fa fa-lock Pinput-icon"></i>
                        @Html.TextBox("Old_password", "", new { @id = "Old_password", @class = "form-control", @type = "password", placeholder = "Mevcut şifrenizi giriniz." })
                        <i class="fa fa-eye Ptoggle-pass" id="PtoggleCurrent" onclick="togglePass('Old_password','toggleCurrent')"></i>
                    </div>
                </div>
                <!-- Yeni Şifre -->
                <div class="Pform-group">
                    <label class="Pform-label">Yeni Şifre</label>
                    <div class="Pinput-wrap">
                        <i class="fa fa-key Pinput-icon"></i>
                        @Html.TextBox("New_password", "", new { @id = "New_password", @class = "form-control", @type = "password", placeholder = "Yeni şifrenizi girin" })
                        <i class="fa fa-eye Ptoggle-pass" id="toggleNew"  onclick="togglePass('New_password','toggleNew')"></i>
                    </div>
                </div>
                <!-- Şifreyi Onayla -->
                <div class="Pform-group">
                    <label class="Pform-label">Yeni Şifreyi Onayla</label>
                    <div class="Pinput-wrap">
                        <i class="fa fa-check-circle Pinput-icon"></i>
                        @Html.TextBox("confrim_password", "", new { @id = "confrim_password", @class = "form-control", @type = "password", placeholder = "Yeni şifrenizi tekrar girin" })
                        <i class="fa fa-eye Ptoggle-pass" id="toggleConfirm" onclick="togglePass('confrim_password','toggleConfirm')"></i>
                    </div>
                    <div class="Pmatch-hint" id="PmatchHint"> @Html.ValidationMessageFor(mbox => mbox.password, "", new { @class = "erorMessage" })</div>
                </div>
                <!-- Submit -->
                <button class="Pbtn-submit" id="PsubmitBtn" type="submit" name="enter" value="Kaydet">
                    <i class="fa fa-shield-alt"></i> Şifreyi Güncelle
                </button>
            </div>
    }
    catch (Exception)
    {
        if (!Response.IsRequestBeingRedirected)
        { Response.Redirect(Url.Action("Info", "Default")); }
    }
}
    </div>
</div>
  
<script>
    function togglePass(inputId, iconId) {
        const inp = document.getElementById(inputId);
        const ico = document.getElementById(iconId);
        const isPass = inp.type === 'password';
        inp.type = isPass ? 'text' : 'password';
        ico.className = `fa fa-eye${isPass ? '-slash' : ''} Ptoggle-pass`;
    }
</script>
