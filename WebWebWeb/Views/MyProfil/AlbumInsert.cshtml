@model WebWebWeb.Models.albums

<!-- Modal content-->
<div class="modal-content" id="modal-content">
    <div class="modal-header">
        <button type="button" class="modal-close" data-bs-dismiss="modal" onclick="location.href='@Url.Action("MyProfil", "MyProfil")'">&times;</button>
        <h3 class="modal-title">Albüme Ekle</h3>
    </div>
    <div class="modal-body">

        <!--tabs baslangic-->
        <div class="tabs-container">
            <button class="tab-btn active" data-tab="image">
                <i class="fas fa-image"></i>
                <span>Fotoğraf</span>
            </button>
            <button class="tab-btn" data-tab="video">
                <i class="fas fa-video"></i>
                <span>Video</span>
            </button>
        </div>
        <!--tabs bitis-->

        <div id="image" class="tab-content visible">
            <div class="row share-card" id="refresh shareCard">

                @using (Html.BeginForm("AlbumInsert", "MyProfil", new { sort = 0 }, FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()

                    <!-- Yükleme Alanı baslangic-->
                    <div class="upload-section" id="uploadSectionFoto">
                        <div class="upload-area" id="uploadAreaFoto">
                            <div class="upload-icon">
                                <i class="fa fa-cloud-upload" id="uploadIcon"></i>
                            </div>
                            <div class="upload-text" id="uploadText">Fotoğraf Seç</div>
                            <div class="upload-hint" id="uploadHint">JPG, PNG, GIF · Max 10MB</div>
                            <input id="ShareObjectImageFileUpload" class="custom-file-upload" name="file" type="file" accept="image/*" capture="camera" style="display:none" />
                        </div>
                    </div>
                    <!-- Yükleme Alanı bitis-->
                    <!-- Önizleme Alanı baslangic-->
                    <div class="preview-section" id="previewSection">
                        <div class="preview-container" id="previewContainer">
                            <img id="ShareObjectImagePreview" src="#" alt="Önizleme" style="display:none;">
                        </div>
                    </div>
                    <!-- Önizleme Alanı bitis-->
                    <!-- Gönder Butonu baslangic-->
                    <div class="send-section">
                        <button class="send-btn" id="ShareObjectImageBtn">
                            <i class="fas fa fa-paper-plane"></i>
                            Paylaş
                        </button>
                    </div>
                    <!-- Gönder Butonu bitis-->
                }
            </div>
        </div>

        <div id="video" class="tab-content">
            <div class="row share-card">
                @using (Html.BeginForm("AlbumInsert", "MyProfil", new { sort = 4 }, FormMethod.Post, new { enctype = "multipart/form-data" }))
                {//video
                    @Html.AntiForgeryToken()

                    <!-- Yükleme Alanı baslangic-->
                    <div class="upload-section" id="uploadSectionVideo" for="ShareObjectVideoFileUpload">
                        <div class="upload-area" id="uploadAreaVideo">
                            <div class="upload-icon">
                                <i class="fa fa-video-camera" id="uploadIcon"></i>
                            </div>
                            <div class="upload-text" id="uploadText">Video Kaydı Seç</div>
                            <div class="upload-hint" id="uploadHint">MP4, WebM · Max 10MB / 10sn</div>
                            <input id="ShareObjectVideoFileUpload" class="custom-file-upload" name="file" type="file" accept="video/*" style="display:none" />
                        </div>
                    </div>
                    <!-- Yükleme Alanı bitis-->
                    <!-- Önizleme Alanı baslangic-->
                    <div class="preview-section" id="previewSectionVideo">
                        <div class="preview-container" id="previewContainerVideo">
                            <video id="videoPreview" style="width:100%; height:100%;" controls>
                                <source src="#" type="video/mp4" />
                                <source src="#" type="video/ogg" />
                                <source src="#" type="video/webm" />
                                İnternet tarayıcınız eski sürüm olduğundan bu videoyu oynatamıyor.
                            </video>
                        </div>
                    </div>
                    <!-- Önizleme Alanı bitis-->
                    <!-- Gönder Butonu baslangic-->
                    <div class="send-section">
                        <button class="send-btn" id="ShareObjectVideoBtn" type="submit" value="Kaydet">
                            <i class="fas glyphicon glyphicon-send"></i>
                            Paylaş
                        </button>
                    </div>
                    <!-- Gönder Butonu bitis-->

                }
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        const input = document.getElementById("ShareObjectImageFileUpload");
        const preview = document.getElementById("ShareObjectImagePreview");
        const uploadAreaFoto = document.getElementById('uploadAreaFoto');
        const previewSection = document.getElementById('previewSection');
        uploadAreaFoto.addEventListener('click', () => {
            input.click();
        });

        input.addEventListener("change", async function (e) {

            selectedFile = e.target.files[0];

            if (!selectedFile) return;

            // 🔒 sadece resim
            if (!selectedFile.type.startsWith("image/")) {
                alert("Sadece resim seç");
                return;
            }

            // 🔥 RESIZE BURADA
            const resizedBlob = await resizeImage(selectedFile);

            const resizedFile = new File([resizedBlob], "image.jpg", {
                type: "image/jpeg"
            });

            // 🔥 INPUT'U DEĞİŞTİR (EN KRİTİK)
            const dataTransfer = new DataTransfer();
            dataTransfer.items.add(resizedFile);
            input.files = dataTransfer.files;

            console.log("Yeni boyut:", input.files[0].size);

            // 🔥 PREVIEW (küçültülmüş hali)
            const reader = new FileReader();

            reader.onload = function (e) {
                uploadAreaFoto.parentElement.style.display = 'none';
                previewSection.style.display = 'block';
                preview.style.display = 'block';
                preview.src = e.target.result;
            };

            reader.readAsDataURL(resizedFile);
        });
        /////////////TAB GEÇİŞLERİ///////////////
        $(".tab-btn").click(function () {
            // 1. Tıklanan butonun data-tab değerini al
            var targetId = $(this).attr("data-tab");

            // 2. Tüm butonlardan "active" sınıfını kaldır ve tıklanana ekle
            $(".tab-btn").removeClass("active");
            $(this).addClass("active");

            // 3. Tüm tab içeriklerini gizle ve sadece ilgili olanı göster
            // (Varsayım: İçerik panellerinin class'ı .tab-content ve id'leri data-tab ile eşleşiyor)
            $(".tab-content").hide();
            $("#" + targetId).fadeIn(); // veya .show()
        });

        const inputVideo = document.getElementById("ShareObjectVideoFileUpload");
        const previewContainerVideo = document.getElementById("previewContainerVideo");
        const uploadAreaVideo = document.getElementById('uploadAreaVideo');
        const videoPreview = document.getElementById('videoPreview');
        uploadAreaVideo.addEventListener('click', () => {
            inputVideo.click();
        });

        ////////////////dosya seçilince videoya kaynak değişimi ve görüntüsü kaldırılacak alanlar//////////////////////
        $('#ShareObjectVideoFileUpload').change(function (event) {
            const file = event.target.files[0];
            if (!file) return;
            const url = URL.createObjectURL(file);

            $("#uploadAreaVideo").parent(0).css("display", "none");
            $("#previewSectionVideo").css("display", "block");
            $("#videoPreview").css("display", "block");

            $("#videoPreview").attr('src', url).show();

        });
        ////////////////////
        var myVideo = document.getElementById("videoPreview");
        function playPaus() {
            if (myVideo.paused) {
                myVideo.play();
            }
            myVideo.pause();
        }

    });


    // RESIZE
    function resizeImage(file, maxWidth = 600, quality = 0.7) {
        return new Promise((resolve) => {

            const img = new Image();
            const reader = new FileReader();

            reader.onload = e => img.src = e.target.result;

            img.onload = () => {

                let width = img.width;
                let height = img.height;

                if (width > maxWidth) {
                    height *= maxWidth / width;
                    width = maxWidth;
                }

                const canvas = document.createElement("canvas");
                canvas.width = width;
                canvas.height = height;

                const ctx = canvas.getContext("2d");
                ctx.drawImage(img, 0, 0, width, height);

                canvas.toBlob(blob => resolve(blob), "image/jpeg", quality);
            };

            reader.readAsDataURL(file);
        });

    }
</script>