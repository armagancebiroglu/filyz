

@model List<WebWebWeb.Models.shareStreem>
@try
{
    <div class="SurvyeListWrp SurveyCount" id="SurveyWrpMyList">

        @if (Model != null)
        {
            foreach (var item in Model)
            {
                if (item.active == 1)
                {
                    <div class="survey-item" style="animation-delay:0.3s">
                        <div class="MsdDelete">
                            <div>Bu anketi silmek istediğinize emin misiniz? </div>
                            <div class="SurveyItemDeleteDivRight">
                                <span class="fa fa-close DeleteClose"></span> |
                                @Ajax.ActionLink(" ", "SurveyMyList", "MyProfil", new { surveyEvent = "delete", obje_id = item.id }, new AjaxOptions { UpdateTargetId = "SurveyWrpMyList", InsertionMode = InsertionMode.Replace, OnComplete = "" }, new { @class = "fa fa-trash" })
                            </div>
                        </div>
                        <div class="survey-header">
                            <div class="survey-quote">
                                <i class="fa fa-quote-left"></i>
                                <a href="@Url.Action("MySurveyDetails", "MyProfil", new { obje_id = item.id })">@item.text</a>
                                <i class="fa fa-quote-right"></i>
                            </div>
                            <div class="survey-date">
                                <i class="fa fa-calendar-o"></i>  @item.date.Day @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(item.date.Month) @item.date.Year <i class="fa fa-clock-o" aria-hidden="true"></i> @item.date.Hour.ToString() :@item.date.Minute.ToString()
                            </div>
                        </div>
                        <div class="survey-stats">
                            <span class="stat-badge">@Html.Action("NoticeEventHeartMyProfil", "MyProfil", new { obje_id = item.id, sort = item.sort, noticeTableSort = 0 })</span>
                            <span class="stat-badge">@Html.Action("TagCount", "MyProfil", new { obje_id = item.id })</span>
                            <span class="stat-badge">@Html.Action("CommentMyProfilCount", "MyProfil", new { obje_id = item.id })</span>
                            <span class="stat-badge">@Html.Action("SurveyRespondentsCount", "MyProfil", new { obje_id = item.id })</span>
                        </div>
                        <div class="delete-row">
                            <div class="delete-btn-pill Deleteicon">
                                <i class="fa fa-trash" aria-hidden="true"></i> Bu anketi sil
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="survey-item draft" style="animation-delay:0.7s">
                        <!-- Silme onayı bandı -->
                        <div class="MsdDelete">
                            <div>Bu anketi silmek istediğinize emin misiniz? </div>
                            <div class="SurveyItemDeleteDivRight">
                                <span class="fa fa-close DeleteClose"></span> |
                                @Ajax.ActionLink(" ", "SurveyMyList", "MyProfil", new { surveyEvent = "delete", obje_id = item.id }, new AjaxOptions { UpdateTargetId = "SurveyWrpMyList", InsertionMode = InsertionMode.Replace, OnComplete = "" }, new { @class = "fa fa-trash" })
                            </div>
                        </div>
                        <!-- Başlık -->
                        <div class="survey-header">
                            <div class="survey-quote" style="text-transform:lowercase;">
                                <i class="fa fa-quote-left"></i>
                                <a style="text-transform: capitalize !important;" href="@Url.Action("MySurveyDetails", "MyProfil", new { obje_id = item.id })"> @item.text</a>
                                <i class="fa fa-quote-right"></i>
                            </div>
                            <div class="survey-date"><i class="ri-calendar-line"></i> @item.date.Day @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(item.date.Month) @item.date.Year <i class="ri-time-line"></i> <span class="fa fa-calendar-o"></span> @item.date.Hour.ToString() :@item.date.Minute.ToString()</div>
                        </div>
                        <div style="font-size:11px;color:var(--draft-text);margin:8px 0 4px;font-style:italic;opacity:.75;">
                            <i class="fa fa-info-circle" aria-hidden="true"></i> Bu anket henüz yayınlanmadı.
                        </div>
                        <!-- Sil butonu -->
                        <div class="delete-row">
                            <div class="delete-btn-pill Deleteicon">
                                <i class="fa fa-trash-o"></i> Sil
                            </div>
                        </div>
                    </div>
                }
            }
        }
        else
        {
            <div class="empty-message"><i class="fa fa-folder-open" aria-hidden="true"></i>Henüz hiç anket oluşturmadınız.</div>
            //Response.Redirect(Url.Action("Home", "Home"));
        }
        <script>
            $(Document).ready(function () {
                $("#Surveycount").text($(".SurveyCount .survey-item").length);
                $(".Deleteicon").click(function () {
                    $(this).parent().parent().children().stop(true, true).slideDown("slow");
                });
                $(".DeleteClose").click(function () {
                    $(this).parent().parent().stop(true, true).slideUp("slow");
                });
            });
        </script>
    </div>
}
catch
{
    if (!Response.IsRequestBeingRedirected)
    { Response.Redirect(Url.Action("Home", "Home")); }
}

