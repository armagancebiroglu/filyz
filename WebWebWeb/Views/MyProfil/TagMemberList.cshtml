
@model List<WebWebWeb.Models.MemberShortCard>


@try
{
    <div class="tag-columns" id="TagsContent">
        <!-- Sol: Favori listesi -->
        <div class="tag-fav-col">
            <div class="tag-col-title"><i class="fa fa-star"></i> Favorilerim</div>
            <div id="favMemberList">
                <!-- populated by JS -->
                @foreach (var member in ViewBag.favoriteList)
                {
                    bool result = true;
                    foreach (var memberTag in ViewBag.tagMemberList)
                    {
                        if (member.id == memberTag.id)
                        {
                            result = false;
                        }
                    }
                    if (result)
                    {
                        int yas = (int)(DateTime.Now.Year) - (int)((member.age).Year);
                        <div class="fav-member-card">
                            <img src="@member.profil_media" class="fav-avatar" alt="@member.nick_name">
                            <div class="fav-nick">@member.nick_name</div>
                            <div class="fav-age">@yas yaş</div>
                            @Ajax.ActionLink(" ", "TagMemberList", "MyProfil", new { eventAction = "add", shareObje_id = ViewBag.shareObje_id, whom_id = member.id, sort = ViewBag.sort }, new AjaxOptions { UpdateTargetId = "tagBody", InsertionMode = InsertionMode.Replace, OnComplete = "" }, new { @class = "fa fa-user-plus fav-tag-btn" })
                        </div>

                    }
                }
            </div>
        </div>
        <!-- Sağ: Etiketlenenler -->
        <div class="tag-list-col">
            <div class="tag-col-title"><i class="fa fa-tags"></i> Etiketlenenler</div>
            <div id="taggedList">
                @foreach (var member in ViewBag.tagMemberList)
                {
                    int yas2 = (int)(DateTime.Now.Year) - (int)((member.age).Year);

                    <div class="tagged-item">
                        <img src="@member.profil_media" alt="@member.nick_name">
                        <div class="tagged-nick">@member.nick_name<br><span style="font-weight:400;color:#999;font-size:10px;">@yas2 yaş</span></div>
                        <div class="untag-btn">
                            @Ajax.ActionLink(" ", "TagMemberList", "MyProfil", new { eventAction = "remove", shareObje_id = ViewBag.shareObje_id, whom_id = member.id, sort = ViewBag.sort }, new AjaxOptions { UpdateTargetId = "tagBody", InsertionMode = InsertionMode.Replace, OnComplete = "" }, new { @class = "fa fa-user-times" })
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
catch
{
    Response.Redirect(Url.Action("Uppss", "Error", new { P = 0 }));
}

