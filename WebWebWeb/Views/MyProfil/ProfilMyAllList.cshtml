
@model List<WebWebWeb.Models.MemberShortCard>

@try
{


    foreach (var member in Model)
    {
        int yas = (int)(DateTime.Now.Year) - (int)((member.age).Year);
     <div class="memberCardListItemAlt">
        <div class="memberCardListItemAltTable">
            <div class="memberCardListItemTableAltImg">
                <div class="memberCardListItemTableImgIsonlineIco">
                    @if (Convert.ToInt32(member.is_online) == 0)
                    {
                        <span id="is_online" class="glyphicon glyphicon-record" style="color:#c0c0c0;"></span>
                    }
                    else
                    {
                        <span id="is_online" class="glyphicon glyphicon-record" style="color:#43ee0f;"></span>
                    }
                </div>
                <figure>
                    <a href="@Url.Action("Profil", "Profil", new { member_id = member.id })">
                        <img src="@member.profil_media" />  @*class="img-circle" width="100%" style=" box-shadow:0px 5px 5px grey"*@
                    </a>
                </figure>
                <div class="memberCardListItemTableImgEvent">
                    <div>@Html.Action("Favorite", "Profil", new { whom_id = member.id })</div>
                    <div>@Html.Action("Smile", "Profil", new { whom_id = member.id })</div>
                    <div>@Html.Action("MessageCount", "Profil", new { whom_id = member.id })</div>
                </div>
            </div>
            <div class="memberCardListItemTableAltInformation">
                <div class="memberCardListItemAltNick">@member.nick_name</div>
                <div class="memberCardListItemTableAltInformationRow">Yaş: @yas</div>
                <div class="memberCardListItemTableAltInformationRow">Şehir: @member.city</div>
                <div class="memberCardListItemTableAltInformationRow">Eğitim: @member.educational_status</div>
                <div class="memberCardListItemTableAltInformationRow">Memleket: @member.country</div>
                <div class="memberCardListItemTableAltInformationRow">Medeni Hali: @member.matiral_status</div>
                <div class="memberCardListItemAltDate">@member.eventDate.Day @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(member.eventDate.Month)&nbsp;<span class="glyphicon glyphicon-time"></span>&nbsp; @member.eventDate.Hour.ToString() :@member.eventDate.Minute.ToString()</div>
            </div>
        </div>
    </div>
    }
}
catch
{
    if (!Response.IsRequestBeingRedirected)
    { Response.Redirect(Url.Action("Home", "Home")); }
}
<script>
    $(document).ready(function () {
        $("#caption").text(" ").text("Profilini İncelediğim Adaylar");
    });
</script>




