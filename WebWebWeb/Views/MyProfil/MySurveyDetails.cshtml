
@{
    ViewBag.Title = "MySurveyDetails";
    Layout = "~/Views/Shared/_LayoutP.cshtml";
}
@model WebWebWeb.Models.shareStreem
<div class="Container">
    <div class="empty80">&nbsp;</div>
    <div class="sc-page">
        @try
        {
            <div class="sc-card glass">
                <div class="sc-steps">
                    <div class="sc-step-dot sc-active" id="scDot1">1</div>
                    <div class="sc-step-line" id="scLine1"></div>
                    <div class="sc-step-dot" id="scDot2">2</div>
                    <div class="sc-step-line" id="scLine2"></div>
                    <div class="sc-step-dot" id="scDot3">3</div>
                </div>
                @if (string.IsNullOrWhiteSpace(Request.QueryString["obje_id"]))
                {
                    using (Html.BeginForm("SurveyMyList", "MyProfil", new { surveyEvent = "SurveyInsert" }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div id="scNameInputWrap">
                            <div class="sc-warning">
                                <i class="fa fa-info-circle"></i>
                                <span> Öncelikle anketinize bir isim veya açıklama yazın.</span>
                            </div>
                            <div class="sc-input-group">
                                <div class="sc-input-label">Anketin Adını Girin</div>
                                @Html.TextArea("SurveyText", new { @id = "SurveyText", @class = "sc-input", rows = "1", Placeholder = "örn. Dini hassasiyetlerinizi nasıl tanımlarsınız?" })
                            </div>
                            <div class="sc-btn-row">
                                <button class="sc-btn-primary" type="submit" value="Kaydet">
                                    <i class="fa fa-floppy-o"></i> Kaydet
                                </button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="sc-section-hd">
                        <i class="fa fa-file-text" style="color:var(--rose);font-size:17px"></i>
                        <div class="sc-section-title">
                            <i class="fa fa-quote-left"></i> @Model.text
                        </div>
                    </div>
                    if (Model.active != 1)
                    {
                        <div class="sc-warning">
                            <i class="fa fa-info-circle"></i>
                            <span> Hazırladığınız anket adaylar tarafından henüz görülemiyor. Bunun için sorularınızı tamamladıktan sonra aşağıdan yayınlamanız gerekir.</span>
                        </div>
                    }
                    else
                    {
                        <div class="sc-warning">
                            <i class="fa fa-info-circle"></i>
                            <span> Anketiniz yayında. Yine de soru ekleyebilirsiniz.</span>
                        </div>
                        <div class="sc-card glass">
                            <div class="sc-section-hd">
                                <i class="fa fa-file-text" style="color:var(--rose);font-size:17px"></i>
                                <div class="sc-section-title">
                                    <i class="fa fa-quote-left"></i> Cevaplayanlar
                                </div>
                            </div>
                            @Html.Action("SurveyRespondentsList", "MyProfil", new { shareObje_id = Model.id })
                        </div>
                        <div class="sc-card glass">
                            <div class="sc-section-hd">
                                <i class="fa fa-heart" style="color:var(--rose);font-size:17px"></i>
                                <div class="sc-section-title">
                                    <i class="fa fa-quote-left"></i> Beğenenler
                                </div>
                            </div>
                            <div class="panel-body" id="likesBody" style="display:block;">
                                <div class="likes-grid" id="likesGrid">
                                    @Html.Action("EnjoyShared", "MyProfil", new { shareObje_id = Model.id, noticeTableSort = 0 })
                                </div>
                            </div>
                        </div>
                        <div class="sc-card glass" id="tagPanel">
                            <div class="sc-section-hd">
                                <i class="fa fa-tags" style="color:var(--rose);font-size:17px"></i>
                                <div class="sc-section-title">
                                    <i class="fa fa-quote-left"></i> &nbsp;Etiketleyebilirsiniz
                                </div>
                                <i class="fa fa-chevron-down panel-chevron" id="tagChevron" style="float:right; position:absolute; right:15px;"></i>
                            </div>
                            <div class="panel-body" id="tagBody">
                                @Html.Action("TagMemberList", "MyProfil", new { shareObje_id = Model.id, sort = Model.sort })
                            </div>
                        </div>
                    }
                    @Html.Action("SurveyEditQeustion", "MyProfil", new { obje_id = Model.id })
                    if (Model.active == 1)
                    {
                        <div class="sc-locked" id="scPublishSection">
                            <div class="sc-publish-card">
                                <div class="sc-steps" style="max-width:180px;margin:0 auto 18px;">
                                    <div class="sc-step-dot sc-done"><i class="ri-check-line" style="font-size:12px"></i></div>
                                    <div class="sc-step-line sc-done"></div>
                                    <div class="sc-step-dot sc-done"><i class="ri-check-line" style="font-size:12px"></i></div>
                                    <div class="sc-step-line sc-done"></div>
                                    <div class="sc-step-dot sc-active">3</div>
                                </div>
                                <div class="sc-publish-title">Anketiniz yayında.</div>
                                <div class="sc-publish-desc">
                                    Hazırladığınız her anket ile ilgili yorum ve cevarlara <br />
                                    "Cevaplayanlar" listesi üzerinden ulaşabilirsiniz.
                                </div>
                                <div class="sc-pub-summary">
                                    <div class="sc-pub-stat">
                                        <div class="sc-pub-num" id="scPubQ">0</div>
                                        <div class="sc-pub-lbl">Soru</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="sc-locked" id="scPublishSection">
                            <div class="sc-publish-card">
                                <div class="sc-steps" style="max-width:180px;margin:0 auto 18px;">
                                    <div class="sc-step-dot sc-done"><i class="ri-check-line" style="font-size:12px"></i></div>
                                    <div class="sc-step-line sc-done"></div>
                                    <div class="sc-step-dot sc-done"><i class="ri-check-line" style="font-size:12px"></i></div>
                                    <div class="sc-step-line sc-done"></div>
                                    <div class="sc-step-dot sc-active">3</div>
                                </div>
                                <div class="sc-publish-title">Anketiniz Hazır!</div>
                                <div class="sc-warning">
                                    <i class="fa fa-info-circle"></i>
                                    <span> İsterseniz tek soruluk anket bile yapabilirsiniz.</span>
                                </div>
                                <div class="sc-publish-desc">
                                    Hazırladığınız anket adaylar tarafından henüz görülemiyor.<br>
                                    Yayınlamak için aşağıdaki butona tıklayın.
                                </div>
                                <div class="sc-pub-summary">
                                    <div class="sc-pub-stat">
                                        <div class="sc-pub-num" id="scPubQ">0</div>
                                        <div class="sc-pub-lbl">Soru</div>
                                    </div>
                                </div>
                                <button class="sc-btn-publish" type="button" data-bs-toggle="modal" data-bs-target="#scModal">
                                    <i class="fa fa-paper-plane"></i> Anketi Yayınla
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>
            if (!string.IsNullOrWhiteSpace(Request.QueryString["obje_id"]))
            {
                <!-- ─── YAYINLA MODAL ─── -->
                <div class="modal fade glass" id="scModal" role="dialog">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="sc-modal-box">
                                <div class="sc-modal-icon"><i class="fa fa-paper-plane"></i></div>
                                <div class="sc-modal-heading">Yayınlamak istediğinize emin misiniz?</div>
                                <div class="sc-modal-desc">Anketiniz tüm adaylar tarafından görünür hale gelecek.</div>
                                <div class="sc-modal-actions">
                                    <button class="sc-btn-ghost" data-bs-dismiss="modal">
                                        <i class="fa fa-times"></i> Vazgeç
                                    </button>
                                    <div class="sc-btn-primary">
                                        <i class="fa fa-paper-plane"></i> @Html.ActionLink(" Evet Yayınla", "MySurveyDetails", "MyProfil", new { surveyEvent = "update", obje_id = ViewBag.survey.id }, new { @class = "" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        catch
        {
            if (!Response.IsRequestBeingRedirected)
            { Response.Redirect(Url.Action("myProfil", "MyProfil")); }
        }
        </div>
        <div class="empty80">&nbsp;</div>
</div>
<script>
    $(document).ready(function () {
        /* ══════════ TOAST ══════════ */
        let scToastTimer;
        function scToast(msg) {
            const el = document.getElementById('scToast');
            document.getElementById('scToastMsg').textContent = msg;
            el.classList.add('sc-show');
            clearTimeout(scToastTimer);
            scToastTimer = setTimeout(() => el.classList.remove('sc-show'), 2800);
        }

        $("#scNameBadge").click(function () {
            $(".sc-name-display").css("display", "flex");
        });
        $("#scNameBadgeCancel").click(function () {
            $(".sc-name-display").css("display", "none");
        });
        $("#tagChevron").click(function () {
            $("#tagBody").stop(true, true).slideToggle("slow");
            // ikon değişimi
            if ($(this).hasClass("fa-chevron-down")) {
                $(this).removeClass("fa-chevron-down").addClass("fa-chevron-up");
            } else {
                $(this).removeClass("fa-chevron-up").addClass("fa-chevron-down");
            }
        });
    });
</script>

