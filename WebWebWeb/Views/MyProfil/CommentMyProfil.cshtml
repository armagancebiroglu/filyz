@model List<WebWebWeb.Models.Comment>
@{ string id = "shareStreemComment" + ViewBag.obje_id; }
<script>
    $(document).ready(function () {
        $(".commentDeleteTrigger").click(function () {
            $(this).parent().parent().children(".deleteCommenthide").stop(true).slideDown("slow");
            $(this).parent().parent().children(".deleteCommenthide").children(".deleteCommentWrp").stop(true).slideDown("slow");
        });
        $(".commentDeleteClose").click(function () {
            $(this).parent().parent().parent().stop(true).slideUp("slow");
        });
        ////////////////////////////comment All delete trigger
        $(".PdDelete").click(function () {
            $(this).parent().parent().children(".PdSlider").stop(true).slideDown("slow");
        });
        $(".PdClose").click(function () {
            $(this).parent().parent(".PdSlider").stop(true).slideUp("slow");
        });
    });
</script>
@try
{
<div class="shareStreemComment" id="@id">
    <div class="commentList">
        @if (ViewBag.commentList != null)
        {
            foreach (var MemberProfil in ViewBag.MemberProfilList)
            {
                <div class="commentCaption">
                    @if (MemberProfil.id != Convert.ToInt32(ViewBag.who_id))
                    {
                        int yas = (int)(DateTime.Now.Year) - (int)((MemberProfil.age).Year);

                        <div class="commentMember">
                            <div class="TrashRight">
                                <i class="fa fa-trash PdDelete"></i>
                            </div>
                            <div class="PdSlider">
                                <div>Bu kişiyle buradaki tüm konuşmayı silmek istidiğinizden emin misiniz?</div>
                                <div class="">
                                    <i class="fa fa-close PdClose"></i> &nbsp;&nbsp;|&nbsp;&nbsp;
                                    @Ajax.ActionLink(" ", "CommentMyProfil", "MyProfil", new { eventAction = "deleteAll", who_id = ViewBag.who_id, whom_id = MemberProfil.id, obje_id = ViewBag.obje_id, sort = ViewBag.sort, noticeTableSort = ViewBag.noticeTableSort }, new AjaxOptions { UpdateTargetId = id, InsertionMode = InsertionMode.Replace }, new { @class = "fa fa-trash" })
                                </div>
                            </div>
                            <div class="IdentityPhoto">
                                <a href="@Url.Action("Profil", "Profil", new { member_id = MemberProfil.id })">
                                    <img src="@MemberProfil.profil_media" class="img-circle" width="60" height="60" style=" box-shadow:0px 5px 5px grey" />
                                </a>
                            </div>
                            <div class="Identity">
                                <div class="IdentityNick">@MemberProfil.nick_name</div>
                                <div class="IdentityTxt">@yas yaşında</div>
                                <div class="IdentityTxt">@MemberProfil.country</div>
                            </div>
                        </div>
                        <div class="memberCommentListSlider"></div>
                        foreach (var comment in ViewBag.commentList)
                        {
                            if (comment.who_id == MemberProfil.id || comment.whom_id == MemberProfil.id)
                            {

                                <div class="commentListItem d-flex gap-2 mb-2">
                                    <a href="@Url.Action("Profil", "Profil", new { member_id = comment.who_id })">
                                        <img src="@comment.profil_media" class="comment-avatar" width="46" height="46" style=" box-shadow:0px 5px 5px grey" />
                                    </a>
                                    <div class="comment-body">
                                        <div class="comment-author">@comment.nick_name</div>
                                        <div>&nbsp;@comment.comment_text</div>
                                        <div class="comment-time">@comment.date.Day @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(comment.date.Month) <span class="fa fa-clock"></span> @comment.date.Hour.ToString() :@comment.date.Minute.ToString()</div>

                                        <div class="commentListItemFooter">
                                            <!-- kişi sadece kendi yorumunu silebilecek -->
                                            @if (ViewBag.who_id == comment.who_id)
                                            {
                                                <div class="deleteCommentblock"><span class="fa fa-trash commentDeleteTrigger"></span></div>
                                                <div class="deleteCommenthide">
                                                    <div class="deleteCommentWrp">
                                                        <div>Yorumunuzu silmek istediğinizden emin misiniz?</div>
                                                        <div class="commentDelete">
                                                            <i class="fa fa-times commentDeleteClose"></i>|
                                                            @Ajax.ActionLink(" ", "CommentMyProfil", "MyProfil", new { eventAction = "delete", obje_id = comment.obje_id, whom_id = ViewBag.whom_id, sort = comment.sort, comment_id = comment.id, noticeTableSort = comment.noticeTableSort }, new AjaxOptions { UpdateTargetId = id, InsertionMode = InsertionMode.Replace, OnComplete = "deleteComment" }, new { @class = "fa fa-trash" })

                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            <!--  -->
                                        </div>
                                    </div>
                                </div>
                            }

                        }
                        string txtComment = "txtComment" + ViewBag.obje_id + "_" + MemberProfil.id;
                        using (Ajax.BeginForm("CommentMyProfil", "MyProfil", new { eventAction = "comment", obje_id = ViewBag.obje_id, who_id = ViewBag.who_id, whom_id = MemberProfil.id, sort = ViewBag.sort, noticeTableSort = ViewBag.noticeTableSort }, new AjaxOptions { UpdateTargetId = id, HttpMethod = "GET", InsertionMode = InsertionMode.Replace }))
                        {
                            @Html.AntiForgeryToken()
                            string btnComment = "btnComment" + ViewBag.obje_id + "_" + MemberProfil.id;
                            <div class="mb-3">
                                <div class="input-group">
                                    @Html.TextBox("text", "", new { @class = "comment-input", Placeholder = "yorum yazın" })
                                    <button id="@btnComment" type="submit" class="btn btn-send px-3" value="Gönder">Gönder</button>
                                </div>
                            </div>
                        }

                    }
                </div>
            }
        }
        else
        {
                <div> Henüz hiç mesaj yok </div>
        }
    </div>
    <script>
        $(document).ready(function () {
            $('input[type="text"]').each(function () {
                $(this).val('');
            });
        });
    </script>
</div>
}
catch
{
    if (!Response.IsRequestBeingRedirected)
    { Response.Redirect(Url.Action("Info", "Default")); }
}


