
@{
    ViewBag.Title = "ProfilView";
    Layout = "~/Views/Shared/_LayoutP.cshtml";
}
<div class="SSContainer">
    <div class="empty80">&nbsp;</div>
    @*<div class="timeline-line"></div>*@
    <div class="timeline-headers">
        <div class="header-tag">incelediklerim</div>
        <div class="header-tag">Beni inceleyenler</div>
    </div>
    <br /><br />
    <div id="HistoryMemberList">
        @Html.Action("ProfilList", "myProfil", new { page = 0 })
    </div>
    <div class="empty80">&nbsp;</div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        var page = 0;
        var _inCallback = false;
        var hasMoreData = true;

        function loadNotice() {
            if (!hasMoreData || _inCallback) return;

            _inCallback = true;

            $.get("/MyProfil/ProfilList", { page: page + 1 })
                .done(function (data) {
                    if (data && data.trim().length > 0) {
                        $("#HistoryMemberList").append(data);
                        page++;
                    } else {
                        hasMoreData = false;
                    }
                })
                .fail(function () {
                    console.log("Sayfalama hatası");
                    hasMoreData = false;
                })
                .always(function () {
                    _inCallback = false;
                });
        }

        $(window).scroll(function () {
            if ($(window).scrollTop() >= $(document).height() - $(window).height() - 100) {
                loadNotice();
            }
        });
    });
</script>
