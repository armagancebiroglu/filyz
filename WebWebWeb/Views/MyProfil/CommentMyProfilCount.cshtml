
@model WebWebWeb.Models.shareStreem


<div class="shareStreemComment">
    @try
    {
        if (Model != null)
        {
            if (ViewBag.CommentCount != 0)
            {
            <div class="glyphicon-outlined selected" style="display:block;">
                <span class="fa fa-comments"></span><i> @ViewBag.CommentCount</i>
            </div>
            }
            else
            {
            <div class="glyphicon-outlined un-selected" style="display:block;">
                <span class="fa fa-comments"></span><i> 0</i>
            </div>
            }
        }
    }
    catch
    {
        if (!Response.IsRequestBeingRedirected)
        { Response.Redirect(Url.Action("Info", "Default")); }
    }
</div>
