

@model WebWebWeb.Models.shareStreem


<div id="actionEventHeart">
    @try
    {
        if (ViewBag.result != null)
        {
            if (ViewBag.result > 0)
            {
                <div class="glyphicon-outlined selected" style="display:block;">
                    <span class="fa fa-heart"></span><i style="text-decoration:none">@ViewBag.result</i>
                </div>
            }
            else
            {
                <div class="glyphicon-outlined un-selected" style="display:block;">
                    <span class="fa fa-heart"></span><i>0</i>
                </div>
            }
        }
        else
        {
            if (!Response.IsRequestBeingRedirected)
            { Response.Redirect(Url.Action("myProfil", "MyPrpfil")); }
        }

    }
    catch
    {
        if (!Response.IsRequestBeingRedirected)
        { Response.Redirect(Url.Action("Home", "Home")); }
    }
</div>