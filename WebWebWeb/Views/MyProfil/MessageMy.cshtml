
@{
    ViewBag.Title = "MessageMy";
    Layout = "~/Views/Shared/_LayoutP.cshtml";
}
@model List<WebWebWeb.Models.Messages>
<div class="SSContainer">
    <div class="empty80">&nbsp;</div>
    <div class="commentList">
        @try
        {
            if (ViewBag.MessageList != null && ((IEnumerable<dynamic>)ViewBag.MessageList).Any())
            {
                foreach (var MemberProfil in ViewBag.MessageMyMemberList)
                {
                    int yas = (int)(DateTime.Now.Year) - (int)((MemberProfil.age).Year);
                    string id = "MessageListWrp" + MemberProfil.id.ToString();

                    <div class="tab-content active" id="@id">
                        <div class="message-list">
                            <!-- Message Item 1 -->
                            <div class="message-item unread">
                                <div class="message-header-wrapper">
                                    <div class="message-avatar-wrapper">
                                        <a href="@Url.Action("Profil", "Profil", new { member_id = MemberProfil.id })">
                                            <img src="@MemberProfil.profil_media" class="message-avatar">
                                        </a>
                                        @if (Convert.ToInt32(MemberProfil.is_online) == 0)
                                        {
                                            <div class="online-indicator un-selected"></div>
                                        }
                                        else
                                        {
                                            <div class="online-indicator active-color"></div>
                                        }
                                    </div>
                                    <div class="message-info">
                                        <div class="message-header">
                                            <div class="message-name">@MemberProfil.nick_name</div>
                                        </div>
                                        <div class="message-meta">
                                            <div class="message-meta-item">
                                                <i class="fa fa-calendar"></i>
                                                <span>@yas Yaş</span>
                                            </div>
                                            <div class="message-meta-item">
                                                <i class="fa fa-map-marker"></i>
                                                <span>@MemberProfil.city</span>
                                            </div>
                                            <div class="message-meta-item">
                                                <i class="fa fa-home"></i>
                                                <span>@MemberProfil.country</span>
                                            </div>
                                            <div class="message-meta-item">
                                                <i class="fa fa-graduation-cap"></i>
                                                <span> @MemberProfil.educational_status</span>
                                            </div>
                                            <div class="message-meta-item">
                                                <i class="fa fa-heart"></i>
                                                <span> @MemberProfil.matiral_status</span>
                                            </div>
                                        </div>
                                    </div>

                                    <i class="fa fa-chevron-down expand-icon"></i>
                                    <span class="unread-badge fa fa-trash PdDelete"></span>
                                    <div class="MSlider">
                                        <div>Bu kişiyle tüm mesajlaşmayı silmek istidiğinizden emin misiniz?</div>
                                        <div class="">
                                            <i class="fa fa-close MClose"></i> &nbsp;&nbsp;| &nbsp;&nbsp;
                                            @Html.ActionLink(" ", "MessageMy", "MyProfil", new { MessageEventAction = "deleteMessageAll", who_id = ViewBag.who_id, whom_id = MemberProfil.id, obje_id = ViewBag.obje_id, sort = ViewBag.sort, noticeTableSort = ViewBag.noticeTableSort }, new { @class = "fa fa-trash" })
                                        </div>
                                    </div>
                                </div>
                                <div class="SliderM">
                                    <!-- Conversation Area -->
                                    @Html.Action("Message", "Profil", new { whom_id = MemberProfil.id })
                                </div>

                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <br /><br /><br />
                <div class="siteNot">Hiç Mesaj Yok</div>
            }
        }
        catch
        {
            if (!Response.IsRequestBeingRedirected)
            { Response.Redirect(Url.Action("Info", "Default")); }
        }
    </div>

    <div class="empty80">&nbsp;</div>
</div>
<script>
    $(Document).ready(function () {
        $(".expand-icon").click(function () {
            $(this).parent().parent().children(".SliderM").stop(true, true).slideToggle("slow");
            $(this).toggleClass("fa-chevron-down  fa-chevron-up");
        });
        ////////////////////////////Message All delete
        $(".PdDelete").click(function () {
            $(this).parent().children(".MSlider").stop(true).slideDown("slow");
        });
        $(".MClose").click(function () {
            $(this).parent().parent().parent().children(".MSlider").stop(true).slideUp("slow");
        });
    });
</script>
